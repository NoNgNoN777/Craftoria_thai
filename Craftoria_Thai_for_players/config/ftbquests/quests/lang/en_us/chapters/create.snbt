	quest.04C07CE4F7258BF5.quest_desc: [""]
	quest.04C07CE4F7258BF5.quest_subtitle: "ย้ายของไปรอบ ๆ"
	quest.0541F90AD95B4B5E.quest_desc: ["ระวังไว้ &bDepot&r อาจ&6ผลิต&rของอย่างหนึ่ง ส่วน &bBasin&r อาจได้อีกอย่างหนึ่ง"]
	quest.0541F90AD95B4B5E.quest_subtitle: "ขอเชิญชิมแซนด์วิชแตงกวาสักชิ้นไหม"
	quest.07821D28021BB440.quest_desc: ["&6ทุบ&r&bบล็อก&r พูดแค่นี้พอ"]
	quest.07821D28021BB440.quest_subtitle: "ขุดเลย ขุดเลย"
	quest.0807F0094282C2D5.quest_desc: ["&bAndesite Tunnels&r ค่อนข้างพื้นฐาน &6ครอบ&r &bBelts&r และเพิ่มการ&6แบ่ง&rไอเทมที่ลำเลียงบนสายพานแบบพื้นฐาน", "", "ดู &bBrass Tunnels&r เพื่อส่วนขยาย&6ความสามารถ&rของ Tunnel ที่มีประโยชน์"]
	quest.0888176AF1BEA68D.quest_subtitle: "ให้พวกเขากินเค้กไป"
	quest.088E87F861406342.quest_desc: ["ใช้&6เติม&rคูน้ำ &6ระบาย&rหนองน้ำ หรือ&6สูบ&r&9น้ำ&rและ&blava&rได้ไม่จำกัด"]
	quest.08DD0CB24FD0B193.quest_desc: ["- &6หมุน&rชิ้นส่วนได้อย่างแม่นยำ", "", "- &6เปิด&rและ&6ปิด&r &bFluid Valves&r", "", "- &6ย้อมสีได้&r"]
	quest.08DD0CB24FD0B193.quest_subtitle: "แต่ใส่ไว้ด้านหลังหัวได้ไหมล่ะ"
	quest.0A67575BAF8596B0.quest_desc: ["ดีกว่ารางรถไฟจำลองของคุณ: ทางตรง ทางโค้ง (สองแบบ) และทางลาด ใช้ข้ามพอร์ทัล Nether และชังก์ที่ไม่ได้โหลดได้ด้วย"]
	quest.0C18429AFD83973C.quest_desc: ["ชอบสิ่งนี้มาก ด้วยมันคุณจะ...", "", "- &6ขับ&r &bShafts&r ที่อยู่ชิดและขนานกัน* ให้หมุนทิศเดียวกัน หรือ", "", "- ให้ตัวไหนก็ได้ &6หมุน 90°&r เทียบกับตัวอื่น และ...", "", "- &6เพิ่มความเร็วเป็นสองเท่า&r หรือ&6ลดครึ่งหนึ่ง&r ด้วย &bChain Gearshift&r และ &bredstone&r นิดหน่อย", "", "(* หรือ &bEncased Fans&r เป็นต้น)"]
	quest.0C53E42899D3D271.quest_desc: ["&6ควบคุม&rด้วย &bredstone&r แบบง่ายสำหรับ &bShafts&r หรือ &bCogwheels&r ที่ขับเคลื่อน"]
	quest.0EFB32C64C146682.quest_desc: ["มือขวาของคุณ ในร่างกลไกทองเหลือง", "", "&6ทำ&rสิ่งที่ปกติมีแต่ผู้เล่นเท่านั้นที่ทำได้"]
	quest.10391A74418CA104.quest_desc: ["จำเป็นสำหรับกลไกที่ผมชอบที่สุดประเภทหนึ่ง คือ &bdrillificator&r*", "", "(* ชุด &bMechanical Drills&r ที่&6จัดเรียง&rบนระนาบแนวนอน เพื่อ&6เจาะ&rลงไปในโลก )"]
	quest.10391A74418CA104.quest_subtitle: "รอกนี้เพื่อเธอ เท็ดดี้"
	quest.120AAA5FECD27573.quest_subtitle: "ของเหลวไหล ไป ไป หยุดไหล หยุด"
	quest.19A71430646BD65B.quest_desc: ["&9การไหลของของเหลว&rจากการหมุนเชิงกล", "", "ต่อแบบขนานเพื่อ&6เพิ่ม&rการไหลของของเหลว หรือต่ออนุกรมเว้นระยะเพื่อ&6ดัน&rการไหลในท่อยาว ๆ"]
	quest.1A6929801D08F2C5.quest_desc: ["อาจมีวิธี&6ผลิตพลังงานเพิ่ม&rอย่างอื่นในม็อด แต่ก็ยากที่จะสู้ความสะใจของหม้อไอน้ำที่ขับ &bSteam Engines&r หลายตัว... เท่าที่คุณตั้งได้ โดย&6ป้อน&r&cความร้อน&rและ&9น้ำ&rให้พอ"]
	quest.1A6929801D08F2C5.quest_subtitle: " ชู่ว ชู่ว ชู่ว"
	quest.1C699E7F615D68A7.quest_desc: ["เทอร์มินัลในชุดสร้างระบบเก็บของเองใหม่ของ Create", "", "&6เชื่อม&rกับช่องเก็บของหลายแห่งได้ผ่าน &bStock Links&r และ&bใช้งาน&rโดยม็อบที่คุณเลือก"]
	quest.1CACDF56CB395997.quest_desc: ["&bExtendo Grip&r ของฉัน เอาไปได้... เมื่อคุณ&6งัด&rมันออกจากนิ้วที่เย็นเฉียบไร้ชีวิตของฉันได้ xD"]
	quest.1CACDF56CB395997.quest_subtitle: "เอื้อมให้ถึงฟ้า"
	quest.1F71E19AD3CFCABC.quest_desc: ["1812 Overture&r ของไชคอฟสกี... ดนตรีสำหรับวางสิ่งก่อสร้างด้วย", "", "&6ยิงปืนใหญ่&rแปลนสิ่งก่อสร้างของคุณลงในโลกทีละบล็อก"]
	quest.1FA90B3E33E0DFEE.quest_desc: ["&6เคลียร์&rเส้นทางและ&6สร้าง&r เจ๋งมาก", "", "คุณควรดู ponder ของสิ่งเหล่านี้"]
	quest.1FDE63D5EA5DA3CB.quest_desc: ["ถ้า Internet Protocol มีพอร์ต &bPackage Frogports&r ก็ต้องเป็นส่วนหนึ่งของ CCP: Chain Conveyor Protocol"]
	quest.1FDE63D5EA5DA3CB.quest_subtitle: "ไม่ใช่ที่ที่กบขึ้นลง"
	quest.21B6DE76E735A196.quest_desc: ["&bLiner Chasis&r และ &bRotational Chassis&r &6ช่วย&r สร้างกลไกโดยไม่ต้องใช้ superglue"]
	quest.220163965130D8C7.quest_desc: ["&6ทุบ&r &bบล็อกที่ไม่มีกล่องการชนแบบทึบ&r... เช่น &bราง&r &bคันโยก&r &bปุ่ม&r ฯลฯ"]
	quest.22488BFDDB85DB29.quest_desc: ["บางคนว่า นี่คือ &bท่อของเหลว&r ที่ดูดีที่สุดในเกม มีหน้าต่างให้ &6เห็น&r &9ของเหลว&r ที่ไหลอยู่ภายในด้วย"]
	quest.231404F75545A149.quest_desc: [""]
	quest.231404F75545A149.quest_subtitle: "ยกระดับตัวคุณ เพื่อน ๆ และงานสร้าง"
	quest.238794C3DE2B79BA.quest_desc: ["&bEncased Fans&r ทำอะไรเจ๋ง ๆ กับม็อบและเอนทิตีได้ และอุปกรณ์นี้ช่วยให้ &6พ่น&r เอฟเฟกต์เหล่านั้นไปรอบ ๆ", "", "เคล็ดลับ: เอฟเฟกต์ของ &bNozzles&r ที่วางเรียงกันเป็นกลุ่ม &6ซ้อนกัน&r ลองดู"]
	quest.23988FD7E2EEF319.quest_desc: ["โดยพื้นฐานแล้วคือองค์ประกอบหลักของ molecular assembler ใน Create", "", "เคล็ดลับ: วาง &bRedstone signal&r ไว้ข้างแถวของสิ่งเหล่านี้เพื่อ &6ปิด&r ช่องที่ไม่ได้ใช้ทั้งหมดเมื่อ &6คราฟต์&r สูตรที่เล็กกว่า"]
	quest.248CD41AE2A92573.quest_desc: ["ตรงตามชื่อ: วิธี &6เชื่อม&r ช่องเก็บของเข้ากับชิ้นส่วน Create เฉพาะอื่น ๆ"]
	quest.264DA461C59E31C3.quest_desc: ["&6จุดไฟ&r ให้ &bBlaze Burners&r ของคุณร้อนแรงถึงขีดสุดใหม่"]
	quest.264DA461C59E31C3.quest_subtitle: "Blazes! อันนี้ไม่โกหกนะ"
	quest.2697B8077174B870.quest_desc: ["[ อย่าลืมดูรุ่น netherite ของสิ่งเหล่านี้ และ &bBacktank&r ด้วย ]"]
	quest.2697B8077174B870.quest_subtitle: "Jacques Cousteau ยังสู้คุณไม่ได้"
	quest.26AC949F1C3C6214.quest_desc: ["สีทองเหลือง ด้านข้างสีดำ และดูมีสไตล์มาก"]
	quest.286229410FA571B7.quest_desc: ["&6ป้องกัน&r การชน และ &6ควบคุม&r การไหลของรถไฟที่ตั้งตารางเวลาไว้"]
	quest.286229410FA571B7.quest_subtitle: "ให้รถไฟวิ่งต่อไป!"
	quest.2976D5A533FDEE8F.quest_subtitle: "ส่งและดึงได้ไกลขึ้น"
	quest.29A942B4C3E9A502.quest_desc: ["&6ตัด&r &bต้นไม้&r สูงแค่ไหนก็ล้ม หรือ &6ตัด&r &bของ&r ชิ้นเดียวให้กลายเป็น... &bของ&r อีกหลายชิ้น", "", "&bMechanical Saw&r มีสูตรมากมายที่รับวัตถุดิบได้หลายแบบ คุณจึงควร &6ล็อก&r สูตรไว้ โดย &6ตี&r ด้านบนของเครื่องด้วยตัวอย่างผลลัพธ์ที่ต้องการ"]
	quest.29A942B4C3E9A502.quest_subtitle: "ไม่ใช่ Stock, Aitken และ Waterman"
	quest.2A08F71925AE775E.quest_desc: ["ก็... ทุกอย่างอยู่ในชื่อของมันแล้ว"]
	quest.2B482168EC0C6EB8.quest_subtitle: "สายลอบเร้น สไตล์สนุก"
	quest.305EDA1DA23E9BDF.quest_desc: ["ผู้พิทักษ์ความเป็นระเบียบในโลกที่คาดเดาไม่ได้ของ &bChains,&r &bBelts,&r และ &bBoxes&r"]
	quest.305EDA1DA23E9BDF.quest_subtitle: "แพ็กพวกมันอีกรอบนะ Sam"
	quest.30FC83AF65C13591.quest_desc: ["เหมือน &bAndesite Tunnel&r แต่มีโหมด &6กรอง&r และ &6กระจาย&r"]
	quest.3254374A45D0D708.quest_desc: ["ใช้ &b Schematic and Quil&r เพื่อ &6บันทึก&r งานสร้างหรือส่วนหนึ่งของโลกของคุณ", "", "ใช้ &bEmpty Schematic&r ใน &bSchematic Table&r เพื่อ &6นำแผนของคุณ&r ไปใช้จริง"]
	quest.3254374A45D0D708.quest_subtitle: "กระดาษเปล่า... คุณจะเขียนอะไรลงไป?"
	quest.328E672F6B43D93A.quest_desc: ["ใช้ทั้ง &6ประกอบ&r รถไฟของคุณ และ... &6เป็น&r สถานีรถไฟ"]
	quest.32DC17E21BF26228.quest_desc: ["ใช้ &6ดาวน์โหลด&r &bSchematics&r ที่บันทึกไว้ลงใน &bSchematic&r ใหม่ที่พร้อมใช้ใน &bSchematicannon.&r"]
	quest.33C2042F320B2D34.quest_desc: ["Chute ยืดหยุ่นกว่าที่คุณคิดตอนแรก", "", "ซ้อนในแนวตั้งได้ และแนวทแยงได้ด้วย", "", "Wrench ใช้วางหรือถอดหน้าต่างบน Chute ได้", "", "ย้ายไอเทมขึ้นด้านบนโดยใช้ Encased Fans ที่ปลายทั้งสองข้างดันอากาศขึ้น", "", "ย้ายไอเทมลงด้านล่างโดยไม่ต้องใช้อะไรเลย (ขอบคุณแรงโน้มถ่วง!)"]
	quest.33C2042F320B2D34.quest_subtitle: "เอาละ Chute"
	quest.3594EFD40D059EA3.quest_desc: ["อีกหนึ่งของโปรดของฉัน", "", "ขับเคลื่อนด้วย &bThreshhold Switch&r บน &bVault&r เพื่อให้ได้แถบความคืบหน้าสุดเท่ที่ &6แสดง&r ว่าเต็มแค่ไหน"]
	quest.3594EFD40D059EA3.quest_subtitle: "สุดยอดไปเลย"
	quest.36F22AA68C1841F6.quest_desc: [""]
	quest.36F22AA68C1841F6.quest_subtitle: "คุณจะเท่ มีเกราะ และกันลาวาได้!"
	quest.3723D86B327384DB.quest_desc: ["สองคำ: รถไฟลาวา&r", "", "(แต่จริง ๆ แล้ว ด้วยสิ่งนี้คุณ &6ถ่ายโอน&r &9ของเหลว&r เข้าหรือออกจากกลไกเคลื่อนที่และรถไฟได้)"]
	quest.37C0F6CAEE15D410.quest_desc: ["เหมือนที่ &bSmart Observers&r &6สังเกต&r ได้ทั้งสิ่งที่อยู่ด้านหน้าหรือสิ่งที่อยู่ในสิ่งนั้น &bTrain Observers&r ก็ &6สังเกต&r รถไฟที่ผ่านไปหรือแม้แต่สินค้าบนรถได้"]
	quest.381C007F6EB3B389.quest_desc: ["อาจเป็นบล็อกเดี่ยวของ Create ที่ &6ถูกใจ&r คนมากที่สุด แบบเงียบ ๆ", "", "ก็นะ ครั้งแรกที่คุณ &6ขับ&r รถไฟใน Create รู้สึกสุดยอดใช่ไหมล่ะ? ใช่เลย"]
	quest.38DF71D9CB5045F2.quest_desc: ["เป็นทองเหลือง มัน &6หมุน&r และ &6ดูเท่&r แค่นี้พอ"]
	quest.38EF4E7FE82B62A6.quest_subtitle: "ห้ามมาสาย ห้ามมาสาย สำหรับนัดสำคัญยิ่ง"
	quest.39716053AAD8ABF2.quest_desc: ["ทุกอย่างต้องมีจุดเริ่มต้น และสิ่งนี้ช่วยให้คุณ &6ใช้แรงมือ&r ขับเคลื่อนสิ่งประดิษฐ์เชิงกลชิ้นแรกของคุณ หรือกระตุ้นเครื่องยนต์หม้อไอน้ำที่สูบตัวเองให้เริ่มทำงาน"]
	quest.3B6674B3B91BD8B4.quest_desc: ["&bMechanical Belts&r ทำถูก จำเป็นสำหรับกลไกช่วงต้น (และยังมีประโยชน์กับกลไกความเร็วสูง) และย้อมสีได้ด้วย", "", "ส่วนที่เรียกหลวม ๆ ว่า &c\"Transportation\"&r มีชิ้นส่วนมากมายสำหรับเคลื่อนย้ายและเก็บไอเทมในกลไกของคุณ รองรับการเคลื่อนที่ได้หลายแบบ และแม้แต่วิธีผลิตพลังงานหมุนเวียนจากบรรยากาศเอง!"]
	quest.3B6674B3B91BD8B4.quest_subtitle: "คาดเข็มขัดไว้ เราจะออกเดินทางกัน!"
	quest.3E1B0CBA0889C0AE.quest_desc: ["&bGantrys&r: &6การเคลื่อนที่&r และ &6การส่งกำลัง&r: เจ๋งไปเลย!", "", "ลองดู gantry แบบต่อเนื่อง ซึ่งอธิบายไว้ใน ponder"]
	quest.3E1B0CBA0889C0AE.quest_subtitle: "สำหรับ Gantry ของผู้มั่งคั่งมีที่ดิน"
	quest.3EFED58FAE46B366.quest_desc: ["&6ติดกาว&r บล็อกเข้าด้วยกันเป็น contraption ขนาดเท่าไรก็ได้ ไม่ว่าเล็กหรือใหญ่"]
	quest.3F0B58522B009779.quest_desc: ["ถือคู่ได้ (&6dual-wielded&r) และ &6เอนชานต์&r ได้", "", "&bอาหาร&r (กระสุน) แต่ละชนิดให้ &6เอฟเฟกต์&r ต่างกัน"]
	quest.3F0B58522B009779.quest_subtitle: "นักสู้สายอาหาร"
	quest.3F3600B6701641E0.quest_desc: ["&bAndesite Alloy&r คือกุญแจสู่การเริ่มต้นกับ Create และบล็อกในส่วน &c\"Mechanical Basics\"&r ของแกลเลอรีนี้ก็เช่นกัน", "", "  ตอน &6ขุด&r ช่วงต้นเกม เก็บ &bAndesite&r ให้มากที่สุด และอย่าลืมเก็บ &bZinc&r ด้วย เพื่อเก็บ &bIron&r ไว้ใช้อย่างอื่นแทนการ &6ทำ&r &bAndesite Alloy&r"]
	quest.3F6730383CCC8BB0.quest_desc: ["อย่าถูกหลอก... หน้าตาอาจคล้าย &bcauldron&r ธรรมดา แต่ยืดหยุ่นพอจะทำงานร่วมกับ &bBelts&r, &bFluid Pipes&r, &bMechanical Mixers&r และ &bPresses&r — &6ช่วยให้&r สูตรจำนวนมากทำงานอัตโนมัติได้"]
	quest.404A9FFCA3DF600D.quest_desc: ["&6ควบคุม&r ด้วย &bredstone&r แบบง่าย ๆ เพื่อ &6กลับทิศ&r การหมุน", "", "สะดวกมากเมื่อสิ่งก่อสร้างของคุณต้องการ"]
	quest.41183734EB2C28FF.quest_desc: ["&6เติม&r ของเหลวลงในภาชนะของเหลวของ vanilla และ &6ใส่&r &9ของเหลว&r ให้ &bไอเทม&r ในสูตรแบบลำดับขั้น"]
	quest.41183734EB2C28FF.quest_subtitle: "แมงมุมตัวจิ๋วไปไหนนะ"
	quest.434D7EDCDD954B40.quest_desc: ["นอกจากเป็นวัตถุดิบคราฟต์แล้ว &bAndesite Casing&r ยังใช้ &6หุ้ม&r &bShafts&r และ &bBelts&r รวมถึง &bLarge&r และ &bSmall Cogwheels&r ได้ด้วย อย่างหลังช่วยให้ชุดเฟือง ที่ใช้เพิ่มรอบหมุนจากแหล่งพลังงานช่วงแรก กะทัดรัดที่สุดเท่าที่จะทำได้"]
	quest.434D7EDCDD954B40.quest_subtitle: "เรียบง่ายแต่ใช้งานได้"
	quest.4554EE3CC1F80F7D.quest_desc: ["ให้ม็อบที่คุณชอบที่สุด &6ขับ&r รถไฟของคุณ!"]
	quest.45664AAC3ACCEF36.quest_desc: ["&bObserver&r ที่ &6เก่งกว่า&r มาก"]
	quest.4788E4092A488C9E.quest_desc: ["ต้องมีสำหรับโรงงานที่เร็ว"]
	quest.488424BE711AE0F1.quest_desc: ["ค่อนข้างยืดหยุ่นเรื่อง &6การวาง&r - วางด้านข้าง ด้านบน หรือด้านล่างก็ได้", "", "คุณคงอยากดูรุ่นอัปเกรดแน่นอน คือ &bBrass Funnel&r", "", "[ เคล็ดลับ: เมื่อ &6วาง&r บน &bBelt&r ให้ &6ตี&r ด้วย &bWrench&r เพื่อ &6ขยาย&r ให้เป็นรูปแบบเต็มความกว้างของบล็อก ]"]
	quest.488424BE711AE0F1.quest_subtitle: "พอร์ต I/O ของ Create"
	quest.497660DB9611C67C.quest_desc: ["เหมือน &bChute&r ธรรมดา แต่มี &6การกรอง&r และ &6การควบคุมอัตรา&r"]
	quest.49D4F55F8A20DB22.quest_desc: ["มีหลายสีให้เข้ากับการตกแต่งทุกแบบ"]
	quest.49D4F55F8A20DB22.quest_subtitle: "ผ่อนคลาย นั่งพักก่อน"
	quest.4AAFD7E0D868844A.quest_desc: ["&6ดีด...&r อันนี้ อันนั้น วัว creeper แกะ หรือแม้แต่ผู้เล่นออกไป"]
	quest.4AAFD7E0D868844A.quest_subtitle: "ฮูเร่!"
	quest.4DCA027828C2921C.quest_desc: ["พลังงานสำรองแบบพกพาสำหรับของ Create บางอย่าง"]
	quest.4E3578FC24ACF39B.quest_desc: ["คุณคงเคยเจอเจ้าตัวเล็กไม่โดดเด่นนี้ตอนกดแผ่นเหล็กชุดแรกใน Create", "", "&bDepot&r &6ยึด&r ไอเทมให้อยู่กับที่ เพื่อให้ของอื่นของ Create หลายอย่างทำงานกับไอเทมเหล่านั้นได้"]
	quest.4E3578FC24ACF39B.quest_subtitle: "ไอเทม... อยู่นิ่ง ๆ!"
	quest.4F987C54768D8E3D.quest_desc: ["จำไว้:", "", "- &bLarge Cogwheel&r &6ขับ&r ตัวเล็ก = rpm สูงขึ้น", "", "- &bSmall&r &6ขับ&r ตัวใหญ่ = rpm ต่ำลง", "", "- &bLarge&r และ &bSmall&r &6ใช้&r เพลาเดียวกัน = rpm ไม่เปลี่ยน"]
	quest.4F987C54768D8E3D.quest_subtitle: "กลอุบายแห่งการคิด"
	quest.51649293068FE93D.quest_desc: ["&bRotational Chasis&r และ &bLinear Chassis&r &6ช่วย&r สร้าง contraption โดยไม่ต้องใช้ superglue"]
	quest.51F5C6D60D719DC4.quest_desc: ["&bBrass&r - alloy ง่าย ๆ ของ &bCopper&r และ &bZinc&r แต่คุณต้อง &6ไป&r Nether เพื่อ &6เตรียมตัว&r ให้ทำมันได้", "", "&6นำ&r &bBlaze Burners&r เปล่าหลายอันไปด้วย... คุณรัวใส่ &bBlaze Spawner&r เพื่อ &6จับ&r blaze ได้เท่าจำนวน &bBlaze Burners&r ที่มี", "", "เมื่อมี &bBrass&r แล้ว คุณจะ &6คราฟต์&r ไอเทมในส่วน &c\"Brass\"&r ได้: &bDeployer&r สำหรับ &cทำสิ่งที่ปกติเป็นการกระทำของผู้เล่น&r, บล็อก Create พื้นฐานรุ่นฉลาดขึ้น และตัวเลือกสวย ๆ สำหรับตกแต่ง เรายังวาง &bBlaze Burner&r ไว้ตรงนั้นด้วย แม้ว่าคุณคงทำไว้แล้วก็ตาม"]
	quest.52575C93CD6DD5D5.quest_desc: ["สำหรับ &6แพ็ก&r และ &6แกะ&r แพ็กเกจ"]
	quest.53ECE17FBD95392C.quest_desc: ["อ้อ &bWindmill Bearing&r", "", "- เหมาะกับ contraption ขนาดเล็กที่ใช้พลังงานในตัว (มักใช้ทำฟาร์ม)", "", "- ขั้นกลางระหว่าง &bWater Wheels&r และ &bSteam Engines&r ในการแสวงหา MOAR POWAH ของนักสร้าง Create"]
	quest.53ECE17FBD95392C.quest_subtitle: "ชนมันเลย ดอนกิโฆเต้"
	quest.55359056540E1A96.quest_desc: ["ไดรเวอร์ฝั่งความต้องการ ที่เป็นหัวใจของโรงงาน Create อัจฉริยะยุคใหม่"]
	quest.55696F71CC09E588.quest_desc: ["บทนี้นำเสนอเป็นแกลเลอรีของ Create - ม็อดที่มีความสามารถหลากหลาย:", "", "- &6ทำให้เป็นกลไก&r ชิ้นส่วน ทรัพยากร การเกษตร การผลิตพลังงาน และอื่น ๆ", "- &6เพิ่ม&r การเคลื่อนที่เชิงกลให้สิ่งก่อสร้างของคุณ", "- &6สร้าง&r และ &6จัดตาราง&r รถไฟ รวมถึงเครือข่ายส่งไปรษณีย์", "- &6ขนย้าย&r และ &6เก็บ&r ไอเทมและของเหลว", "- &6สร้าง&r โรงงานอัจฉริยะ", "- &6คัดลอกและวาง&r สิ่งก่อสร้าง หรือ &6นำเข้า&r", "- &6เติม&r, &6ระบาย&r หรือ &6สำรวจ&r แหล่งน้ำหรือลาวา", "", "บทนี้ไม่ใช่ชุดเส้นทางผ่านม็อด", "Create เองให้ข้อมูลที่ยอดเยี่ยมเกี่ยวกับส่วนประกอบของมัน ผ่านข้อมูลขยายเมื่อวางเมาส์และระบบ &6Ponder&r ที่ล้ำสมัย"]
	quest.55AEBE2068711237.quest_desc: ["อ้อ &bWater Wheel&r เรียบง่าย", "", "เป็นก้าวแรกที่ง่ายที่สุดในการ &6ผลิต&r พลังงานฟรีให้ Create และยังเป็นตัวแทนของการเคลื่อนที่แบบหมุน ซึ่งเป็นคุณลักษณะสำคัญของ Create"]
	quest.55AEBE2068711237.quest_subtitle: "น้ำไหล ล้อหมุน ทุกอย่างจึงเริ่มต้น"
	quest.55DBF04C81688194.quest_subtitle: "สิ่งตรงข้ามของ Spout"
	quest.5773319EE8B3D45C.quest_desc: ["เพิ่ม &6การควบคุมความเร็ว&r ให้ &bChain Drives&r"]
	quest.578394EC869C10AB.quest_desc: ["ขนส่งไอเทมแบบจุดต่อจุดอย่างง่าย ส่งผ่านพลังงาน หรือเป็นลิฟต์สกีเรียบ ๆ สำหรับผู้เล่น - คุณเลือกเอง!"]
	quest.590D73FDE6335297.quest_desc: ["&6วัด&r ว่า contraption ของคุณ &6ผลิต&r และ &6ใช้&r &dพลังงาน&r ในรูปหน่วย Stress เท่าไร หรือทำงานเร็วเพียงใด"]
	quest.594BC97607EEE341.quest_desc: ["ชิ้นส่วนสำคัญของงานสร้าง Create ส่วนใหญ่ &6สลับ&r แกนของการเคลื่อนที่แบบหมุนจากระนาบหนึ่งไปอีกระนาบหนึ่ง"]
	quest.5D5FC5420738FDE8.quest_desc: ["&bCardboard&r ธรรมดา ๆ แสนพื้นฐาน แต่... เป็นประตูสู่ความสามารถชุดล่าสุดของ Create&r ซึ่งอยู่ในปีก &c\"Factory Smarts\"&r ของแกลเลอรีนี้"]
	quest.5D852AA1930E1019.quest_desc: ["Blaze ที่ถูกจับ &6ชอบ&r &bไข่&r เหมือนบรรพบุรุษของพวกมันอย่าง Calcifer"]
	quest.607FFC2B7A0F972A.quest_desc: [""]
	quest.607FFC2B7A0F972A.quest_subtitle: "ดันและดึง"
	quest.619BC1F1094F4EFA.quest_desc: ["ข้อมูลตอนโฮเวอร์และกด SHIFT บอกไว้หมดแล้ว: ", "", "\"รางไฟฟ้าทิศทางเดียว ความเร็วปรับได้ตามความแรงของสัญญาณที่ป้อนเข้า\""]
	quest.61A7F8B1C6ECEEA5.quest_desc: ["&bEncased Fan&r ที่ดูธรรมดา... อาวุธลับ (ที่ไม่ลับเท่าไร) ของ Create", "", "ลองดู&6 bulk-blasting&r (โอ้โห!) และการ &6ผลัก&r ของไปมา"]
	quest.6227304103E32C74.quest_desc: ["&bFluid Tank&r สุดสะดวกใช้ได้เดี่ยว ๆ หรือ &6ต่อ&r กันเป็นคอลัมน์กว้าง 1 ช่อง, 2x2 หรือ 3x3 สูงได้ถึง 30 บล็อก!", "", "&6วาง&r ไว้เหนือแหล่งความร้อน &6สูบ&r &9น้ำ&r เข้าไปให้พอ แล้วมันจะกลายเป็น boiler ที่ป้อนพลังงานให้ &bSteam Engines&r — boiler ที่ใหญ่กว่า เมื่อ &6ได้&r น้ำและความร้อนมากขึ้น ก็ &6ขับเคลื่อน&r &bSteam Engines&r ได้มากขึ้น"]
	quest.6227304103E32C74.quest_subtitle: "แข็งแรงจริง ทั้งที่กลวง"
	quest.63756443B3FFDB48.quest_desc: ["อ้า &bMillstone&r ที่เรียบง่ายแต่เชื่อถือได้", "", "&bCrushing Wheels&r อาจเร็วกว่า แต่ millstone &6ลงตัว&r กับงานสร้างหลายแบบมากกว่า... และ &dคุณ&r ก็ไม่ได้ &6ลง&r ไปอยู่ใน &bมัน&r ด้วย ก็นับเป็นข้อดี"]
	quest.63756443B3FFDB48.quest_subtitle: "ปฏิบัติการมิลล์-ลิทารี"
	quest.66855DBE37DB5CD1.quest_desc: ["&6ส่งต่อ&r การเคลื่อนที่แบบหมุนไปตามเส้นตรง: เสร็จเรียบร้อย"]
	quest.66855DBE37DB5CD1.quest_subtitle: "เธอทำให้ฉันหมุนวนไม่หยุด"
	quest.66A4DD110F0E66D1.quest_desc: ["ถึงเวลา &6หยั่งลึก&r สู่ระบบท่อของ Create..."]
	quest.66A4DD110F0E66D1.quest_subtitle: "ยินดีที่ได้รู้จัก (Nice to Cu)"
	quest.6711E72048BBDB08.quest_desc: ["&6เก็บ&r ของได้หลายอย่างถึงแปดชนิด ย้อมสีได้ และ &bToolboxes&r ทั้งหมดที่อยู่ใกล้ &6เปิดใช้&r ได้ด้วยปุ่มลัดเดียว สะดวกสำหรับการจับตาดูงานของคุณ ไม่ต้องก้มมองเครื่องมือ"]
	quest.6AB303BEA478C0F3.quest_desc: ["การควบคุมการหมุนที่ &6ตั้งโปรแกรมได้&r!"]
	quest.6B022CC9A87E6329.quest_desc: ["วิธีที่สะดวกมือ (เฮ้!) ในการย้ายของจาก A ไป B", "", "ด้วย &bBrass Funnels&r คุณยัง &6กรอง&r เป้าหมายของ &bMechanical Arm&r ได้ด้วย"]
	quest.6BE74683BED141EF.quest_desc: ["ไม่ใช่แค่ชิ้นส่วนคราฟต์และของตกแต่งเท่านั้น… ยังติดบน &bFluid Pipes&r ได้ ทั้งเพื่อ &6ยึด&r ท่อไว้ในทิศทางเดิม และป้องกันไม่ให้ &6เชื่อมต่อ&r กับท่อที่วางติดกันภายหลัง"]
	quest.6CF338A73F212B79.quest_desc: ["โดยพื้นฐานคือพอร์ต I/O เหมือน &bAndesite Funnel&r แต่มี &6ตัวกรอง&r!"]
	quest.6DDD8661181840F1.quest_desc: ["ตู้คอนเทนเนอร์สำหรับการขนส่งระหว่างประเทศ", "", "แพ็กเก็ตข้อมูลสำหรับเครือข่ายสื่อสาร", "", "และตอนนี้… &bCardboard Package&r ที่เรียบง่ายทำให้การ &6ถ่ายโอน&r ไอเทมเป็นแพ็กเก็ต เป็นรากฐานของความสามารถ &6ร้องขอ&r และ &6จัดส่ง&r ไอเทมแบบใหม่ของ Create"]
	quest.6E3F0C072B55467B.quest_desc: ["เรียบง่าย: &6เก็บเกี่ยว&r และ &6รีเซ็ต&r &bพืชผลที่โตเต็มที่&r"]
	quest.6FD3C9B4EF558332.quest_desc: ["ขอบเป็นทองเหลือง แต่โดยรวมหรูหราไม่โอ้อวด"]
	quest.72CBC6171104037F.quest_desc: ["จริง ๆ นะ ประตูที่เจ๋งที่สุดในม็อด MC อันหนึ่ง ในความเห็นของฉัน", "", "ไม่แพ้ของ Ad Astra&r"]
	quest.73A48DA93F67805B.quest_desc: ["&6ช่วยให้&r &9ของเหลว&r หลายชนิดไหลในเครือข่าย &bท่อ&r ของคุณได้"]
	quest.754EC4FE62F454E8.quest_desc: ["รู้ไหมว่า &6การวาง&r หีบข้างกันหีบอีกใบจะรวมเป็นหีบคู่ได้?", "", "&bVaults&r ก็เป็นแบบนั้น แต่ &6รวม&r กันได้ถึง 81 vault", "", "ข้อแม้ล่ะ? คุณมองเข้าไปข้างในโดยตรงไม่ได้", "", "&6นำ&r ของเข้าและออกด้วย &bChutes&r, &bHatches&r, &bFunnels&r และ &bPackagers&r", "", "[ เคล็ดลับ: ดู &bInventory Ticker&r ซึ่งเป็นวิธีที่ยอดเยี่ยมของ Create ในการทำ storage terminal ]"]
	quest.754EC4FE62F454E8.quest_subtitle: "ทั้งหมดนี้คือ Vault ของคุณ!"
	quest.77968A26B3D90399.quest_desc: [""]
	quest.77968A26B3D90399.quest_subtitle: "ประแจที่ดีที่สุดในเกม ฉันว่าอย่างนั้น"
	quest.78D8E2EB66607AAA.quest_desc: ["เอา &bnether quartz&r นิดหน่อยมารวมกับ &bredstone&r แล้ว &6ขัด&r ให้เนียน แล้วปัง!... คุณกำลังจะทำ &bElectron Tubes&r อันแรก และเข้าใกล้ของเล่นสนุก ๆ ในปีก &c\"Specials\"&r มากขึ้น"]
	quest.78D8E2EB66607AAA.quest_subtitle: "เรียบลื่นและเงางาม!"
	quest.79288A7251986136.quest_desc: ["", "[ เคล็ดลับ: แม้สำหรับกลไกที่ไม่ได้ออกแบบให้วิ่งบนราง &bCart Assemblers&r ก็ยังสะดวกสำหรับวางกลไกลงในโลก หรือแปลงกลับเป็นรูปกลไก แล้วเก็บกลับมาเป็นไอเทมด้วย &bWrench&r สวัสดี hammer-space! ]"]
	quest.79288A7251986136.quest_subtitle: "กลไกบน Minecraft Carts? ได้เลย!"
	quest.7938CF0A65011F0B.quest_desc: ["Vacuum tube, thermionic valve, &bElectron Tube&r—เรียกชื่อไหนก็เป็นไอเทมสุดเท่ และเป็นส่วนผสมสำคัญของชิ้นส่วน Create ที่ต้องมี “สมอง”"]
	quest.7F4BD83F2D567FF0.quest_desc: ["รถไฟมาแล้ว!", "", "รถไฟมาแล้ว!", "", "ชอบรถไฟไหม?", "", "โอ้โฮ มาถูกม็อดแล้ว", "", "คุณต้องทำ sheet ที่แข็งแรงเพื่อเข้าสู่แกลเลอรี &c\"Trains\"&r", "", "รถไฟของ Create&r สนุกสุดเหวี่ยงเลยล่ะ ในความเห็นของฉัน", "", "ขอให้สนุก!"]
	quest.7F4BD83F2D567FF0.quest_subtitle: "ชู่ว ชู่ว คุณฟาร์นสเวิร์ธ! (Choo Choo, Mister Farnsworth!)"
