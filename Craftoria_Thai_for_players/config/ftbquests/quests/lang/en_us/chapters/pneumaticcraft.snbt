{
	quest.023A420F24C515EB.quest_desc: ["&bBasic Pressure Tube&r รุ่น&8เสริมความแข็งแรง&r สามารถ&2พราง&rได้ และติด &bTube Modules&r เพื่อเพิ่ม&eความสามารถเสริม&rได้"]
	quest.04E6DF90BA2FCACB.quest_desc: ["อุปกรณ์นี้ &6แปลง&r &7อากาศอัด&r ให้เป็น &bForge Energy&r (&9ใช้ได้กับ RF และพลังงานของม็อดอื่นอีกมาก&r)", "", "มี &3ประสิทธิภาพพื้นฐาน&r &a40%&r หมายความว่า &7อากาศ 100 mL&r สร้างได้ &b40 FE&r", "", "&bSpeed Upgrades&r จะ&cลด&r&aประสิทธิภาพ&r ลงเล็กน้อย", "", "&bDynamo&r ยัง&6สร้าง&r&4ความร้อน&r ซึ่งต้องจัดการไม่ให้ &aประสิทธิภาพ&r &cลดลง&r"]
	quest.05E2E87CF3F9A5FB.quest_desc: ["ทำจาก &4Redstone&r และ &cDiesel&r ใช้สำหรับ &bSpeed Upgrade&r"]
	quest.05E2E87CF3F9A5FB.title: "&6Lubricant"
	quest.07F1FA5EF3E6A7F3.quest_desc: ["&3สารนี้&rนำไป&6แปรรูป&rใน &bThermopneumatic Processing Plant&r เพื่อ&6ผลิต&r &bKerosene&r หรือใส่ &4Redstone&r เพื่อได้ &4Lubricant&r ", "", "เป็น&7เชื้อเพลิงเหลว&r&aที่ใช้ได้ดี&rและ&6วาง&rใน &8Furnace&r ได้ด้วย"]
	quest.07F1FA5EF3E6A7F3.title: "&cDiesel"
	quest.0B4D059EDFD90B5B.quest_desc: ["เติม &2Etching Acid&r ลงใน &bEtching Tank&r แล้วใส่ &7Empty PCBs&r ที่ผ่านการฉายแสงใน &eUV Light Box&r แล้ว", "", "หากต้องการ คุณ&cให้ความร้อน&rแก่ถังให้สูงกว่า &c50&r องศาเซลเซียสเพื่อ&eเร่ง&rกระบวนการกัดกรด แต่ &2Etching Acid&r จะถูกใช้เร็วขึ้น", "", "ดึง &bUnassembled PCBs&r ออกทางด้านข้าง และ &cFailed PCBs&r ออกทางด้านบนหรือด้านล่างของถัง"]
	quest.0D44F37BE787CA30.quest_desc: ["&3สารนี้&rนำไป&6แปรรูป&rใน &bThermopneumatic Processing Plant&r เพื่อผลิต &eLPG&r ซึ่งเป็น&7เชื้อเพลิงเหลว&r&aชั้นเยี่ยม&r คุณภาพเทียบเท่า &7Refined Fuel&r ของ &3Thermal Expansion&r "]
	quest.0D44F37BE787CA30.title: "&6Gasoline"
	quest.0DDE4F5B0FE265B0.quest_desc: ["&bPressure Tubes&r ส่ง&7อากาศ&rระหว่าง &bCompressors&r และ &bMachines&r &2ปลอมตัว&rให้กลมกลืนกับ&aสภาพแวดล้อม&rได้ ", "", "นอกจากนี้ยัง&6ติด&r &bTube Modules&r เข้ากับ &bTubes&r เหล่านี้เพื่อเพิ่ม&aฟีเจอร์พิเศษ&rหรือ&eฟังก์ชัน&rได้"]
	quest.0E89FB32767F03C0.quest_desc: ["นี่คือ &bMinigun Ammo&r มาตรฐานที่ไม่มีคุณสมบัติพิเศษ ", "", "แต่&6คราฟต์&rร่วมกับ &bPotion&r เพื่อใส่&cเอฟเฟกต์ของโพชัน&rลงใน &bAmmo&r ได้"]
	quest.0F7AEC02C0AC86A2.quest_desc: ["เมื่อ&7ความดัน&rของพวกมัน&eต่ำกว่า&rจุดหนึ่ง พวกมันจะสแกนหา &bCharging Station&r ที่ติด &bDispenser Upgrade&r ภายในพื้นที่ที่กำหนด หากพบ พวกมันจะ&6ชาร์จ&rเองโดยอัตโนมัติก่อนกลับไปทำงานของตน ", "", "&bDrones&r ทุกตัว&6อัปเกรด&rได้ด้วยอัปเกรดความเร็ว ปริมาตร เกราะ สแตนด์บาย ความปลอดภัย และอายุไอเทม และยัง&6ติด&r&bอัปเกรด&rเพิ่มเติมได้ตามประเภทของ Drone ดังนี้", "", "&aทุกประเภท:&r            ", "- Speed x 10, Volume x 25, Armor x 15, Standby x 1, Security x 3, Item life x 10", "", "&eCollector:&r    ", "- Magnet x 6, Range x 16, Inventory x 35", "", "&2Harvester:&r   ", "- <n/a>", "", "&cGuard:&r      ", "- Minigun x 1, Range x 16, Muffler x 4", "", "&9Logistics:&r    ", "- Inventory x 35"]
	quest.1246838BA3EEE910.quest_desc: ["&3สารนี้&rนำไป&6แปรรูป&rใน &bRefinery&r เพื่อสร้าง&7เชื้อเพลิง&rหลายชนิด ซึ่งในที่สุดใช้ผลิต &bPlastic&r ได้ "]
	quest.12A7971658135C90.quest_desc: ["&bSentry Turret&r เป็นอาวุธป้องกันอัตโนมัติที่&cยิง&r&2สิ่งมีชีวิต&rทุกตัวในระยะ 16 บล็อก เมื่อ&6ติดตั้ง&r &bGun Ammo&r ", "", "ระยะ&eขยาย&rได้ด้วย &bRange Upgrades&r ", "", "คุณกำหนดได้ว่าจะโจมตี&2เอนทิตี&rใด โดยตั้ง&3ตัวกรอง&rในช่อง '&7Target Filter&r' ", "", "นอกจากนี้ ถ้า &bSentry Turret&r อยู่ภายใต้ &bSecurity Station&r ผู้เล่นที่ &bSecurity Station&r &6อนุญาต&rจะไม่ถูก&cเล็งเป้า&r"]
	quest.15B6718AFA5E6959.quest_desc: ["&6สกัด&r &bSpawner Cores&r จาก &bVanilla Spawners&r ", "", "&cเตรียมรับความท้าทาย…"]
	quest.166CEF9F03DA14F6.quest_desc: ["- สร้าง&cความเสียหาย&r&4มากกว่าอย่างมาก&rเมื่อเทียบกับ &bStandard Ammo&r", "", "มวลที่ใหญ่ทำให้ระยะสั้นมาก และทำให้ &bMinigun&r ใช้&7อากาศ&r&6เร็วขึ้น&r"]
	quest.16B74C92EB86AD0C.quest_desc: ["&6เท&r&7ของเหลว&rลงในโลก หรือ&bทำให้เย็น&rใน&3ช่องเก็บของ&rด้วย &cHeat Frame&r เพื่อ&6ทำให้แข็งตัว&rเป็น &bPlastic Sheets&r ", "", "การใช้ &cHeat Frame&r อาจให้&aผลที่ดีกว่า&r"]
	quest.16B74C92EB86AD0C.title: "&7Molten Plastic"
	quest.1794E588334CB478.quest_desc: ["เครื่องนี้ใช้&6เทคโนโลยีขั้นสูง&r&7บีบอัด&r&bไอเทม&rให้เล็กลงถึง&dขนาดอะตอม&r ทำให้&6เข้าถึง&rและ&6จัดการ&r&9ช่องเก็บของ&rของผู้เล่นได้โดยตรง ", "", "&bไอเทม&r&aใส่เข้า&rและ&cดึงออก&rได้ผ่าน&bฮอปเปอร์&r โดยจะถูกเพิ่มเข้าไปหรือเอาออกจาก&9ช่องเก็บของ&rของผู้เล่นที่วางเครื่อง ", "", "คุณยังใช้วิธีใส่ที่ฉลาดกว่า เช่น &bDrones&r หรือ &bLogistics Frames&r หรือม็อดอื่น เพื่อจัดการ&9ช่องเก็บของ&rของผู้เล่นโดยอัตโนมัติ เช่น เติม&e คบเพลิง 64 อัน&r ให้เต็มอยู่เสมอ"]
	quest.17FCD3ECDC775E69.quest_desc: ["- &cการเจาะเกราะ"]
	quest.18E944F145FEBB8C.quest_desc: ["- &4จุดไฟ&r&cเป้าหมาย&r ", "", "ระวังด้วย มันอาจทำให้&aสภาพแวดล้อมโดยรอบ&rติด&6ไฟ&rด้วย"]
	quest.1A368E5AD57C10E1.quest_desc: ["นี่คือ&6เวอร์ชันขั้นสูง&rของ &bLiquid Compressor&r ", "", "ผลิตได้&eเร็วกว่ามาก&rที่ &750 mL/tick&r แต่ก็สร้าง&4ความร้อน&rด้วย ", "", "เมื่อ&cอุณหภูมิสูงขึ้น&r &4ประสิทธิภาพจะลดลง&r ", "", "ลูกศรล่างบน&eมาตรวัดอุณหภูมิ&rแสดงจุดที่&aประสิทธิภาพ&rเริ่มลดลง ส่วนลูกศรบนบอกจุดที่ประสิทธิภาพเป็น &e0%&r ", "", "ตรงข้ามกับที่คาด เครื่องนี้&cจะไม่ระเบิด&rแม้อุณหภูมิจะ&4สูงเกินไป&r"]
	quest.1D249BAAD819E83F.quest_desc: ["เครื่องนี้&6แปลง&r &bForge Energy&r (&9ใช้ได้กับ RF และพลังงานของม็อดอื่นอีกมาก&r) เป็น&7อากาศอัด&r ", "", "ทำงานด้วย&eประสิทธิภาพพื้นฐาน&r &a40%&r หมายความว่า &b100 FE&r สร้าง&7อากาศอัด 40 mL&r ", "", "การใช้ &bSpeed Upgrades&r จะ&cลด&r&aประสิทธิภาพ&rนี้ลงเล็กน้อย ", "", "นอกจากนี้ &bCompressor&r ยังผลิต&4ความร้อน&r ซึ่งต้องจัดการไม่ให้&aประสิทธิภาพ&r&cลดลง&r"]
	quest.1EC75DB7FA07D06B.quest_desc: ["&9Module&r นี้ระบาย&bอากาศ&r&8แรงดันสูง&rเมื่อ&7ความดันท่อ&rถึง &c4.9&r บาร์ (&c19.9&r สำหรับ &bAdvanced Pressure Tubes&r) ", "", "แม้จะช่วยป้องกัน&cการระเบิด&r แต่ก็ทำให้&cสูญเสียพลังงาน&rและ&cเปลืองเชื้อเพลิง&r ", "", "ด้วย &bModule Expansion Card&r คุณ&6ปรับ&rเกณฑ์ความดันได้อย่างแม่นยำผ่าน &3GUI&r"]
	quest.23313676FB186028.quest_desc: ["หากต้องการ &6หมุน&r บล็อก ให้ &6คลิกขวา&r ที่บล็อก ", "", "หากต้องการ &6สลับ&r ด้านที่ต้องการของ &bPressure Tube&r ระหว่าง &aเปิด&r และ &cปิด&r ให้ &6คลิกขวา&r ที่ท่อ "]
	quest.2689A56675E12245.quest_desc: ["&3สาร&r นี้ใช้ใน &bThermopneumatic Processing Plant&r ร่วมกับ &8Coal&r เพื่อ &6ผลิต&r &7Plastic&r ", "", "เป็น &7เชื้อเพลิงเหลว&r &eชั้นเยี่ยม&r และ &6วาง&r ลงใน &8Furnace&r ได้ด้วย"]
	quest.2689A56675E12245.title: "&eLPG"
	quest.26A44EDA4AABFF6F.quest_desc: ["&bCompressed Steel &fคราฟต์ได้โดย &6โยน &bIron Ingot &fลงพื้นแล้ว &6ระเบิด &fด้วย&b TNT&f แต่คุณอาจไม่ได้ผลลัพธ์คืนทุกครั้ง ", "", "คาดว่าจะสูญเสีย &c25%&r ของ &7Iron&r ที่โยน", "", "- ต้องมี &bCasing&r ตามระดับสายเคเบิลที่จะแปลงไปเป็น (ค่าเริ่มต้นคือ &eLV&r)", "", "หมายเหตุ: กด &6SHIFT&r ค้างเหนือไอเทม &aPNC&r ใดก็ได้เพื่อดูคำอธิบายของไอเทมนั้น"]
	quest.26A44EDA4AABFF6F.title: "&cยินดีต้อนรับ &eสู่ &aPNC (Welcome to PNC)"
	quest.29AC06B27D6A53C5.quest_desc: ["&bDrone&r ที่ตั้งโปรแกรมไว้ล่วงหน้า เก็บ &bไอเทม&r ภายในพื้นที่ &e17x17x17&r &7(ก่อนอัปเกรดระยะ)&r โดยมีจุดศูนย์กลางอยู่ที่ตำแหน่งที่ปล่อยมัน ", "", "&bDrone&r นี้มี &3โหมด&r พื้นฐานสองแบบ ขึ้นอยู่กับตำแหน่งที่ปล่อยเมื่อเทียบกับช่องเก็บของที่ใช้ส่งของ:", "", "- ปล่อยบน &9ช่องเก็บของ&r จะ &6กรอง&r สิ่งที่ &bDrone&r เก็บ ให้ตรงกับ &bไอเทม&r ใน &9ช่องเก็บของ&r ตอนที่ปล่อยเท่านั้น", "", "- ปล่อยบนพื้นข้าง &9ช่องเก็บของ&r จะสั่งให้ &bDrone&r &6เก็บ&r &bไอเทม&r ทุกชิ้นในพื้นที่ของมัน"]
	quest.29B59876D04A3772.quest_desc: ["อุปกรณ์นี้ &6เสก&r &2ม็อบ&r โดยใช้ &7แรงดัน&r ข้ามข้อจำกัด &eระดับแสง&r และเปิดให้ใช้ &4การควบคุมด้วย redstone&r ", "", "ต้องมี &bSpawner Core&r จึงทำงานได้ ", "", "โปรดทราบว่า &bSpawner Core&r ที่ &7ว่างบางส่วน&r จะทำให้ &cประสิทธิภาพลดลง&r"]
	quest.2B8DFC9987083AF7.quest_desc: ["เครื่องนี้ &6ผลิต&r &7Compressed Air&r ", "", "เมื่อต้องการใช้งาน ให้ &6วาง&r ไอเทม &8เชื้อเพลิงแข็ง&r ชนิดใดก็ได้ที่ &cเผา&r ใน &8Furnace&r ได้ ลงในช่องเชื้อเพลิง ", "", "โปรดทราบว่า &7ถังเชื้อเพลิง&r ใช้ไม่ได้ สำหรับ &7เชื้อเพลิงเหลว&r ให้ใช้ &bLiquid Compressor&r แทน"]
	quest.2E5D9CB5D821E96A.quest_desc: ["&bPressure Tube&r ชนิดที่ &8ทนทาน&r ที่สุด ", "", "&bTubes&r เหล่านี้ &2พรางตัว&r ได้ และรองรับ &bTube Modules&r เพื่อเพิ่ม &eฟังก์ชันพิเศษ&r"]
	quest.325A0651CB2D1279.quest_desc: ["เครื่องนี้นำ &cEmpty PCBs&r ไปรับ &eแสง UV&r เพื่อเตรียม &6แปรรูป&r ใน &bEtching Tank&r", "", "&eเวลารับแสง&r ที่นานขึ้นเพิ่มโอกาส &aการกัดสำเร็จ&r แต่กระบวนการจะ &7ช้าลง&r เมื่อเวลาผ่านไป ", "", "คุณตั้ง &3ค่าเกณฑ์&r เพื่อกำหนดว่าเมื่อใด &bPCB&r ถือว่า &aเสร็จ&r ได้ &eค่าเกณฑ์ที่ต่ำกว่า&r ทำให้ &6แปรรูป&r เร็วขึ้นแต่เพิ่มความเสี่ยงที่ &cกัดไม่สำเร็จ&r ", "", "&cPCBs ที่ล้มเหลว&r &2รีไซเคิล&r ได้ใน &8Blast Furnace&r เพื่อลองใหม่"]
	quest.33CEED6232901CE5.quest_desc: ["&6ใช้&r กับ &bVaccum Trap&r เครื่องนี้จะ &6ดูด&r &7ม็อบ&r ที่อยู่ใกล้และใส่ลงใน &bSpawner Core&r หากต้องการให้ทำงาน คุณต้อง &6คราฟต์&r &bSpawner Core&r ก่อน แล้ว &6ใส่&r ลงใน &bVaccum Trap&r"]
	quest.3618C8F2EE6E308F.quest_desc: ["&bVaccum Pump&r ใช้สร้าง &7vaccum seal&r ซึ่งใช้กับ &bVaccum Trap&r "]
	quest.3696D20B77DF1B24.quest_desc: ["&3ส่วนประกอบหลัก&r ของ &bSpawner&r ", "", "&6ใส่&r ลงใน &bPressurized Spawner&r เพื่อสร้าง &7ม็อบ&r จาก &aแก่นแท้&r ที่เก็บอยู่ภายใน ", "", "&bSpawner Cores&r ที่เอามาจาก &bVanilla Spawner&r มี &aแก่นแท้บริสุทธิ์&r ของ &7สิ่งมีชีวิต&r ชนิดใดชนิดหนึ่งโดยเฉพาะ "]
	quest.378A3A640EF06FE5.quest_desc: ["&6สร้าง&r &7อากาศ&r ปริมาณมากจาก &eฟ้าผ่า&r ", "", "หากต้องการข้อมูลละเอียด ดู &3GUI&r หรือแท็บข้อมูลของ &dEMI&r"]
	quest.38D846A79BC43920.quest_desc: ["เครื่องนี้ใช้ &6ชาร์จ/คายประจุ&r &bไอเทม&r ที่ทำงานด้วย &ePneumatic Power&r เช่น &bDrones&r, &bPneumatic Wrenches&r และ &bVortex Cannons&r ", "", "ยังจัดการ &aอัปเกรด&r ของ &bไอเทม&r ที่รองรับด้วย"]
	quest.3D7406A517FA591D.quest_desc: ["ด้วย &bMaterials&r เหล่านี้ คุณจะ &6สร้าง&r &bPressure Chamber&r แรกของคุณได้ "]
	quest.3D7406A517FA591D.title: "Pressure Chamber แรกของคุณ (Your First Pressure Chamber)"
	quest.40F96E2CB2772CB8.quest_desc: ["&bAmadron Tablets&r ให้คุณ &6สั่งซื้อ &bไอเทม&r และ &7ของเหลว&r ทำงานคล้าย &3การค้ากับ Villager&r แต่มีข้อดีเพิ่มคือจัดส่งโดย &bDrones&r — เจ๋งกว่าการต่อรองกับ &aVillagers&r มาก ", "", "การใช้ &bTablet&r ให้กำหนดตำแหน่ง &9รับของ&r และ &9ส่งของ&r ด้วยการ &6คลิกขวา&r ที่ &3inventory&r หรือ &bถัง&r ด้วย &bTablet&r"]
	quest.46C3D171AB4AA489.quest_desc: ["&3สาร&r นี้ &6แปรรูป&r ใน &bThermopneumatic Processing Plant&r เพื่อ &6ผลิต&r &8Gasoline&r ซึ่งเป็น &7เชื้อเพลิงเหลว&r &aคุณภาพสูง&r ", "", "ยัง &6ใส่&r ใน &8Furnace&r ได้ด้วย"]
	quest.46C3D171AB4AA489.title: "&3Kerosene"
	quest.486620B859CE9D1F.quest_desc: ["&bอุปกรณ์&r นี้แยก &7อากาศ&r ที่ &aไหลเข้า&r เป็นส่วน &cร้อน&r และ &bเย็น&r โดยด้านหนึ่งกลายเป็น &cร้อน&r อีกด้านเป็น &bเย็น&r ", "", "ปริมาณ &7อากาศ&r ที่ใช้ขึ้นอยู่กับ &7ความดัน&r ", "", "เพื่อ &aประสิทธิภาพสูงสุด&r โปรด &cระวัง&r ว่ามีการเชื่อมต่อทางความร้อนเล็กน้อยระหว่างด้าน &cร้อน&r และ &bเย็น&r ", "", "เพื่อใช้ &4ความร้อน&r ให้เต็มที่ ให้ &6ระบาย&r &bด้านเย็น&r ด้วย &cHeat Sink&r และทำตรงกันข้ามหากต้องการ &6เพิ่ม&r &bความเย็น&r ให้สูงสุด"]
	quest.525658A19130AF37.quest_desc: ["ผลิต &7Compressed Air&r โดยใช้ &7ของเหลวเชื้อเพลิง&r ต่าง ๆ ", "", "หากต้องการดู &8เชื้อเพลิง&r ที่ใช้ได้ทั้งหมด ให้เปิดแท็บ ‘&9Available Fuels&r’ ซึ่งเรียงจาก &aมีประสิทธิภาพมากที่สุด&r ไป &cน้อยที่สุด&r "]
	quest.5299134A1144826F.quest_desc: ["&6ชาร์จ/คายประจุ&r ได้ด้วย &bCharging Station&r ", "", "จำเป็นสำหรับ &6คราฟต์&r &bไอเทมที่ชาร์จได้&r แบบนิวเมติกส่วนใหญ่ และใช้ &6ชาร์จ&r &bไอเทม&r อื่นได้ด้วย", "ปริมาณพลังงานที่ผลิตขึ้นอยู่กับความเร็วลมอย่างมาก (แน่นอน) และความเร็วลมเพิ่มขึ้นเมื่อวาง Wind Generator สูงในโลก"]
	quest.5EEF6110DDBEB146.quest_desc: ["&bDrone&r ที่ตั้งโปรแกรมไว้ล่วงหน้า คอยป้องกันพื้นที่ &e31x31x31&r โดยมีจุดศูนย์กลางอยู่ที่ตำแหน่งที่ปล่อยมัน ", "", "&bDrone&r นี้มี &3โหมด&r พื้นฐานสองแบบ ขึ้นอยู่กับวิธีปล่อย:", "", "- ปล่อยบนพื้นจะสั่งให้ &bDrone&r &cโจมตี&r &2มอนสเตอร์&r ใด ๆ ที่เข้ามาในพื้นที่ ด้วยอุปกรณ์ที่มีติดตัวอยู่แล้ว", "", "- ปล่อยบน &9ช่องเก็บของ&r ที่มี &cอาวุธ&r หรือ &7Minigun Ammo&r (หากโดรนติดตั้ง minigun upgrade) จะสั่งให้ &bDrone&r ติดอาวุธให้ตัวเองด้วย &bไอเทม&r ในช่องเก็บของ ก่อน &eป้องกัน&r พื้นที่"]
	quest.6070283AEA8DFA7E.quest_desc: ["&bRefinery&r เป็น &3multiblock&r ที่คุณ &6วาง&r &bRefinery Controller&r ไว้ด้านล่าง และวาง &bRefineries&r ซ้อนด้านบน เริ่มต้น &aสอง&r ชั้น aสอง&r ชั้น ", "", "คุณ &6วาง&r ได้สูงสุด &a4&r ชั้น ซึ่ง &cไม่ได้เพิ่ม&r &eความเร็ว&r ของ &bRefinery&r แต่ช่วยให้ &6ผลิต&r &7ของเหลว&r อื่นจาก &8Crude Oil&r ได้", "", "เมื่อมี &bRefineries&r สองชั้นด้านบน คุณจะเริ่ม &6ผลิต&r &8Diesel&r และ &eLPG&r เมื่อรวบรวม &bทรัพยากร&r ได้ การเพิ่ม &bRefinery&r อีกชั้นจะได้ &bKerosene&r และอีกชั้นจะได้ &8Gasoline&r", "", "การใช้ &bRefinery&r ต้องมี &4ความร้อน&r &4ความร้อน&r หาได้จาก &bTorches&r รอบ &bเครื่อง&r ให้ &aประสิทธิภาพต่ำ&r, &4lava&r ให้ &eประสิทธิภาพปานกลาง&r และ &cความร้อนที่ผลิตได้&r จาก &bVortex Tube&r ที่ใช้ &7แรงดัน&r"]
	quest.6070283AEA8DFA7E.title: "Refinery"
	quest.6127E7FBC4ABF307.quest_desc: ["&bThermopneumatic Processing Plant&r ใช้ &6แปลง&r &7ของเหลว&r ให้เป็น &7ของเหลว&r ชนิดอื่น ", "", "เช่น การรวม &eLPG&r กับ &8Coal&r ในเครื่องนี้ &6ผลิต&r &7Liquid Plastic&r ได้ ", "", "นอกจากนี้ &bTPP&r ยัง &6ทำ&r &7fuel cracking&r ได้ คือ &6เปลี่ยน&r &cเชื้อเพลิงที่หนักกว่า&r ให้เป็น &aเชื้อเพลิงที่เบากว่า&r ", "", "หมายความว่า:", " ", "&cDiesel&r -> &3Kerosene&r ", "", "&3Kerosene&r -> &6Gasoline&r", "", "&6Gasoline&r -> &eLPG&r"]
	quest.6762C357EEDE8D10.quest_desc: ["คอมเพรสเซอร์ขั้นสูงที่ใช้ &eแสงแดด&r เพื่อ &7อัดอากาศ&r ", "", "&aประสิทธิภาพ&r จะดีขึ้นเมื่อ &cร้อนขึ้น&r แต่หากสะสม &4ความร้อน&r มากเกินไป คอมเพรสเซอร์จะ &8ดับ&r และต้อง &6ซ่อมด้วยมือ&r"]
	quest.67B17617F57B247F.quest_desc: ["&bElevator&r ใช้ &7แรงดัน&r พาคุณขึ้นลงระหว่างชั้นต่าง ๆ ด้วย &bController&r วาง &bElevator&r หนึ่งตัวจะขึ้นได้ &eรวม&r หกบล็อก หากซ้อน &bElevator Bases&r ต่อกันเหนือ &cความสูงสูงสุด&r จะ &aเพิ่ม&r ทีละหกบล็อกต่อหนึ่งตัวที่วาง", "", "คุณ &aเพิ่ม&r ความกว้างและความลึกของ &bElevator&r ได้ โดยเพิ่ม &bElevator Bases&r ในจำนวนเท่ากับที่วางครั้งแรก ", "", "วาง &bController&r ที่ &eระดับสายตา&r สูงจากพื้นหนึ่งบล็อก อยู่ทางซ้ายหรือขวาแต่ติดกับ &bElevator&r โดยแตะ &bElevator Shaft&r ต้องวางทุกบล็อกเพื่อให้ &bElevator&r ขึ้นไปได้ เพราะมันเคลื่อนไปตาม &brails&r ", "", "หากต้องการให้ &bElevator&r ขึ้นไป &330 บล็อก&r ที่มี &aสามชั้น&r คุณต้องมี:", "", "&96&r &bElevator Bases&r x กว้างและลึก", "", "&930 &bElevator Shafts&r x กว้างและลึก", "", "&91&r &bController&r ต่อหนึ่งชั้น รวมเป็นสาม ", "", "&7แรงดัน&r ที่ &bElevator&r ต้องใช้สูงสุดที่ &c5.0&r และไม่เพิ่มตามจำนวน &bElevator Bases&r"]
	quest.67B17617F57B247F.title: "Elevator"
	quest.688DEE1D1C4F9BDA.quest_desc: ["&9โมดูล&r นี้ส่ง &4สัญญาณ redstone&r ที่มีความแรงเป็นสัดส่วนกับ &7แรงดัน&r ภายใน &bท่อ&r ", "", "เมื่อ &6ติดตั้ง&r &bModule Expansion Card&r คุณ &6ปรับ&r ค่าเกณฑ์ได้อย่างแม่นยำผ่าน &3GUI&r"]
	quest.6E2932D7D8228910.title: "&7Pressure &cGauge"
	quest.6F5731A4490A537F.quest_desc: ["เติม &2Etching Acid&r ลงใน &bEtching Tank&r เพื่อแปลง: ", "", "&7Empty PCBs&r -> &bUnassembled PCBs&r"]
	quest.6F5731A4490A537F.title: "&2Etching Acid"
	quest.7342ABDAD6467123.quest_desc: ["Logistics frames ทำให้งานลำเลียงภายในเครือข่ายง่ายขึ้น ไม่ว่าจะด้วยโดรนหรือท่อที่อัดแรงดันอย่างน้อย 3 bar ต้องใช้ &4logistics wrench&r เพื่อทำงานกับ logistics frames ทุกชนิด", "", "frame ทำงานภายในเครือข่ายของตนดังนี้ เรียงตามลำดับความสำคัญ:", "", "- Active provider frames ส่งไอเทมไปยัง requester, storage และ default storage frames", "- Default storage frames ส่งไอเทมไปยัง requester และ storage frames และรับไอเทมจาก active provider frames", "- Storage frames ส่งไอเทมไปยัง requester frames และรับไอเทมจาก active provider frames และ default frames", "- Passive frames ส่งไอเทมไปยัง requester frames เท่านั้น และไม่รับไอเทมจาก frame อื่นใด", "- Requester frames ไม่ส่งไอเทมไปยัง frame อื่น และรับไอเทมจาก active provider, passive และ storage frames", "", "{@pagebreak}", "ตั้งตัวกรองให้แต่ละ frame ได้โดยใช้ตัวกรอง Classify หรือ Tag โดยใช้ Tag workbench กำหนดตัวกรอง ", "", "การทำงานขึ้นอยู่กับ frame ที่ใช้ตัวกรอง:", "", "- Active provider frames: ตัวกรองควบคุมว่าของเหลว/ไอเทมใดถูกส่งเข้าเครือข่าย", "- Default storage frames: ตัวกรองควบคุมว่าของเหลว/ไอเทมใดรับจากเครือข่าย", "- Storage frames: ตัวกรองควบคุมว่าของเหลว/ไอเทมใดรับจากเครือข่าย", "- Passive frames: ตัวกรองควบคุมว่าของเหลว/ไอเทมใดส่งไปยัง Requester frames ในเครือข่าย", "- Requester frames: ตัวกรองควบคุมว่าของเหลว/ไอเทมใดรับจากเครือข่าย", "", "เฉพาะ requester frames ใช้ตัวกรองได้ทั้งสองชนิด และเลื่อน/คลิกเพื่อตั้งจำนวนที่ต้องการ (ดูคำแนะนำใน UI ของ Requester frame) แม้ตัวกรองจะซ้อนทับกันได้ (เช่น อันหนึ่งระบุ log 32 ชิ้น อีกอันระบุเชื้อเพลิงชนิดใดก็ได้ 32 ชิ้น) แต่อาจทำให้ตัวกรองนับรวมกัน ได้เป็น log 32 ชิ้น + อีก 32 ชิ้นในฐานะเชื้อเพลิง", "", "{@pagebreak}", "สำหรับ logistics frames ทุกชนิด จะไม่มีการลำเลียงใด ๆ หากไม่มีที่ว่างในช่องเก็บของ/ถังใดเลยในเครือข่าย ", "", "นอกจากนี้ แม้งานลำเลียงจะทำได้ทั้งด้วย logistics drones หรือ logistics modules ที่ติดกับท่อซึ่งอัดแรงดันอย่างน้อย 3 bar แต่ drones เข้าถึง frames ไม่ได้เมื่อถูก logistics modules กีดขวางแล้ว อย่างไรก็ตามติด frames หลายตัวกับบล็อก/ช่องเก็บของ/ถังเดียวกันได้หากต้องการ"]
	quest.7342ABDAD6467123.title: "Logistics Frames"
	quest.77897C0A26941E97.quest_desc: ["- &3แช่แข็ง&r เป้าหมาย", "", "- &7ทำให้ช้าลง&r และอาจ &8ห่อหุ้ม&r ด้วยน้ำแข็งชั่วคราว ", "", "มอนสเตอร์ที่ &6ทนไฟ&r จะ &cอ่อนแอ&r ต่อกระสุนนี้เป็นพิเศษ"]
	quest.79C075FFF796FE16.quest_desc: ["&bDrone&r ที่ตั้งโปรแกรมไว้แล้ว &2เก็บเกี่ยว&r &acrops&r ที่โตเต็มที่ภายในพื้นที่ &e17x17x17&r โดยมีตำแหน่งที่ปล่อยออกมาเป็นจุดศูนย์กลาง ", "", "&bDrone&r นี้มี &3โหมด&r พื้นฐานสองแบบ ขึ้นอยู่กับวิธีปล่อย", "", "- ปล่อยบนพื้น จะสั่งให้ &bdrone&r &2เก็บเกี่ยว&r &acrops&r ที่โตเต็มที่ทั้งหมดในพื้นที่", "", "- ปล่อยบน &3inventory&r ที่มี &bHoe&r อยู่ภายใน จะสั่งให้ drone &6ปลูกซ้ำ&r &acrops&r ที่เก็บเกี่ยวได้ในพื้นที่"]
	quest.7BD7F5E46151B2EB.quest_desc: ["&bDrone&r ที่ตั้งโปรแกรมไว้แล้ว ทำงานลอจิสติกส์ภายในพื้นที่ &e31x31x31&r โดยมีตำแหน่งที่ปล่อยออกมาเป็นจุดศูนย์กลาง ", "", "ดู &7บท Quest&r ถัดไปว่าใช้ logistics frame ที่ติดกับ &9blocks/inventories/tanks&r ในพื้นที่ของมันอย่างไร"]
	quest.7C31082BB88384BF.quest_desc: ["- ทำให้ &cเกิดระเบิด&r เมื่อ &eกระทบ&r ", "", "อย่าใช้ในระยะใกล้!"]
	quest.7C57D76FDBD784F8.quest_desc: ["คุณ &6เชื่อมต่อ&r &bTanks&r ด้านบนและด้านล่างได้โดยใช้ &bWrench&r ตราบใดที่ &bTank&r ใดใบหนึ่ง &cว่างเปล่า&r หรือทั้งสองถังบรรจุ &7ของเหลว&r ชนิดเดียวกัน"]
	quest.7D155344A5A6CEF7.quest_desc: ["&bThermal Compressor&r ใช้ &eความต่างของอุณหภูมิ&r ที่ด้านตรงข้ามของบล็อกเพื่ออัดอากาศ (&7air&r) ", "", "การใช้งาน วางบล็อก &cอุณหภูมิสูง&r ไว้ด้านหนึ่ง และบล็อก &aอุณหภูมิต่ำ&r ไว้ด้านตรงข้าม ", "", "หมายเหตุ: ด้าน &3North-South&r เชื่อมต่อความร้อนถึงกัน เช่นเดียวกับด้าน &3East-West&r แต่ &3North-South&r กับ &3East-West&r ไม่มี &eการเชื่อมต่อความร้อน&r ระหว่างกัน ", "", "ด้านที่ &eเชื่อมต่อความร้อน&r จะพยายามปรับ &bอุณหภูมิ&r ให้เท่ากัน จึงต้องรักษาความต่างของอุณหภูมิให้ &cมากพอ&r เพื่อให้ทำงานได้ &aอย่างมีประสิทธิภาพ&r"]
	quest.7D58D814C99CB2F6.quest_desc: ["&bdevice&r นี้ &6วาง&r บน &2inventory&r ใดก็ได้ ", "", "เมื่อ &cได้รับความร้อน&r จาก &4แหล่งความร้อน&r ที่อยู่ติดกัน มันจะพยายาม &8หลอม&r &bไอเทม&r ใด ๆ ใน &2inventory&r และจะ &bแช่แข็ง&r ไอเทมเมื่อ &3ถูกทำให้เย็น&r การ &8หลอม&r จะ &aสำเร็จ&r ต่อเมื่อ &2inventory&r มีที่ว่างสำหรับ &bไอเทม&r ที่ได้ ", "", "อัตราการหลอม &aเพิ่มขึ้น&r ตาม &cความร้อน&r ที่ได้รับ สูงสุด &6หนึ่งไอเทมต่อวินาที&r ", "", "ในทำนองเดียวกัน &3กระบวนการแช่แข็ง&r &eเร็วขึ้น&r ตาม &3การทำความเย็น&r ที่เพิ่มขึ้น"]
	task.4F4699F9117BC270.title: "Pre-Programmed Drones"
}
