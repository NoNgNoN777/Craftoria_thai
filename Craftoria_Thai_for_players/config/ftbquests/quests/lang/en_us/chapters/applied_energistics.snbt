{
	quest.000F7897FF9ED7DC.quest_desc: ["มี &a4 ระยะ&f ของการเติบโต เหมือน &bCertus Quartz Clusters&f ใน&aสามระยะแรก&fจะได้ &bEntro Dust&f แต่ใน&aระยะที่สี่&fจะได้ &bEntroized Crystals&f"]
	quest.00237AB9C48C8A9B.quest_desc: ["&bMatter Condencer &fช่วยให้คุณ&6ทำ &bMatter Balls&f สำหรับ &bPaint Gun&f และ&6ทำ&b Singularities &fโดยแลกกับ&aไอเทมเอนทิตี&f"]
	quest.002410CF49E1E14E.quest_desc: ["คราฟต์ด้วย &bFE Storage Components &fเพื่อเก็บ&4พลังงาน&f"]
	quest.003C38C78609709B.quest_desc: ["คราฟต์ใน &bInscriber&f โดย &bAccumulation Press&f ใช้ร่วมกับ &bSky Stone Ingots&f เพื่อผลิต &bAccumulation Circuits&f"]
	quest.011E9553CDCAE218.quest_desc: ["เพิ่มความจุพื้นที่เก็บของเป็นสี่เท่าสินะ?"]
	quest.011E9553CDCAE218.title: "4k Storage Component"
	quest.0547229FF5334CF5.quest_desc: ["&bInterface&f ทำงานเหมือนหีบ คุณ&aตั้งไอเทมหรือของเหลว&f ไว้ใน &bInterface&f แล้วมันจะดึงไอเทมนั้นจาก&5เครือข่าย&f มาเก็บสต็อกให้"]
	quest.05B2AA73EAEDCCF4.quest_desc: ["&bExport Bus&r เหล่านี้มีฟังก์ชันขั้นสูงกว่า &bExport Bus&r ธรรมดา", "", "&bTag Export Bus&r ส่งออกไอเทมจากแท็กที่กรองไว้", "", "&bMod Export Bus&r ส่งออกไอเทมจากม็อดที่กรองไว้", "", "&bPrecise Export Bus&r ส่งออกไอเทมตามจำนวนที่ตั้งไว้พอดี ไม่ขาดไม่เกิน", "", "&bThreshold Export Bus&r ส่งออกไอเทมเมื่อจำนวนไอเทมสูงกว่าหรือต่ำกว่าเกณฑ์ที่ตั้งไว้"]
	quest.05B2AA73EAEDCCF4.title: "Advanced Export Buses"
	quest.05E7C7E41BA79426.quest_subtitle: "ชาร์จสี่เท่า"
	quest.0633D2B1E1DB778B.quest_desc: ["ได้จากการ&6หลอม &bCertus Quartz Dust&f &bSilicon&f ใช้ในโปรเซสเซอร์ 3 ชนิดที่คุณต้องใช้เพื่อเดินหน้าต่อ"]
	quest.0633D2B1E1DB778B.title: "Silicon"
	quest.06D66E791A9939DD.quest_desc: ["สร้าง &bCharger&r แล้วจ่ายพลังงานด้วย &bVibration Chamber&r หรือเครื่องกำเนิดไฟฟ้าจากม็อดอื่น"]
	quest.06D66E791A9939DD.quest_subtitle: "ชาร์จเครื่องมือที่รองรับผ่านเครือข่าย ME"
	quest.06D66E791A9939DD.title: "Charger"
	quest.09B10C121C7E9023.quest_desc: ["ใช้คราฟต์ &bME Energy Storage Components&f และอุปกรณ์เสริมอื่น ๆ"]
	quest.0B94435972292812.quest_desc: ["&bSpatial IO Port &fเป็นแกนกลางของ&bระบบ Spatial Digitizing&f วางที่จุดยอดซึ่ง &bขอบเสา&f ทั้ง 3 มาบรรจบกัน เป็นที่วาง &bSpatial Drive &fเพื่อให้มัน&6จับภาพสิ่งก่อสร้างหรือปล่อยมันออกมา&f และเป็นบล็อกที่ต้องจ่ายพลังงานเมื่อชาร์จระบบด้วย", "", "คุณใช้ฮอปเปอร์หรือวิธีวางท่ออื่นกับ &bSpatial IO Port&f เพื่อทำกระบวนการนี้อัตโนมัติได้หากต้องการ &6สัญญาณเรดสโตน&f เพียงอย่างเดียวก็เปิดใช้ &bSpatial IO Port&f ได้ ระวังด้วย"]
	quest.0B94435972292812.title: "Spatial IO Port"
	quest.0B98E8AC5CFB0FC2.quest_desc: ["ได้เมื่อคุณปล่อยให้&b Entroized Clusters &aเติบโต&fจนถึง&aขั้นสูงสุด&f"]
	quest.0FA3C7049E71EA4A.quest_desc: ["คิดจะมี &bQuarry&f เร็ว ๆ นี้หรือเปล่า"]
	quest.0FA3C7049E71EA4A.title: "64k Storage Component"
	quest.123F10122DCC72F9.quest_desc: ["การเพิ่ม &bCompression Card&r ลงใน &bBulk Storage Cell&r ทำให้มันบีบอัดไอเทมหรือบล็อกเป็นระดับการบีบอัดที่สูงขึ้นโดยอัตโนมัติ", "", "เช่น Nuggets -> Ingots -> Blocks", "", "คุณควรมี &bDecompression Module&r ไว้ที่ใดที่หนึ่งในเครือข่าย เพื่อคลายการบีบอัดไอเทมอัตโนมัติตามต้องการด้วย", "", "หมายเหตุ: &bDecompression Module&r ต้อง&r อยู่ในเครือข่ายเดียวกับระบบคราฟต์อัตโนมัติของคุณ ไม่เช่นนั้นเครื่องคราฟต์อัตโนมัติจะมองไม่เห็นไอเทมเหล่านั้น"]
	quest.123F10122DCC72F9.title: "การบีบอัด Bulk Cell (Bulk Cell Compression)"
	quest.13600E981D85B79D.quest_desc: ["จำเป็นสำหรับการคราฟต์อัตโนมัติ เพราะใช้เก็บไอเทมและของเหลวที่ใช้ในการคราฟต์"]
	quest.13600E981D85B79D.title: "Crafting Storage"
	quest.15008EFBA92CC3DC.quest_desc: ["เปิดคู่มือ AE2 ได้โดยกด G ค้างไว้ที่ไอเทม AE2 เกือบทุกชนิด", "", "นอกจากนี้ยังมีไอเทม &bGuide&r ให้ฟรีด้วย เผื่อคุณอยากได้"]
	quest.151E812270A52250.quest_desc: ["&6Crafting Components&f ใช้คราฟต์ &bCo-Processing Units&r และ &bCrafting Storages&b"]
	quest.151E812270A52250.title: "Crafting Unit"
	quest.1523A200F5E4361B.quest_desc: ["&bExtended Inscriber &fทำ&aสี่กระบวนการ &fพร้อมกันได้"]
	quest.1607D3C2384B6CFF.quest_desc: ["&bAccumulator Processor&f ใช้กับ &bMEGA Storage Components&f ทุกชนิด"]
	quest.17E8751018E9E0F6.quest_desc: ["เหมือนกับตัวก่อนหน้าทุกอย่าง แต่จุมากกว่าแปดเท่า อย่าเผลอปล่อยประจุออกหมดล่ะ อาจเจ็บได้"]
	quest.17E8751018E9E0F6.title: "Dense Energy Cell"
	quest.18956DB32D96ED2B.quest_desc: ["อัปเกรดแล้วเหรอ จะแบกบ้านไปด้วยเหรอ ไอเดียดี เต็นท์ชอบทำให้ปวดหลัง"]
	quest.18956DB32D96ED2B.title: "Medium Spatial Component"
	quest.18D6860E893D80D2.quest_desc: ["ให้คุณ&aย้ายไอเทม&fจาก &bStorage Drives &fของคุณไปยัง &bStorage Drives&f อื่น ", "", "มีประโยชน์เมื่อต้องการ&aบีบอัดไอเทม&fใน &bDrives&f หรือทำให้ &bDrives &fว่างเพื่อทำอันที่ใหญ่กว่า"]
	quest.19A2B9A9862C59F2.quest_desc: ["ใช้&aแพ็กและย้าย&b Drives &fโดย&aไม่ต้องถอด&fออกจาก&b Storage Drives&f", "", "ใช้ได้กับบล็อก AE2 ส่วนใหญ่"]
	quest.19C33613F2811BAA.quest_desc: ["&bBasic Terminal&f ให้คุณเข้าถึง&bที่เก็บของ&fได้ แต่อัปเกรดได้"]
	quest.19C33613F2811BAA.title: "Terminal"
	quest.1B1ED97DF0FE2E3C.quest_desc: ["&bStorage Bus&f ให้คุณใช้หีบหรือกล่องเก็บของอื่นเป็น&5เครือข่าย &fสำหรับ &bME System&f ของคุณเชื่อมต่อ แทนการใช้ &bStorage Drive&f"]
	quest.1C7918099D5A55E2.quest_desc: ["&bConcurrent Press &fใช้ภายใน &bInscriber &fเพื่อคราฟต์ &bConcurrent Processor&f"]
	quest.1EEBC04FABD3B3F2.quest_desc: ["&bQuartz Fiber&f ใช้&6ส่ง&r&bพลังงาน&f แต่ไม่ส่ง &bChannels&f"]
	quest.1EEBC04FABD3B3F2.title: "Quartz Fiber"
	quest.20F66D987F15593E.quest_desc: ["ส่วนประกอบหลักที่ใช้คราฟต์ &bFE Storage Cells&r ซึ่งใช้เก็บ FE ในระบบ ME ของคุณ"]
	quest.20F99CBAD8D587DA.quest_desc: ["หากต้องการ &bCertus&f ก่อนอื่นให้ไปที่ &bMeteorite&f แล้วเก็บ &bCertus Quartz&f อย่างน้อย 5 ชิ้น และ &6คราฟต์&f &bBudding Certus&f 1 ชิ้น &bBudding Block&f นี้ &6วาง&f ลงพื้นแล้วรอให้ผลึกงอกได้ เมื่อ &bผลึก&f งอกขึ้น &bBudding Block&f มีโอกาส &6เสื่อมสภาพ&f จนกลายเป็นแค่ &bCertus Block&f และจะไม่งอกอีกต่อไป"]
	quest.20F99CBAD8D587DA.title: "Certus Quartz (Certus Quartz)"
	quest.2190034B6F3E2768.quest_desc: ["นี่คือส่วนประกอบหลักของ &bInput and Output Devices&f"]
	quest.2190034B6F3E2768.title: "หัวใจแห่งการประมวลผล (Heart of Computation)"
	quest.222793DF035B167C.quest_desc: ["&bcable&f ที่ทำง่ายที่สุด &6ส่งต่อ&b พลังงาน &fและ &bchannels&f ไปยังระบบของคุณ"]
	quest.222793DF035B167C.title: "Fluix Glass Cable"
	quest.237468FAB20906A8.quest_desc: [""]
	quest.237468FAB20906A8.quest_subtitle: "ความจุ 2 เท่า"
	quest.23CC2667A1269C9C.quest_desc: ["จนถึงตอนนี้ คุณใช้แต่&b Drives &fที่เก็บ &6ข้อมูลสองมิติ&f ในรูปของเลขศูนย์และหนึ่ง ทีนี้ มาเก็บ&6 ข้อมูลสามมิติ&f ในรูปของสสารดิบกัน นี่เป็น &bdrive&f ประเภทที่ซับซ้อนกว่ามาก จึงมีราคาแพงและช่วงแรกคุณเก็บได้ไม่มาก "]
	quest.23CC2667A1269C9C.title: "Small Spatial Component"
	quest.24E5FA9129987168.quest_desc: ["เหมือน &bWireless Terminal&f ทุกอย่าง แต่อันนี้มี &bCrafting Interface&f ในตัว!"]
