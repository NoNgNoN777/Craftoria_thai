{
	image.2A6E901ECBE6C133.title: "เครื่องบิน! เครื่องบิน!"
	image.2B673A94F85BBA93.title: "ด้วยปีกและคำอธิษฐาน"
	image.4E34D721F0838706.title: "Air Caravan"
	image.56440EA3C909025B.title: "เป็นพยานข้าสิ!"
	quest.0075009DEEA010B7.quest_desc: ["ออกรบกันเถอะ...", "...แล้วชวนเพื่อน ๆ มาด้วย!", "", "ยานนี้นั่งได้สี่คน มีสามเครื่องยนต์ ช่องอาวุธสองช่อง และที่ว่างพอสำหรับเสบียงสงครามหรือขนของรางวัลของผู้ชนะกลับฐาน"]
	quest.0075009DEEA010B7.quest_subtitle: "ได้ยินเพลง \"Ride of the Valkyries\" ไหม?"
	quest.16F37A3E31EBDA50.quest_desc: ["ยานที่นั่งเดี่ยวความเร็วสูง ต้องใช้ความพยายามในการบังคับมากกว่า แต่สนุกสุด ๆ", "", "มีที่เก็บของอยู่บ้าง ช่องอาวุธหนึ่งช่อง ช่องอัปเกรดสี่ช่อง ช่องแบนเนอร์ และยังติดจรวดเพื่อเร่งความเร็วได้ด้วย"]
	quest.217C5C65AFC95842.quest_desc: ["ขนาดเล็ก เหมาะกับงานที่ทำเหนือพื้นดิน... สร้างบ้าน ขุดเพดานถ้ำ ฯลฯ", "", "ใช้เชื้อเพลิง มีช่องอัปเกรด 1 ช่อง ช่องอาวุธ 1 ช่อง และพื้นที่เก็บของบางส่วน"]
	quest.4E062B9B4960632D.quest_desc: ["ยานที่ใช้เชื้อเพลิงอย่างเป็นเรื่องเป็นราว... และนั่งได้สองคน!", "", "มีพื้นที่เก็บของพอสมควร ช่องอัปเกรดสามช่อง ช่องอาวุธหนึ่งช่อง ช่องธงหนึ่งช่อง และช่องสีย้อมด้วย - สำหรับย้อมสีจมูกด้านหน้าและหางด้านหลัง"]
	quest.5A5583EA02C78372.quest_desc: ["เรือเหาะรุ่นอัปเกรด พร้อมพื้นที่เก็บของเหลือเฟือ", "", "เหมาะสำหรับขนของที่ปล้นมาและแร่กลับบ้านจำนวนมาก", "", "ยังเหมาะกับคนที่โหยหาชีวิตเร่ร่อนอีกด้วย"]
	quest.73A75FEFDFB27A5C.quest_desc: ["การขนส่งระยะไกลราคาถูก", "", "ใช้พลังงาน ของคุณ&r (ความหิว)", "", "มีช่องอัปเกรดสามช่อง ช่องอาวุธหนึ่งช่อง และที่เก็บของขนาดเท่าหีบหนึ่งใบ"]
}
