	quest.38B3B3386E00FEB9.title: "hidden/collect_frostbite_crystal"
	quest.38BFA21E2879C7D7.title: "unlocks/reagents/citrine_powder"
	quest.38D846A79BC43920.quest_desc: ["เครื่องนี้ใช้ &6ชาร์จ/คายประจุ&r &bไอเทม&r ที่ทำงานด้วย &ePneumatic Power&r เช่น &bDrones&r, &bPneumatic Wrenches&r และ &bVortex Cannons&r ", "", "ยังจัดการ &aอัปเกรด&r ของ &bไอเทม&r ที่รองรับด้วย"]
	quest.38DB543FC6B7B91B.title: "unlocks/enchantments/vanilla_quitoxic"
	quest.38DF71D9CB5045F2.quest_desc: ["เป็นทองเหลือง มัน &6หมุน&r และ &6ดูเท่&r แค่นี้พอ"]
	quest.38E1A4E0A032E377.quest_desc: ["&bStable Wormholes&r ทำหน้าที่เป็นจุดเข้าถึง &bStorage Actuator&r ที่วางได้ ส่งไอเทมเข้าออกผ่านท่อได้ แต่แนะนำให้ใช้ transporter spirit เมื่อดึงของออก เพื่อลดปัญหาแลค", "", "&bStorage Accessor&r เป็นอุปกรณ์ง่าย ๆ ที่ให้คุณ &6เชื่อมต่อกับที่เก็บของ&r จากระยะไกล ไม่มีขีดจำกัดระยะหรือมิติ แต่ actuator ต้องถูก chunk load ไว้"]
	quest.38E1A4E0A032E377.quest_subtitle: "ถ่ายโอนจากระยะไกล"
	quest.38E1A4E0A032E377.title: "Storage Access"
	quest.38E5EBCA2079EF22.quest_desc: ["&6Ascent&r ต้องการอุปกรณ์ที่แกร่งกว่าและคู่ต่อสู้ที่แกร่งกว่า", "", "สวมใส่ Affix Gear ระดับ &aUncommon&r ครบชุด:", "", "&aUncommon Helmet", "&aUncommon Chestplate", "&aUncommon Leggings", "&aUncommon Boots", "&aUncommon Weapon", "", "จากนั้นเอาชนะ &cApothic Invader&r", "", "ทำทั้งสองเงื่อนไขให้สำเร็จเพื่อไปถึง &6Ascent&r"]
	quest.38E5EBCA2079EF22.quest_subtitle: "Frontier เป็นเพียงจุดเริ่มต้น"
	quest.38E5EBCA2079EF22.title: "&6Ascent (The Ascent)"
	quest.38EF4E7FE82B62A6.quest_subtitle: "ห้ามมาสาย ห้ามมาสาย สำหรับนัดสำคัญยิ่ง"
	quest.38F4C0DE98642F73.title: "unlocks/blocks/item_bowl"
	quest.390323A83EB8009A.quest_desc: ["การผลิตพลังงานเป็นแค่ครึ่งหนึ่งของศึก คุณยังต้องมีวิธี &eเก็บ&r และ &bขนส่ง&r ไปยังที่ที่ต้องการด้วย", "", "- &aEnergy Cables&r ส่ง &eFE&r ระหว่างเครื่องกำเนิดไฟฟ้า เครื่องจักร และบล็อกเก็บพลังงานของคุณ", "", "- &6Batteries&r ทำหน้าที่เป็นที่พักพลังงานแบบพกพา เก็บพลังงานไว้ใช้ภายหลังหรือขนย้าย", "", "- &9Energy Cells&r เป็นบล็อกเก็บพลังงานแบบอยู่กับที่ขนาดใหญ่กว่า เหมาะกับการสะสมพลังงานสำรองและปรับสมดุลเครือข่ายพลังงานของคุณ"]
	quest.390323A83EB8009A.title: "ที่เก็บพลังงานและสายเคเบิล (Storage and Cables)"
	quest.3905B99EE45AC7F7.title: "unlocks/blocks/liquid_crystal"
	quest.392EC503FD52E32A.quest_desc: ["มี &bSulfur&r หลายชนิด แบ่งตาม &6ระดับ&r มากมาย"]
	quest.392EC503FD52E32A.title: "Sulfurs"
	quest.393142F9DD021AE3.title: "triggers/hints/nightdew_sprout_page1"
	quest.3945E1CF1BB1D8A9.title: "unlocks/blocks/cinderhearth"
	quest.39460CB77E53D5FA.quest_desc: ["  &6ให้&r &bบล็อก&r อื่น &6โต้ตอบ&r กับ &3ช่องเก็บของ&r &3ช่องเกราะ&r หรือ &3ช่องมือรอง&r ของคุณ", "", "{image:justdirethings:block/playeraccessor width:100 height:100 align:center}"]
	quest.395B8FCF5B13E245.title: "unlocks/equipment/razor_falchion"
	quest.39716053AAD8ABF2.quest_desc: ["ทุกอย่างต้องมีจุดเริ่มต้น และสิ่งนี้ช่วยให้คุณ &6ใช้แรงมือ&r ขับเคลื่อนสิ่งประดิษฐ์เชิงกลชิ้นแรกของคุณ หรือกระตุ้นเครื่องยนต์หม้อไอน้ำที่สูบตัวเองให้เริ่มทำงาน"]
	quest.3971C52500C72F92.quest_desc: ["ทำให้ &bTemporary Rune&r &6ถาวร&8", "&8(temporary rune จาก &5Rune glyph&8)", "", "หรืออีกทางคือสร้าง &bBlank Rune&r ที่ตั้งค่าด้วย &bSpell Parchment&r ได้", "", "", "&4หมายเหตุ&r: rune ต้องใช้ &5source&r ในการทำงาน"]
	quest.3973F425BD96668A.quest_desc: ["คุณควรคราฟต์ &bPattern Encoding Terminal&r เพื่อเข้ารหัส pattern ของสูตรคราฟต์สำหรับระบบ autocrafting ของคุณ", "", "&bPattern Access Terminal &fเป็นอีกรุ่นอัปเกรดของ &bTerminal&f Terminal นี้ช่วยให้คุณสร้าง &bPattern&f ของไอเทมที่ต้องการให้ระบบคราฟต์"]
	quest.3973F425BD96668A.title: "Pattern Encoding Terminal"
	quest.398180C630A384CA.quest_desc: ["&bEnchanter's Tools&r ใส่ &dSpells&r ได้ที่ &bScribe's Table&r", "", "- &bEnchanter's Bow&r: ความเสียหาย (เอนชานต์ &6Endless Quiver&r)", "", "- &bEnchanter's Crossbow&r: เหมาะกับการขุด (จับคู่กับ &bSplit arrow&r)"]
	quest.3995CC829C7B015A.quest_desc: ["&6คราฟต์&r จาก &dMagebloom&r", "&bFiber&r ใช้สำหรับ:", "- &bThreads&r", "- &bParchments", "- &bArmor&r", "- แลกเปลี่ยนกับชาวบ้าน (&2Shady Wizard&r)"]
	quest.39A4FF688D140EC2.quest_desc: ["&bLogistical Sorter&r เป็นสมองของเครือข่าย &eขนส่งไอเทม&r ของคุณ ให้คุณควบคุมได้ว่าไอเทมไปที่ไหน", "", "ตั้ง &6ตัวกรอง&r ให้ตรงกับไอเทมเฉพาะ tag หรือทรัพยากรทั้งหมวด ไอเทมที่ผ่านตัวกรองส่งไปยังปลายทางที่เลือกในเครือข่ายได้", "", "ใช้ &bDictionary&r ค้นหา tag ของไอเทมและบล็อกที่มีอยู่ ทำให้สร้างตัวกรองแบบกว้างหรือเฉพาะเจาะจงได้ง่ายขึ้นมาก", "", "ใช้ Sorters ร่วมกับ &bRestrictive&r และ &dDiversion Transporters&r เพื่อสร้างระบบส่งไอเทมอัตโนมัติที่เชื่อถือได้ทั่วโรงงานของคุณ"]
	quest.39A4FF688D140EC2.quest_subtitle: "จัดเรียงไอเทมอย่างแม่นยำ"
	quest.39A4FF688D140EC2.title: "Logistical Sorter"
	quest.39A9548E3A6B3BEE.title: "unlocks/colored_lamps/brown_lamp"
	quest.39B3E48AC11BF987.title: "unlocks/enchantments/inertia"
	quest.39CCD71B54271A98.title: "hidden/collect_stratine_gem"
	quest.39CF27CAC4EE33DB.quest_desc: ["- กด &6คลิกขวา&r ที่ &9น้ำนิ่ง&r หรือ &9น้ำไหล&r เพื่อเติม", "", "- ใส่ &8เชื้อเพลิง&r ลงใน &bChainsaw&r ด้วย &6คลิกขวา&r", "", "- สลับ &eSilk Touch&r ด้วย &6Left Shift&r + &6คลิกขวา&r"]
	quest.39CF27CAC4EE33DB.quest_subtitle: "บรื๋นนน!"
	quest.39D1D3B9E360628E.title: "unlocks/items/pipe_bomb"
	quest.39FCE3168C26B863.quest_desc: ["  เมื่อคุณมี &bSuper Powered Coal&r สะสมไว้แล้ว คุณก็เริ่มเลิกใช้เครื่อง bronze ได้ มันช้าและสีส้มสว่างจ้าจนแสบตา", "", "  การทำ &bCoal Coke&r คือการให้ความร้อนแก่ &bCoal&r โดยไม่มีออกซิเจน ทำให้ไม่ลุกไหม้ และผ่านกระบวนการกลั่นแบบทำลาย เมื่อได้มาแล้ว คุณจะเริ่มทำ &bSteel&r และเครื่อง steel ซึ่งเร่งเวลาแปรรูปได้ โดยแลกกับการใช้ไอน้ำมากขึ้น", "", "  &6คุณจะตั้งเป้าสร้าง &bQuarry&r ในไม่ช้า เพื่อให้มันขุดแทนคุณ&r ลองจินตนาการว่าไม่ต้องออกไปขุดแร่อีกเลย!"]
	quest.39FCE3168C26B863.title: "Coke"
	quest.3A0731F61F9435F4.title: "unlocks/reagents/ash_flakes"
	quest.3A198A377F8B9B4E.title: "unlocks/reagents/neolith"
	quest.3A20D522302FE7B9.quest_desc: ["&bLogic Processor&f ใช้ตั้งแต่ช่วงเริ่มต้นเพื่อทำ drive และอัปเกรดชุดแรกของคุณ", "", "&bEngineering Processors &fใช้ทำ &bController &fและส่วนประกอบอื่นเพื่อสร้าง &bME system &fแรกของคุณ", "", "&bCalculation Processors &fใช้ใน &bStorage Components&f และอย่างอื่นอีกบางอย่าง"]
	quest.3A20D522302FE7B9.title: "Basic Processors"
	quest.3A23D98042990591.title: "Chemical Infuser for Sulfur Trioxide"
	quest.3A330803CC14920C.title: "unlocks/blocks/heartbound_chest"
	quest.3A3B3EACB9321FF3.quest_desc: ["สร้าง &bHellfire Forge&r และปลดล็อกวิธีใหม่ในการเปลี่ยน &bVitae&r เป็นพลัง", "", "ใช้ &bHellfire Forge&r เพื่อเริ่มสร้างอุปกรณ์และวัสดุที่ล้ำหน้ากว่า"]
	quest.3A3B3EACB9321FF3.quest_subtitle: "บางสิ่งตีขึ้นได้เฉพาะในไฟนรก"
	quest.3A3B3EACB9321FF3.title: "The Hellfire Forge"
	quest.3A41A00BEF324EF3.quest_desc: ["Shelves เป็นรากฐานของการตั้ง Apothic Enchanting แต่ละ shelf ให้ &2Eterna&f, &4Quanta&f และ &5Arcana&f ในสัดส่วนต่างกัน ทำให้คุณปรับแต่ง Enchanting Table ได้", "", "มีตำแหน่งชั้นหนังสือที่ใช้ได้ &e32&r ตำแหน่งรอบ &bApothic Enchanting Table&f ", "", "Shelves ต้องมี &7บล็อกอากาศ&r ระหว่าง shelf กับโต๊ะ จึงจะให้ค่าสถานะ", "", "&2Eterna&r กำหนดระดับเอนชานต์ที่มีและความแรงของเอนชานต์ของคุณ", "", "&4Quanta&f เปลี่ยนกลุ่มเอนชานต์ เพิ่มความหลากหลายของเอนชานต์ที่มี แต่ Quanta มากเกินไปก็ทำให้เอนชานต์ที่อ่อนกว่าออกง่ายขึ้นได้เช่นกัน", "", "&5Arcana&r มีผลต่อความหายากและคุณภาพของเอนชานต์ที่คุณได้", "", "แต่ละ shelf มี &2เพดาน Eterna&f ของตัวเอง เมื่อถึงขีดจำกัดนั้น Eterna ที่เพิ่มจาก shelf นั้นจะถูกละเลย", "", "&aเคล็ดลับ:&r ลองผสม shelf หลายแบบเพื่อหาสมดุลที่ลงตัวของ Eterna, Quanta และ Arcana สำหรับการตั้งเอนชานต์ของคุณ"]
	quest.3A41A00BEF324EF3.quest_subtitle: "สร้างชุดเอนชานต์ของคุณ"
	quest.3A41A00BEF324EF3.title: "ชั้นหนังสือ (Bookshelves)"
	quest.3A5A59C7AEA670C7.quest_desc: ["&bAviar's Circle&r เป็น pentacle แรกที่คุณจะเตรียม ใช้ &6เรียก Foliot&r ดู &bDictionary of Spirits&r เพื่อดูวิธีวาง"]
	quest.3A5A59C7AEA670C7.quest_subtitle: "พิธีกรรมแรก"
	quest.3A5A59C7AEA670C7.title: "Aviar's Circle"
	quest.3A6C29AD180C3759.title: "unlocks/enchantments/vanilla_silk_touch"
	quest.3A9E623CFF593B6F.title: "triggers/hints/ruin_page0"
	quest.3AA35EECF572C3BC.title: "unlocks/blocks/cinderhearth"
	quest.3AA43F4E91E31E82.title: "Yucca Fruit"
	quest.3AAA390CA130181F.title: "unlocks/reagents/stardust"
	quest.3AAE23B6BE07E5DC.quest_desc: ["ใช้ Scroll Forge และ Divine Pearl คราฟต์ Holy Scrolls ซึ่งเหมาะกับการรักษาและเอฟเฟกต์"]
	quest.3AE00D06232E0175.quest_desc: ["  &bThe Portal Gun&r:", "    • คลิกซ้าย/ขวา &6เปิด&r &5portal&r เป็นคู่", "", "  &bThe Advanced Portal Gun&r:", "    • &6เปิด&r &5portal&r ไปยัง &9ตำแหน่ง&r ที่บันทึกไว้", "    • &6ใช้&r &cพลังงาน&r และ &bportal fluid&r", "", "", "{image:justdirethings:block/portal_shader width:100 height:100 align:center}"]
	quest.3AE00D06232E0175.quest_subtitle: "ไปดวงจันทร์!"
	quest.3AE1798E7291F41C.title: "unlocks/glowblocks/light_blue_glowblock"
	quest.3AE3329F99AE9389.title: "unlocks/glowblocks/green_glowblock"
	quest.3AE8C5BC19EBF64A.title: "triggers/hints/resonance_shards_page1"
	quest.3B0AB80C9FAD48F2.quest_desc: ["&bAntiprotonic Nucleosynthesizer&r ใช้ &dAntimatter&r เปลี่ยนโครงสร้างโมเลกุลของวัสดุบางชนิดอย่างถึงรากถึงโคน", "", "ป้อนส่วนผสมที่ถูกต้อง แล้วมันจะแปลงให้เป็นรุ่นที่ &6ทรงพลังกว่า&r ปลดล็อกวัสดุและอัปเกรดที่แกร่งที่สุดบางอย่าง"]
	quest.3B0AB80C9FAD48F2.quest_subtitle: "พลังของแอนติแมทเทอร์"
	quest.3B0AB80C9FAD48F2.title: "Antiprotonic Nucleosynthesizer"
	quest.3B117FA99DD7558F.quest_desc: ["คุณอาจอยากทำให้การผลิตสิ่งนี้ &6เป็นอัตโนมัติ&r"]
	quest.3B117FA99DD7558F.title: "Solvent"
	quest.3B2A3B2085D6CC60.title: "unlocks/food/myceylon_liquor"
	quest.3B323F6CD92884C3.title: "unlocks/upgrades/upgrade_experience2"
	quest.3B3A9A8C40291D24.title: "unlocks/potions/strong_sleep_effects"
	quest.3B3FDF02E891DD39.quest_desc: ["Apprentice Spellbook เป็นหนังสือที่ดีกว่า ต้องเดินทางไป Nether"]
	quest.3B6674B3B91BD8B4.quest_desc: ["&bMechanical Belts&r ทำถูก จำเป็นสำหรับกลไกช่วงต้น (และยังมีประโยชน์กับกลไกความเร็วสูง) และย้อมสีได้ด้วย", "", "ส่วนที่เรียกหลวม ๆ ว่า &c\"Transportation\"&r มีชิ้นส่วนมากมายสำหรับเคลื่อนย้ายและเก็บไอเทมในกลไกของคุณ รองรับการเคลื่อนที่ได้หลายแบบ และแม้แต่วิธีผลิตพลังงานหมุนเวียนจากบรรยากาศเอง!"]
	quest.3B6674B3B91BD8B4.quest_subtitle: "คาดเข็มขัดไว้ เราจะออกเดินทางกัน!"
	quest.3B794A7C9A822632.title: "triggers/hints/quitoxic_reeds_page1"
	quest.3B7D0C01193B6FB3.quest_desc: ["คราฟต์ &bRunes&r ชุดแรกของคุณ และเริ่มปรับความเร็ว ความจุ และประสิทธิภาพของ &bAra Vitae&r"]
	quest.3B7D0C01193B6FB3.quest_subtitle: "กำหนดการไหลของ vitae ตามใจคุณ"
	quest.3B7D0C01193B6FB3.title: "Runes"
	quest.3B82F8F19AF630D5.quest_desc: ["&bToggle Bus &fเหมือน &bGlass Cable&f แต่ใช้ &6ปิดชั่วคราว&f ส่วนของระบบปลายทางเมื่อไม่มีพลังงาน &6การจ่ายพลังงาน&f ให้มันจะทำให้ข้อมูลและพลังงานผ่านได้อีกครั้ง"]
	quest.3B82F8F19AF630D5.title: "Toggle Bus"
	quest.3B875C6E2FFCE86E.title: "unlocks/blocks/color_picker"
	quest.3BAA7EC7653A7905.quest_desc: ["&bChemical Injection Chamber&r รับ &9แร่&r และ &craw ores&r มาประมวลผลกับ &7Hydrogen Chloride&r ให้เป็น &eshards&r หลายชิ้น เป็นก้าวแรกสู่ &aการแปรรูปแร่ 400%&r", "", "ยังมีการใช้งานที่เป็นประโยชน์อีกมาก ใช้ &7ออกซิเจน&r &coxidize&r วัสดุทองแดงบางชนิด เปลี่ยนไอน้ำเป็นคอนกรีตแข็ง ย้อนการเผาดินเหนียว และแม้แต่เติมน้ำให้ปะการังที่ตายแล้ว"]
	quest.3BAA7EC7653A7905.quest_subtitle: "ประตูสู่การแปรรูปแร่สี่เท่า"
	quest.3BAA7EC7653A7905.title: "Chemical Injection Chamber"
	quest.3BAFFE6DA1F9BFDF.title: "Chemical Injection for Sulfur"
	quest.3BCE19FF877E724E.title: "unlocks/blocks/particle_spawner"
	quest.3BDEC456E9E80548.quest_desc: ["&britual&r ที่น่าสนใจบางอัน:", "", "- &bTablet of Awakening&r", "&8+ Amethyst golem ดี", "&8+ Bookwyrm สำหรับ storage lectern", "&8+ Weald Walker ไม่ได้แข็งแกร่งมาก", "", "- &bTablet of Conjure Island: Plains&r", "&8+ เปลี่ยน &9รัศมี &8รอบตัวมันให้เป็น &bไบโอมอื่น&8 (ไบโอมอะไร? ดูคำอธิบายของ tablet)", "&8+ บล็อกน้ำ/อากาศจะ &4ถูกแทนที่", "&8+ ต้องใช้ &5source &8ขณะทำงาน (เมื่อเสร็จแล้วไม่ต้องใช้อีก)"]
	quest.3BDEC456E9E80548.quest_subtitle: "เควสนี้สำหรับสายทำครบทุกอย่าง"
	quest.3BDEC456E9E80548.title: "แผ่นจารึกสีเขียว (Green Tablets)"
	quest.3BF97D7E831330C3.title: "unlocks/pylons/citrine_pylon"
	quest.3C030EEDD604F040.title: "unlocks/blocks/ominous_sapling"
	quest.3C1D103FCEF249C8.quest_desc: ["การเดินทางไม่จบเมื่อคุณมาถึงปลายทาง", "", "เหนือกว่าความก้าวหน้าตามปกติมี &5endgame แบบกำหนดเอง&r ที่สร้างมาเพื่อทดสอบขีดจำกัดของคุณโดยเฉพาะ", "", "&bเครื่องจักรทรงพลัง&r &dสูตรเฉพาะตัว&r &6วัสดุแบบกำหนดเอง&r และ &cบอสอันตราย&r รอผู้ที่พร้อมจะก้าวไปไกลกว่า", "", "ความท้าทายบางอย่างต้องการมากกว่าอุปกรณ์ดี คุณต้องเชี่ยวชาญเครื่องจักร ปรับแต่งอุปกรณ์ และใช้ทุกสิ่งที่เรียนรู้มาตลอดทาง", "", "และเมื่อคุณคิดว่าถึงจุดสูงสุดแล้ว...", "", "&5อาจมีสิ่งที่แกร่งกว่านั้นรออยู่&r", "", "จุดสิ้นสุดไม่ใช่จุดหมายปลายทาง", "", "&6มันเป็นเพียงจุดเริ่มต้นของความท้าทายที่แท้จริง&r"]
	quest.3C1D103FCEF249C8.quest_subtitle: "ความท้าทายที่แท้จริงเริ่มต้นที่นี่"
	quest.3C1D103FCEF249C8.title: "&dเหนือกว่า End (Beyond the End)"
	quest.3C2B6ABA8420BF3B.title: "Mangos"
	quest.3C3519AFEBBAEC70.quest_desc: ["  &bPistons&r ใช้แรงหมุนดันแกนยื่นออกไปด้วยแรงมหาศาลที่เป็นไปได้", "", "  มีประโยชน์มากสำหรับการอัดและบรรจุสิ่งของ &6คุณควรทำให้สิ่งเหล่านี้เป็นอัตโนมัติ&r"]
	quest.3C3519AFEBBAEC70.quest_subtitle: "หมัดโลหะ"
	quest.3C3519AFEBBAEC70.title: "Pistons"
	quest.3C5915D24087ED3D.quest_desc: ["&6Summit&r ต้องการอุปกรณ์ที่ดียิ่งกว่า", "", "สวมใส่ Affix Gear ระดับ &9Rare&r ครบชุด:", "", "&9Rare Helmet", "&9Rare Chestplate", "&9Rare Leggings", "&9Rare Boots", "&9Rare Weapon", "", "จากนั้นเอาชนะ &cWither&r", "", "ทำทั้งสองเงื่อนไขให้สำเร็จเพื่อไปถึง &6Summit&r"]
	quest.3C5915D24087ED3D.quest_subtitle: "มีเพียงผู้แกร่งที่สุดที่ถึงยอด"
	quest.3C5915D24087ED3D.title: "&4Summit (The Summit)"
	quest.3C6E442CEB73191F.quest_desc: ["&bGas-Burning Generator&r ใช้ &cก๊าซติดไฟ&r ได้หลากหลายเพื่อผลิต &eไฟฟ้า&r ", "", "ก๊าซอย่าง &7Hydrogen&r และ &dEthene&r ให้ &eพลังงาน&r ปริมาณมากได้ดีในช่วงแรก ", "", "ดู &dEMI&r ของคุณเพื่อดูว่า &7ก๊าซ&r ชนิดใด &cติดไฟ&r จริง ๆ และผลิต &6พลังงาน&r ได้เท่าไร"]
	quest.3C6E442CEB73191F.quest_subtitle: "เผาก๊าซเพื่อพลังงานมหาศาล"
	quest.3C6E442CEB73191F.title: "Gas-Burning Generator"
	quest.3C8F9874DDBA816C.title: "unlocks/trinkets/fanciful_bismuth_ring"
	quest.3CB18198977D7E8E.title: "unlocks/blocks/egg_laying_wooly_pig_head"
	quest.3CF03758A5C98E5B.quest_desc: ["ธนูนี้จะเพิ่ม &5Projectile glyph&r ที่จุดเริ่มต้น คุณจึงไม่ต้องใส่ &5Form glyph&r ใน spell", "", "- ลูกธนู: &bAugment Arrow: Amplify&r", "- Spell:", "&8Harm -> Amplify -> Amplify", "", "- ภายหลังคุณเพิ่ม &5Wither&r และ &5Hex&r ได้", "", "", "&8ดู &bหน้า 2 &8สำหรับคำอธิบาย", "", "{@pagebreak}", "- รวมแล้วมี &5Amplify&r 4 อัน ทำให้ได้ความเสียหายเพิ่ม &95 + 2 * 4 = 13&r หากคำนวณไม่ผิด", "- เมื่อใช้ &6เอนชานต์ Power IX&r ฉันทำความเสียหายเฉลี่ย &945->60&r ต่อการยิงหนึ่งครั้งใส่ &2Iron Golem&r"]
	quest.3CF03758A5C98E5B.quest_subtitle: "ตัวอย่าง Spell"
	quest.3CF03758A5C98E5B.title: "Enchanter's Bow"
	quest.3CF9D4689B08C130.title: "hidden/collect_pigment/purple"
