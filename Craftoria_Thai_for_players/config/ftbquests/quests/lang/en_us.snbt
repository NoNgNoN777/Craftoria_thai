	quest.088E87F861406342.quest_desc: ["ใช้&6เติม&rคูน้ำ &6ระบาย&rหนองน้ำ หรือ&6สูบ&r&9น้ำ&rและ&blava&rได้ไม่จำกัด"]
	quest.0897CCAC72E82C5.quest_desc: ["Powah! คือเรื่องของการผลิต เก็บ และส่งต่อพลังงาน", "&8*แต่ไม่รวม Modern Industrialization"]
	quest.0897CCAC72E82C5.quest_subtitle: "ต้องการ POWAH! เพิ่มใช่ไหมล่ะ"
	quest.0897CCAC72E82C5.title: "&4ยินดีต้อนรับสู่ Powah!!! (Welcome to Powah!!!)"
	quest.0897CCAC72E82C5B.quest_desc: [
		"&oPowah! is all about generating, storing, and transferring power"
		"&8*But not for Modern Industrialization"
	]
	quest.0897CCAC72E82C5B.quest_subtitle: "Need MOAR POWAH!, do you?"
	quest.0897CCAC72E82C5B.title: "&4Welcome to Powah!!!"
	quest.08A2F489A73BE55B.quest_desc: ["The &bUltimate Enriching Factory&r can process up to &a9&r recipes at the same time, containing the same \"&eAuto-Sort&r\" function."]
	quest.08A2F489A73BE55B.title: "Ultimate Enriching Factory"
	quest.08B17C05B2111477.quest_desc: ["  ยินดีด้วย", "", "  ตอนนี้คุณ&6ปลดล็อก&rระดับที่สี่&rและระดับสุดท้าย&rของ&bไอเทม&rและ&bบล็อก&rของ JDT&r แล้ว", "", "  &bเครื่องมือ&r&6ทำงานทันที&r &bเกราะ&rมอบ&6พลังแบบ&rซูเปอร์แมน&r และ &bไม้กายสิทธิ์&r&6เจาะรูชั่วคราว&rในโลกได้", "", "  ใครเห็นคุณในชุด JDT&r ระดับสูงสุดจะรู้ว่าคุณผ่านมาหมดแล้ว... &2Overworld&r, &4The Nether&r, &3The End&r และ &9Deep Dark&r", "", "{image:justdirethings:item/eclipsealloy_ingot width:100 height:100 align:center fit:true}"]
	quest.08B17C05B2111477.quest_subtitle: "ระดับ 4: ปลดล็อกแล้ว"
	quest.08BE35FB8E58C4B5.quest_desc: [
		"The &bBasic Sawing Factory&r can process up to &a3&r sawing processs at once. "
		""
		"There is a button on the left called \"&eAuto-Sort&r\" that allows the machine to automatically split the inputs between the &a3&r input slots."
	]
	quest.08BE35FB8E58C4B5.title: "Basic Sawing Factory"
	quest.08C3213E848BFD0C.quest_desc: ["&bOverdrive Module&f จะ&6ป้องกัน&fไม่ให้ประสิทธิภาพของ&bเครื่องจักรไฟฟ้า&fลดลง แต่&6บังคับ&fให้เครื่องใช้&cพลังงานเต็มที่&fตลอดเวลา แม้ไม่ได้&6ประมวลผล&fอะไรอยู่", "", "ประสิทธิภาพจะ&rรีเซ็ตเมื่อสูตรที่เครื่อง&6กำลังประมวลผล&fเปลี่ยนไป"]
	quest.08DD0CB24FD0B193.quest_desc: ["- &6หมุน&rชิ้นส่วนได้อย่างแม่นยำ", "", "- &6เปิด&rและ&6ปิด&r &bFluid Valves&r", "", "- &6ย้อมสีได้&r"]
	quest.08DD0CB24FD0B193.quest_subtitle: "แต่ใส่ไว้ด้านหลังหัวได้ไหมล่ะ"
	quest.0910D85DD68AFD64.quest_desc: ["ขนส่งไอเทมและโพชัน", "เก็บเกี่ยว Sourceberry", "", "- เรียก: &6คลิกขวา&r ที่บล็อก", "", "- ใช้ Starbuncle: ใช้ &bDominion Wand&r ตั้งต้นทางและปลายทางของ Starbuncle", "", "- ตั้งให้พักบน &bMagebloom Bed&r ได้ด้วย &bDominion Wand&r", "", "- ต้องใช้ Source: ไม่"]
	quest.0910D85DD68AFD64.quest_subtitle: "การขนส่งไอเทมและโพชัน"
	quest.091830A5A267BF62.title: "unlocks/ampoules/raw_bloodstone_ampoule"
	quest.091C2772ED417247.quest_desc: ["  เมื่อคุณผลิตพลังงานใน&6ระดับแรงดันปานกลาง&rแล้ว ต้องทำให้เครื่องจักรรับพลังงานใหม่นี้ได้", "", "  โดยปกติ &6สายเคเบิลจะไม่เชื่อมต่อกับเครื่องจักรที่ระดับไม่ตรงกัน&r แต่เมื่อใส่ &bAdvanced Machine Hull&r (หรือสูงกว่า) ลงในช่องมุมขวาบนของเครื่อง เครื่องจะอัปเกรดเป็นระดับพลังงานที่ Hull นั้นรองรับ", "", "  โดยค่าเริ่มต้น เครื่องจักรไฟฟ้าอยู่ที่ระดับ &bBasic Machine Hull&r อยู่แล้ว ไม่ต้องใส่ &bBasic Machine Hull&r ลงในช่อง ผมจะบอกว่า Hull ไหนสำหรับระดับพลังงานใด", "", "  &6ตรวจดูให้ดีว่าเครื่องไหน ต้องการ&r&6 อัปเกรดจริง ๆ&r จะได้ไม่เปลืองทรัพยากรกับเครื่องที่ ไม่ต้องการการเพิ่มกำลังขนาดนั้น"]
	quest.091C2772ED417247.title: "อัปเกรด Hull (Hull Upgrades)"
	quest.091F017C206F6250.title: "unlocks/food/freigeist"
	quest.0931F12CD1767D8A.title: "unlocks/blocks/pure_pastel_network"
	quest.09336DBAFB15EF52.quest_desc: ["The &bAdvanced Mechanical Pipe&r has a per-pipe capacity of &98,000mb&r and a per-\"&apull&r\" pipe flow rate of &91,000mb/t&r."]
	quest.09336DBAFB15EF52.title: "Advanced Mechanical Pipe"
	quest.0935BFDC4F0B4C6C.quest_desc: ["ถึงเวลาขยาย Ara Vitae ของคุณ", "", "เพิ่มวงที่สองของ &d16 Runes&f ต่ำกว่าและไกลออกไปกว่าวงแรกหนึ่งระดับ", "", "ตำแหน่งใหม่ให้พื้นที่สำหรับ &dSpecialized Runes&f มากขึ้น ปรับแต่งแท่นบูชาได้ละเอียดขึ้น", "", "สร้างเสาทั้งสี่ให้เสร็จ แล้วครอบด้วย &dBlood Stained Glass&f", "", "ตอนนี้แท่นบูชาของคุณมี &d24 Runes&f"]
