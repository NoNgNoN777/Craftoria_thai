	quest.2AABAC42E7880AA1.quest_desc: [
		"The &bElite Pressurized Tube&r will add &9256,000mb/t per tube&r to the tube network's total capacity and base throughput. "
		""
		"Each \"&apull&r\" tube is limited to &964,000mb/t&r."
	]
	quest.2AABAC42E7880AA1.title: "Elite Pressurized Tube"
	quest.2AB012D0C1DCD827.quest_desc: ["&eAbsolute Control Circuit&r ดันวงจรของ &bMekanism&r ให้เกินระดับ &6Ultimate&r", "", "คราฟต์โดยรวม &6Ultimate Control Circuit&r เข้ากับ &eRadiant Alloy&r วงจรเหล่านี้เป็นรากฐานของ &5เครื่องจักรช่วงท้ายเกม&r รุ่นถัดไป", "", "ระดับ &eAbsolute&r ปลดล็อกโรงงาน ระบบพลังงาน ที่เก็บของ ที่ทรงพลัง และท้ายที่สุดคือ &cSupreme Control Circuit&r", "", "&6ใกล้ขีดจำกัดสูงสุดอีกก้าวหนึ่ง&r"]
	quest.2AB012D0C1DCD827.quest_subtitle: "ความแม่นยำสัมบูรณ์"
	quest.2AB5183A0BD8D387.quest_desc: ["ใช้คูณความเร็วคราฟต์ของคุณโดยไม่เปลืองพื้นที่", "", "รองรับ co-processor ได้สูงสุด 1024 ตัว"]
	quest.2AB5183A0BD8D387.title: "Multi Core Crafting Accelerator"
	quest.2ABCACEBACE7A37D.title: "Menril Berries"
	quest.2AC6E9EFC6D1D83D.title: "unlocks/items/phantom_frames"
	quest.2ACF8F5EFD3C4AF7.title: "รองเท้าบูท (Boots)"
	quest.2ADDD30536A7FF68.quest_desc: ["&bReactor Glass&r ใช้เป็นช่องมองของ &dFusion Reactor&r ให้คุณเห็นปฏิกิริยาที่เกิดขึ้นภายใน", "", "ต่างจากกระจกทั่วไป เพราะสร้างมาทนสภาวะสุดขั้วของปฏิกิริยาฟิวชัน", "", "ใส่ไว้ที่ผนังเครื่องปฏิกรณ์เพื่อมองเห็น &dFusion Power&r อันงดงามได้ชัดเจน", "", "แต่อย่ายืนใกล้เกินไป หากมีอะไรผิดพลาด"]
	quest.2ADDD30536A7FF68.quest_subtitle: "มองเห็นพลังภายใน"
	quest.2AF493802C789D70.title: "unlocks/ampoules/pure_malachite_ampoule"
	quest.2B0E19B0B1A65682.title: "unlocks/enchantments/vanilla_trial_treasure"
	quest.2B1717F5D6E20B79.quest_desc: ["  ด้วย &bElectrolyzer&r เวลาและพลังงานที่เพียงพอ และ &bSingularity&r ที่เพิ่งทำเสร็จ คุณสกัดพลังงานจำนวนมากผ่าน &bQuantum Hawking Radiation&r ในรูปของ &bUniversally Usable Matter&r หรือที่เรียกสั้น ๆ ว่า &dUU Matter&r ได้", "", "  นี่คือ โครงสร้างพื้นฐาน&r ของ &9จักรวาล&r เลยทีเดียว"]
	quest.2B1717F5D6E20B79.title: "UU Matter Bucket"
