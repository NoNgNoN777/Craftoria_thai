	quest.532B62BAB3868EB6.title: "unlocks/ampoules/pure_bloodstone_ampoule"
	quest.53380D2995E2E100.title: "unlocks/food/demon_tea"
	quest.534B63750942C433.quest_desc: ["ก้าวแรกของคุณสู่วงจรของ &6Mekanism&r คือ &bBasic Control Circuit&r", "", "ชิ้นส่วนกะทัดรัดเหล่านี้ทำจากการ &cใส่ &3Osmium&r เข้ากับ &credstone&r และเป็นรากฐานของเครื่องจักรและชิ้นส่วน Mekanism จำนวนมาก", "", "คุณจะใช้ &bControl Circuits&r ตลอดการเล่น โดยระดับที่ล้ำหน้ากว่าจะปลดล็อกเมื่อคุณเข้าสู่ Mekanism ลึกขึ้น", "", "ทำไว้เยอะ ๆ คุณต้องใช้แน่"]
	quest.534B63750942C433.quest_subtitle: "สมองเบื้องหลังเครื่องจักรของคุณ"
	quest.534B63750942C433.title: "Basic Control Circuit"
	quest.53500C0963F0A78A.title: "unlocks/food/nectardew_titration"
	quest.5358F626FAFBEDD3.quest_desc: ["Chimera จะ &6เติบโต&r เมื่อ &6ได้รับอาหาร&r ทำให้แข็งแกร่งขึ้น และเมื่อโตพอ คุณ &6ขี่&r มันได้"]
