	quest.3EE88117F4F01D0A.title: "unlocks/resources/fertilizer"
	quest.3EFED58FAE46B366.quest_desc: ["&6ติดกาว&r บล็อกเข้าด้วยกันเป็น contraption ขนาดเท่าไรก็ได้ ไม่ว่าเล็กหรือใหญ่"]
	quest.3F0097CCBA02804C.quest_desc: ["&bLarge Steam Furnace&r &6หลอม&r สูตรได้ครั้งละสูงสุด 8 ชิ้น โดยลดค่า &eEU&r ลง &a25%&r โปรดจำไว้ว่า &cจะไม่&r หลอมสูตรปนกัน สูตรทั้งหมด must&r ต้องเป็นประเภทเดียวกัน หากไม่ใช่ แต่ละประเภทจะถูก &6แยก&r เป็นชุดละสูงสุด 8 ชิ้น"]
	quest.3F0097CCBA02804C.quest_subtitle: "ยิ่งใหญ่ยิ่งดี"
	quest.3F0B58522B009779.quest_desc: ["ถือคู่ได้ (&6dual-wielded&r) และ &6เอนชานต์&r ได้", "", "&bอาหาร&r (กระสุน) แต่ละชนิดให้ &6เอฟเฟกต์&r ต่างกัน"]
	quest.3F0B58522B009779.quest_subtitle: "นักสู้สายอาหาร"
	quest.3F146A658E5A01F3.quest_subtitle: "ดรอปจากเกตเวย์ Trials of Awaken "
	quest.3F3600B6701641E0.quest_desc: ["&bAndesite Alloy&r คือกุญแจสู่การเริ่มต้นกับ Create และบล็อกในส่วน &c\"Mechanical Basics\"&r ของแกลเลอรีนี้ก็เช่นกัน", "", "  ตอน &6ขุด&r ช่วงต้นเกม เก็บ &bAndesite&r ให้มากที่สุด และอย่าลืมเก็บ &bZinc&r ด้วย เพื่อเก็บ &bIron&r ไว้ใช้อย่างอื่นแทนการ &6ทำ&r &bAndesite Alloy&r"]
	quest.3F3C9A6F590496AD.quest_desc: ["เปิด &6GUI&r เพื่อเพิ่ม hook, bobber และเหยื่อชนิดต่าง ๆ ด้วยการ &3กดย่อ&r + &3คลิกขวา&r"]
	quest.3F3C9A6F590496AD.quest_subtitle: "จับให้ครบทุกตัวได้ไหม"
	quest.3F581374C4DDD0A9.quest_desc: [
		"The &bUnbreakable Upgrade&f does what it says on the tin, your &bConstruction Stick&f will &6never&f break!"
		""
		"Use a &bSmithing Table&f to apply the upgrade to your stick, using a &5crying obsidian&f as the material."
	]
	quest.3F6174E82DDC48C3.quest_desc: ["&bEnergized Smelter&r คือ &6เตาหลอมใช้พลังงาน&r แบบเรียบง่าย ใช้ &6หลอม&r ไอเทมและบล็อกให้กลายเป็นของที่ &7สุก&r แล้ว", "", "เป็นเครื่องจักรคู่ใจสำหรับการหลอมที่เร็วและอัตโนมัติ โดยไม่ต้องพึ่งเตาหลอมธรรมดา"]
	quest.3F6174E82DDC48C3.quest_subtitle: "หลอมทางสู่ความก้าวหน้า"
	quest.3F6174E82DDC48C3.title: "Energized Smelter"
	quest.3F6730383CCC8BB0.quest_desc: ["อย่าถูกหลอก... หน้าตาอาจคล้าย &bcauldron&r ธรรมดา แต่ยืดหยุ่นพอจะทำงานร่วมกับ &bBelts&r, &bFluid Pipes&r, &bMechanical Mixers&r และ &bPresses&r — &6ช่วยให้&r สูตรจำนวนมากทำงานอัตโนมัติได้"]
	quest.3F6AE77956C0C242.title: "unlocks/blocks/colored_spore_blossoms"
	quest.3F7184426BDAB333.title: "mod_integration/the_bumblezone/lime_life"
	quest.3F72C49DDD72A5AD.quest_desc: ["&5Augmenting Table&r ช่วยให้คุณปรับปรุง Affix ทีละอัน", "", "ใช้ &5Sigils of Enhancement&r เพื่ออัปเกรด Affix หรือสุ่มใหม่", "", "ต่างจาก reforging ตรงที่คุณจัดการ Affix ที่ต้องการได้โดยไม่ต้องเปลี่ยนทั้งชุด", "", "ใช้ augmentation ปรับแต่งอุปกรณ์ชิ้นเด่นของคุณให้สมบูรณ์แบบ"]
	quest.3F72C49DDD72A5AD.quest_subtitle: "Affix ดีก็กลายเป็นยอดเยี่ยมได้"
	quest.3F72C49DDD72A5AD.title: "ทำ Affix ให้สมบูรณ์แบบ (Perfect the Affix)"
	quest.3F73EC8E087E2920.quest_desc: ["&bBurning Spawner Rune&f เพิ่มเอฟเฟกต์ไฟให้ม็อบที่เกิดจาก spawner", "", "ฟาร์มม็อบของคุณร้อนแรงขึ้นอีกมาก"]
	quest.3F73EC8E087E2920.quest_subtitle: "เร่งความร้อน"
	quest.3F73EC8E087E2920.title: "Burning Spawner Rune"
	quest.3F7F938A54C50396.title: "triggers/hints/stratine_page0"
	quest.3F8B9421E85C047D.title: "Water for Chemical Washing"
	quest.3FB60EC2EE4D0435.quest_desc: ["&bEnchanter's Tools&r ใส่ &dSpells&r ได้ที่ &bScribe's Table&r", "", "- &bEnchanter's Mirror&r:", "&8ใช้เวทกับผู้ใช้เอง เวทที่ร่ายด้วยกระจกนี้ &2ลดต้นทุน&r &8และได้ระยะเวลา &6เพิ่มเติม&r &8กับทุก glyph (ไม่ต้องใช้ &5Form&r &8เหมือนเครื่องมือ Enchanter ทั่วไป)"]
	quest.3FB60EC2EE4D0435.title: "Enchanter's Tools"
	quest.3FD0CB4DDB3EECC6.title: "unlocks/trinkets/cotton_cloud_boots"
	quest.3FF4126574E3A6BA.title: "unlocks/blocks/ethereal_platform"
	quest.400274581B9BD5FC.quest_desc: ["&bLaser Focus Matrix&r คือระบบจุดระเบิดของ &dFusion Reactor&r ของคุณ", "", "รวมลำแสงจาก &cLaser&r ทรงพลังเข้าสู่แกนเครื่องปฏิกรณ์โดยตรง ให้พลังงานที่จำเป็นเพื่อเริ่มปฏิกิริยาฟิวชัน", "", "เมื่อเครื่องปฏิกรณ์พร้อม ส่งพัลส์ &cLaser&r เข้าสู่ matrix แล้วชมปฏิกิริยาที่ก่อตัวขึ้น", "", "แต่ต้องแน่ใจว่าเครื่องปฏิกรณ์เตรียมพร้อมดีแล้วก่อนลั่นไก"]
	quest.400274581B9BD5FC.quest_subtitle: "จุดปฏิกิริยาฟิวชัน"
	quest.40148704F9175B05.quest_desc: ["ตั้งค่าปุ่มลัดให้เรียบร้อย แล้ว &rกด&r Shift ค้างบนชิ้น &bHelmet&r เพื่อดูว่าต้องกดปุ่มใดเพื่อเปิด &5Night Vision&r", "", "ทำเช่นเดียวกันกับ &bLeggings&r และ &bBoots&r สำหรับ &5Speed Boost&r และ &5Step Boost&r ตามลำดับ", "", "เกราะนี้ยัง &6ย้อมสี&r และ &6ตกแต่ง Trim&r ได้ด้วย"]
	quest.40148704F9175B05.quest_subtitle: "แฟชั่นไฮเทค"
	quest.40148704F9175B05.title: "&aNano Suit"
	quest.401B75742C353D9A.title: "hidden/collect_pyrite"
	quest.4025E09FD9ABE58F.title: "hidden/status_effects/scarred"
	quest.4047F3E2AD081915.quest_desc: ["&bNetwork Tool &fคือ &bWrench&f รุ่นอัปเกรดที่แสดง &6ข้อมูลวินิจฉัยเครือข่าย&f และเก็บ upgrade card ได้ &6คลิกขวา&f ที่ส่วนใดก็ได้ของ &bNetwork&f เพื่อดูข้อมูลวินิจฉัยเหมือนที่ &bME Controller&f แสดง และยังทำให้ &bFacades&f โปร่งใสชั่วคราวเพื่อให้หาสายเคเบิลที่ซ่อนอยู่เจอ"]
	quest.4047F3E2AD081915.title: "Network Tool"
	quest.404A9FFCA3DF600D.quest_desc: ["&6ควบคุม&r ด้วย &bredstone&r แบบง่าย ๆ เพื่อ &6กลับทิศ&r การหมุน", "", "สะดวกมากเมื่อสิ่งก่อสร้างของคุณต้องการ"]
	quest.404F3A50015BE777.title: "hidden/collect_all_crystal_flowers"
	quest.405E052547A0C08A.quest_desc: ["&bJar of Voiding&r จะ &4ทำลาย&r ไอเทมที่ถูกเก็บ และให้ &5source&r ตอบแทนบางส่วน ", "&8(พูดง่าย ๆ คือถังขยะที่ให้ source เมื่อลบไอเทม)", "", "- วิธีเพิ่ม/ลบไอเทม&r", "&8+ ถือ Jar ใน &6มือหลัก &8และไอเทมใน &6มือรอง &8แล้ว &6คลิกขวา", "&8+ อีกวิธีคือวาง Jar ใน Scribe Table แล้ว &6กดย่อ + คลิกขวา &8ด้วยไอเทมในมือหลัก", "", "- วิธีเปิดใช้งาน&r", "&6กดย่อ + คลิกขวา &8ขณะถือ Jar ใน &6มือหลัก&r&8", "", "", "&4หมายเหตุ&r: โดยค่าเริ่มต้น จะไม่ทำลายอะไรเลย"]
	quest.405E052547A0C08A.quest_subtitle: "ถังขยะสายขุด"
	quest.405E052547A0C08A.title: "Jar of Voiding"
	quest.406374097FE19234.title: "Tier 1, 1:1"
	quest.4063FFDD9EE18B72.title: "unlocks/blocks/black_hole_chest"
	quest.407D04C17AA78E09.quest_subtitle: "You might need these"
	quest.407D04C17AA78E09.title: "Capacitors"
	quest.407EDA3B964E0557.title: "hidden/status_effects/magic_annulation"
	quest.407FD46B5C5A1EC0.quest_desc: [
		"The &bStickiest Stick&f is the first iteration of a set of &9five&f Construction Sticks that allow you to build at quicker rates with more precision. This one can &6build&f with a max of &9three&f blocks in many different modes."
		""
		"&6Using&f the apostrophe keybind ('), you can open the &9options screen&f. Here you can do many things:"
		"- &bReplacement&f let's you decide if you want to &6replace&f certain blocks such as fluids, snow, and tallgrass."
		"- &bRestriction&f let's you decide where you want to &6extend&f the placed blocks. Click through them to see what you can do."
		"- &bMatching&f let's you decide if you want it to &6match&f to similar blocks (dirt/grass types), exact blocks, or any blocks."
		"- &bDirection&f let's you &6place&f blocks with the direction of either the &9target block&f or the &9player&f."
		"- &bRandom&f let's you &6randomize&f placed blocks from your hotbar."
		""
		"&6Check&f your keybinds under the category name: \"&bConstruction Sticks&f\" to set automatic keybinds to &btoggle direction&f, &brestriction&f, and &bupgrade&f. You can also &6configure&f keybinds for &bShowing Previous&f action and &bUndo Operation&f."
		""
		"When &6holding down&f the keybind for \"&bShow Previous&f\" it will &6highlight&f your last operation's blocks in &agreen&f. Pressing the \"&bUndo Operation&f\" keybind and &6right clicking&f will &6undo&f your last placement of blocks."
		""
		"Having blocks in your offhand will &6place&f those instead of the block you're looking at."
		"Having containers like &bshulker boxes&f, &bbundles&f, and many other containers can provide building blocks for the stick."
	]
	quest.407FD46B5C5A1EC0.title: "&eConstruction Sticks"
	quest.40856AE9772691AD.title: "unlocks/items/bottle_of_failing"
	quest.40915337B7E427F8.quest_desc: ["สายเคเบิลที่ส่งพลังงานได้พอสำหรับโรงงานทั้งหมดของคุณ &b10 เท่า&r ภายในสายเดียว นี่คือการส่งพลังงานที่ &bสุดยอด&r"]
	quest.40915337B7E427F8.quest_subtitle: "ฉันคือสายไฟเป็น ๆ"
	quest.40915337B7E427F8.title: "Superconductor Cable"
	quest.4092CFA0361AFC55.title: "unlocks/colored_saplings/green_sapling"
	quest.409DA55D79D4A813.title: "unlocks/items/radiance_staff"
	quest.40A46BA8FD198521.title: "unlocks/equipment/early_elytra"
	quest.40EB78C0AF30096E.quest_desc: ["&bMetallurgic Infuser&r เป็นหนึ่งในเครื่องจักรแรกที่คุณจะสร้าง และแนะนำกลไกที่สำคัญที่สุดอย่างหนึ่งของ Mekanism คือ &6infusion&r", "", "เครื่องนี้ผสาน &bโลหะ&r เข้ากับ &dinfuse type&r ต่าง ๆ เพื่อสร้างวัสดุขั้นสูงที่ใช้ตลอดการเล่น", "", "ทำความคุ้นเคยกับตัวเลือก &3configuration&r ของเครื่องตั้งแต่เนิ่น ๆ คุณกำหนดได้ว่าด้านใด &aรับอินพุต&r, &cส่งเอาต์พุต&r, &eรับพลังงาน&r หรือไม่ทำอะไรเลย สำหรับแต่ละประเภททรัพยากร", "", "แท็บ &3energy statistics&r แสดงข้อมูลที่มีประโยชน์เกี่ยวกับ &eการใช้พลังงาน&r ของเครื่อง ส่วนการตั้งค่า &6redstone control&r ให้คุณกำหนดว่าเครื่องตอบสนองต่อสัญญาณ redstone อย่างไร", "", "คุณจะพบแท็บ &btransport&r ซึ่งทำงานร่วมกับ &bLogistical Transporters&r เพื่อช่วย &6กรอง&r และ &aส่งไอเทมไปตามเส้นทาง&r โดยอัตโนมัติ", "", "เรียนรู้พื้นฐานเสียตั้งแต่ตอนนี้ เพราะเครื่องจักรเหล่านี้คือรากฐานของทุกสิ่งที่ตามมา"]
	quest.40EB78C0AF30096E.quest_subtitle: "เรียนรู้เครื่องจักรที่ทำให้ทุกอย่างเดินหน้า"
	quest.40EB78C0AF30096E.title: "&eพื้นฐาน (The Basics)"
	quest.40F5D86A88ACCFBD.title: "unlocks/gemstone_chimes/moonstone_chime"
	quest.40F96E2CB2772CB8.quest_desc: ["&bAmadron Tablets&r ให้คุณ &6สั่งซื้อ &bไอเทม&r และ &7ของเหลว&r ทำงานคล้าย &3การค้ากับ Villager&r แต่มีข้อดีเพิ่มคือจัดส่งโดย &bDrones&r — เจ๋งกว่าการต่อรองกับ &aVillagers&r มาก ", "", "การใช้ &bTablet&r ให้กำหนดตำแหน่ง &9รับของ&r และ &9ส่งของ&r ด้วยการ &6คลิกขวา&r ที่ &3inventory&r หรือ &bถัง&r ด้วย &bTablet&r"]
	quest.40FF154148BBAFF2.quest_subtitle: "โอ้โห แวววาว"
	quest.41111391C43D4FD3.title: "hidden/collect_glass_peach"
	quest.41183734EB2C28FF.quest_desc: ["&6เติม&r ของเหลวลงในภาชนะของเหลวของ vanilla และ &6ใส่&r &9ของเหลว&r ให้ &bไอเทม&r ในสูตรแบบลำดับขั้น"]
	quest.41183734EB2C28FF.quest_subtitle: "แมงมุมตัวจิ๋วไปไหนนะ"
	quest.41261F8928285052.title: "unlocks/redstone/item_detector"
	quest.413557ECF489FD2C.quest_subtitle: "พบในโครงสร้างหายากบนเกาะ End"
	quest.413557ECF489FD2C.title: "&5Obsidilith"
	quest.41479443408985D3.title: "hidden/collect_clover"
	quest.41487767B6713961.title: "unlocks/gemstone_lights/topaz"
	quest.41604B0C59094F5E.quest_desc: ["&bMekaSuit&r คือชุดเกราะโมดูลาร์ขั้นสุดยอดของ Mekanism ต่างจากเกราะทั่วไป ตรงที่ไม่มีค่าความทนทาน - ทำงานด้วย &eFE&r ล้วน ๆ", "", "แต่ละชิ้นปรับแต่งด้วย &dModules&r ได้ที่ &eModification Station&r โมดูลให้ได้ทุกอย่าง ตั้งแต่การบินและการเคลื่อนที่ที่ดีขึ้น ไปจนถึงการป้อนอาหารอัตโนมัติ การป้องกันรังสี และความสามารถป้องกันที่ทรงพลัง", "", "&bMekaSuit&r ทรงพลังอย่างเหลือเชื่อ เมื่ออัปเกรดเต็ม แต่ทุกความสามารถ ต้องแลกกับพลังงาน ชาร์จเกราะให้เต็มอยู่เสมอ เพื่อใช้ประโยชน์สูงสุด", "", "และอย่าลืม &bMeka-Tool&r! เครื่องมือโมดูลาร์สุดแกร่งนี้ รวมหน้าที่ของเครื่องมือหลายชิ้นไว้ในชิ้นเดียว มีโมดูลสำหรับ &6ขุดแร่เป็นเส้นแร่&r, &dSilk Touch&r, &cการต่อสู้&r, &aการขุดเจาะ&r, &eการแปรรูปแร่&r และอื่น ๆ", "", "ทั้งสองอย่างอัปเกรดที่ &eModification Station&r ให้คุณสร้างชุดที่ลงตัวที่สุดสำหรับสไตล์การเล่นของคุณ"]
	quest.41604B0C59094F5E.quest_subtitle: "กลายเป็นเครื่องจักร"
	quest.41604B0C59094F5E.title: "MekaSuit"
	quest.4184B4182CFEF694.quest_desc: ["เครื่องมือนี้ &6ปรับจูน&r (ด้วยการกดย่อ + คลิกขวา) ให้ตรงกับบล็อกบางชนิด เพื่อหาคู่ของมันใน Other Place บล็อกเหล่านี้ &6ต้องถูกเก็บเกี่ยวขณะอยู่ภายใต้ Third Eye&r บล็อกที่ค้นหาได้มีดังนี้:", "", "- &bAndesite&r ค้นหา &bOtherstone&r", "- &bOak Log&r ค้นหา &bOtherworld Wood&r", "- &bNetherrack&r ค้นหา &bIesnium Ore&r"]
	quest.4184B4182CFEF694.quest_subtitle: "จับสัญญาณได้แล้ว"
	quest.418659818AD0712B.quest_desc: ["&bBulk Storage Cells&f เก็บไอเทม 1 ชนิดได้ &aไม่จำกัด &fจำนวน"]
	quest.418CB5EC1FE8CB1A.quest_desc: ["ใช้ &bAra Vitae&r สร้าง &bNovicius Orb of Vitae&r ลูกแรกของคุณ"]
	quest.418CB5EC1FE8CB1A.quest_subtitle: "เลือดคือราคาที่ต้องจ่าย พลังคือรางวัล"
	quest.418CB5EC1FE8CB1A.title: "The First Sacrifice"
	quest.41986354B4227FFE.quest_desc: ["Affix Gear บางชิ้นมาพร้อม &bSockets&r ว่าง", "", "หากต้องการใส่ Gem ให้ใช้ &fSmithing Table&r", "", "วาง &dAffix Gear&r ในช่องซ้าย และ &bApothic Gem&r ในช่องขวา", "", "หากไอเทมมี socket ว่าง Gem จะถูกใส่ลงในอุปกรณ์ และโบนัสของมันจะมีผลทันที", "", "เลือก Gem ให้ดี - เอฟเฟกต์ของมันสร้างความแตกต่างต่อบิลด์ของคุณได้มาก"]
	quest.41986354B4227FFE.quest_subtitle: "Gem ของคุณต้องมีที่อยู่"
	quest.41A6A67501853BDF.title: "unlocks/items/pipe_bomb"
	quest.41BFB47E0B652609.title: "unlocks/food/gin"
	quest.41D1344A31FEA6DF.quest_desc: ["  &bKanthal Coils&r คือขดลวดแบบใหม่สำหรับ &bEBF&r ของคุณ &6รองรับการดึงพลังงานได้สูงขึ้น&r และสร้างความร้อนได้มากกว่าเดิม ระวังด้วย อย่าให้โดนลวก โอ๊ย!", "", "&bKanthal Coils&r จะ &bไม่&r ทำให้ &bEBF&r ร้อนขึ้นถึง &6อุณหภูมิที่สูงกว่า&r โดยอัตโนมัติ คอมพิวเตอร์ควบคุมมีความสามารถนี้อยู่แล้ว เพียงแต่คุณต้องปรับค่า เพื่อให้ใช้ประโยชน์จากการอัปเกรดได้เต็มที่", "", "  ในกรณีนี้ ระบบทำให้ง่ายแล้ว เข้าไปที่ &bcontroller GUI&r แล้วที่ &6มุมซ้ายบน&r คุณจะเห็นชุดลูกศร กดลูกศรที่ชี้ไปทางขวา การตั้งค่าจะเปลี่ยนจากระดับ &bCupronickel&r เป็นระดับ &bKanthal&r", "", "  ง่ายใช่ไหม"]
	quest.41D1344A31FEA6DF.title: "Kanthal Coils"
