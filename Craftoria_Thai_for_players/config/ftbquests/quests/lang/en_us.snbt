	quest.71A219DF9715D153.quest_desc: ["ใช้ Scroll Forge และ Frozen Bone เพื่อคราฟต์ Ice Scrolls"]
	quest.71B6DA56399050E1.quest_desc: ["The &bPersonal Shrinking Device &fwill allow you to &ashrink &fwith the use of &4power&f."]
	quest.71B6DA56399050E1.title: "&aPersonal Shrinking Device"
	quest.71C0695C91F50ECC.title: "hidden/collect_any_crystallized_block"
	quest.71DD555551705B17.quest_desc: ["การใช้งานแรก ๆ ของ &8Steel&r อย่างหนึ่งคือ &bDynamic Tank&r", "", "เป็นระบบเก็บของแบบ &emultiblock&r ที่ออกแบบมาเก็บ &bของเหลว&r และ &eก๊าซ&r ในปริมาณมหาศาล สร้างถังให้ใหญ่ขึ้นเพื่อเพิ่มความจุอย่างมาก", "", "Dynamic Tanks มีประโยชน์เป็นพิเศษสำหรับป้อนระบบ &bการแปรรูป&r และ &eการผลิตพลังงาน&r ขนาดใหญ่ โดยไม่ต้องพึ่งภาชนะเล็ก ๆ หลายสิบใบ", "", "เมื่อถังไม้ไม่พอ ก็สร้างแทงก์"]
	quest.71DD555551705B17.quest_subtitle: "เก็บของเหลวในระดับมหึมา"
	quest.71DD555551705B17.title: "Dynamic Tank"
	quest.71F6CFF4AA59A6A4.title: "mod_integration/neepmeat/vivisect_kindling"
	quest.71FE41BE829CEE9F.title: "triggers/hints/resonant_lily_page0"
	quest.720874ECBFD3FD19.quest_desc: ["  &bBlaze Ember&r + PF → &4Blaze Ember Ø&r", "", "  &bVoidFlame Coal&r + &cBlaze Emberƒ&r → &4VoidFlame Ø&r", "", "  &bEclipse Ember&r + &cVoidFlameƒ&r → &4Eclipse Ember Ø&r", "", "  &4&oX&r &4Ø&r + &bgoo&r* ➠ &c&oX&r &cƒ&r", "", "    (* goo ต้องมีระดับ ≥ ที่กำหนด)", "", "   PF = polymophic fluid", "    Ø = เชื้อเพลิงที่ยังไม่กลั่น&r  ", "    ƒ = เชื้อเพลิง", " "]
	quest.720874ECBFD3FD19.quest_subtitle: "ของเหลว JDT เบื้องต้น"
	quest.720874ECBFD3FD19.title: "เชื้อเพลิงเหลว (Fluid Fuels)"
	quest.720D7CF2B0A4D3E5.title: "triggers/confirmed_drinking_age"
	quest.720F16D6B1CB519C.quest_desc: ["&bSource Gems&r &6คราฟต์&r ด้วย &9Lapis&r หรือ &dAmethyst&r ภายใน &bImbuement Chamber&r", "", "", "&8เคล็ดลับ: สูตรนี้ไม่ต้องใช้ pedestal"]
	quest.7218087067A87027.title: "unlocks/blocks/midnight_aberration"
	quest.721B153F773AE48A.title: "hidden/collect_pigment/pink"
	quest.722818115860F349.quest_desc: ["Fluid Tanks เป็นที่เก็บ &9ของเหลว&r ที่สะดวก ให้คุณมีที่เก็บของเหลวที่เครื่องจักรผลิตหรือต้องการ", "", "เชื่อมต่อกับ &bMechanical Pipes&r และระบบอื่นที่รองรับ เพื่อเติมและระบายถังโดยอัตโนมัติได้", "", "ถังระดับสูงจุได้มากขึ้นอย่างมาก เหมาะสำหรับสำรอง &9ของเหลว&r ปริมาณมากไว้พร้อมใช้", "", "ใช้ &eConfigurator&r เพื่อจัดการการเชื่อมต่อและควบคุมการไหลเข้าออกของของเหลว"]
	quest.722818115860F349.quest_subtitle: "เก็บของเหลวไว้ใช้ภายหลัง"
	quest.723CBF3A1705E5B1.title: "unlocks/trinkets/azuresque_dike_core"
	quest.72481CA0AC8AFD6A.quest_desc: ["แม้ภายนอกจะคล้าย &bFluix ME Covered Cable&r แต่มันมีหน้าที่วินิจฉัย โดยแสดงภาพ &6การใช้ช่องสัญญาณ&r บน &bcables&r &6ช่องสัญญาณ&r จะปรากฏเป็นเส้นสีเรืองแสงที่วิ่งตามแถบสีดำบน &bcables&r ทำให้คุณเข้าใจว่า &6ช่องสัญญาณ&r ถูกใช้อย่างไรใน &6เครือข่าย&r ของคุณ", "", "&6ช่องสัญญาณ&r สี่ช่องแรกแสดงเป็นเส้นสีเดียวกับ &bcable&r ส่วนสี่ช่องถัดไปแสดงเป็นเส้นสีขาว"]
