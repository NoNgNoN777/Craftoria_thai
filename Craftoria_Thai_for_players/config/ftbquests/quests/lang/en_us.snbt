	quest.610DFC7C0278F114.title: "hidden/collect_cookbooks/melochites_cookbook_vol_1"
	quest.6127E7FBC4ABF307.quest_desc: ["&bThermopneumatic Processing Plant&r ใช้ &6แปลง&r &7ของเหลว&r ให้เป็น &7ของเหลว&r ชนิดอื่น ", "", "เช่น การรวม &eLPG&r กับ &8Coal&r ในเครื่องนี้ &6ผลิต&r &7Liquid Plastic&r ได้ ", "", "นอกจากนี้ &bTPP&r ยัง &6ทำ&r &7fuel cracking&r ได้ คือ &6เปลี่ยน&r &cเชื้อเพลิงที่หนักกว่า&r ให้เป็น &aเชื้อเพลิงที่เบากว่า&r ", "", "หมายความว่า:", " ", "&cDiesel&r -> &3Kerosene&r ", "", "&3Kerosene&r -> &6Gasoline&r", "", "&6Gasoline&r -> &eLPG&r"]
	quest.61340C2A12FEAA26.quest_desc: ["&bME Drive&f ใช้เก็บ &bStorage Drives&f"]
	quest.61340C2A12FEAA26.title: "ME Drive"
	quest.6137C9FB49DB4A9C.quest_desc: ["แปรรูปวัสดุอินทรีย์เป็น &2Bio Fuel&r เชื้อเพลิงอเนกประสงค์สำหรับโรงงานของคุณ เผาโดยตรงใน &eBio Generator&r เพื่อผลิตไฟฟ้า หรือใช้ร่วมกับ &bHydrogen&r ใน &ePressurized Reaction Chamber&r เพื่อผลิต &dEthylene&r"]
	quest.6137C9FB49DB4A9C.quest_subtitle: "เปลี่ยนสารอินทรีย์เป็นพลังงาน"
	quest.6153214FB809211E.title: "unlocks/enchantments/vanilla_trident_channeling"
	quest.615978D7B5BF68B6.title: "unlocks/food/rock_candy"
	quest.61705B613AC48996.title: "unlocks/head_fusion/basic_recipes"
	quest.61748279816F2D7F.quest_desc: ["&bRedstone Control Module&f มีไว้ให้คุณควบคุมเครื่องจักรด้วย &credstone&f! &6คลิกขวา&f ที่โมดูลในมือเพื่อ &6เปลี่ยน&f การตั้งค่าจากเครื่องที่ต้องการ &9High Signal&f เป็น &9Low Signal&f และกลับกัน แล้ววางลงในช่องโมดูล &credstone&f", "", "หมายความว่า:", "- เมื่อตั้งเป็น &9High Signal&f เครื่องจะ &6ทำงาน&f ก็ต่อเมื่อได้รับสัญญาณ &credstone&f หากไม่มีสัญญาณ &credstone&f เครื่องจะปิด", "- เมื่อตั้งเป็น &9Low Signal&f เครื่องจะ &6ทำงาน&f ก็ต่อเมื่อไม่ได้รับสัญญาณ &credstone&f หากมีสัญญาณ &credstone&f เครื่องจะปิด"]
	quest.6185438AF2B86332.title: "hidden/status_effects/vulnerability"
	quest.618954282F39FB14.title: "hidden/collect_pigment/cyan"
	quest.619BC1F1094F4EFA.quest_desc: ["ข้อมูลตอนโฮเวอร์และกด SHIFT บอกไว้หมดแล้ว: ", "", "\"รางไฟฟ้าทิศทางเดียว ความเร็วปรับได้ตามความแรงของสัญญาณที่ป้อนเข้า\""]
	quest.61A7F8B1C6ECEEA5.quest_desc: ["&bEncased Fan&r ที่ดูธรรมดา... อาวุธลับ (ที่ไม่ลับเท่าไร) ของ Create", "", "ลองดู&6 bulk-blasting&r (โอ้โห!) และการ &6ผลัก&r ของไปมา"]
	quest.61AAFF003014ABBC.quest_desc: ["คราฟต์ &bTabula Vitae&r เพื่อปลดล็อกความสามารถในการสร้าง &bSigils&r อันทรงพลัง &bflasks&r และไอเทมมีประโยชน์อื่น ๆ"]
	quest.61AAFF003014ABBC.quest_subtitle: "ความรู้ทำให้เลือดมีจุดหมาย"
	quest.6201E6DF709C29D0.quest_desc: ["  &bFerricore armor&r แข็งแกร่งและทนทานเท่า &biron armor&r", "", "  สามารถ &6อัปเกรด&r เป็นระดับที่สูงขึ้นได้ด้วย &btemplate&r ที่เหมาะสม", "", "  รองรับ &bupgrades&r ที่ให้ &6ความสามารถพิเศษ&r หลากหลาย", "", "• &bHelmet: &cMindFog&r", "• &bChestplate: &cInvulnerability&r", "• &bLeggings: &cRun Speed&r, &cWalk Speed&r", "• &bBoots: &cStep Assist&r, &cJump Boost&r", "", "( การอัปเกรดชุด ferricore armor ทั้งชุดไปยังระดับถัดไป ประหยัดกว่าการทำชุดเต็มในระดับสูงสุดตั้งแต่ต้น )", "", "{image:justdirethings:item/template_ferricore width:100 height:100 align:center fit:true}"]
	quest.6201E6DF709C29D0.quest_subtitle: "เกราะที่อัปเกรดได้"
	quest.6201E6DF709C29D0.title: "Ferricore Armor"
	quest.621168DCC2A3B3F3.quest_subtitle: "Catch &d75&r unique fishes."
	quest.6226A837048CB71B.title: "unlocks/ampoules/raw_bloodstone_ampoule"
	quest.6227304103E32C74.quest_desc: ["&bFluid Tank&r สุดสะดวกใช้ได้เดี่ยว ๆ หรือ &6ต่อ&r กันเป็นคอลัมน์กว้าง 1 ช่อง, 2x2 หรือ 3x3 สูงได้ถึง 30 บล็อก!", "", "&6วาง&r ไว้เหนือแหล่งความร้อน &6สูบ&r &9น้ำ&r เข้าไปให้พอ แล้วมันจะกลายเป็น boiler ที่ป้อนพลังงานให้ &bSteam Engines&r — boiler ที่ใหญ่กว่า เมื่อ &6ได้&r น้ำและความร้อนมากขึ้น ก็ &6ขับเคลื่อน&r &bSteam Engines&r ได้มากขึ้น"]
	quest.6227304103E32C74.quest_subtitle: "แข็งแรงจริง ทั้งที่กลวง"
	quest.62284E06EA07E87E.quest_desc: ["&bเควส&r บางเควสจะให้รางวัลเป็น &bT2 Codex&r &8(Lost Codex Entry)&r", "", "", "&8เคล็ดลับ: T2 Codexes &4ไม่&8เกิดตามธรรมชาติ"]
