	quest.33D4B0B289A55EC9.title: "unlocks/items/experience_bottle"
	quest.33EEBDD0730C020E.quest_desc: ["ใช้ Scroll Forge และ Blood Vial เพื่อคราฟต์ Blood Scrolls"]
	quest.33F695229D12C6FB.quest_subtitle: "ผึ่งเรซินให้แห้ง"
