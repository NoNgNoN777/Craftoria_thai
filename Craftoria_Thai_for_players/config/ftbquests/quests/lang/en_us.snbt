	quest.62F43B936E236071.quest_desc: ["   &6เก็บ&r &bไอเทม&r จาก AOE ที่เยื้องออกไป แล้ว &6ใส่&r ลงใน &bที่เก็บของที่ติดอยู่&r", "", "{image:ftblibrary:icons/down width:32 height:32 align:center}", "{image:minecraft:block/barrel_side width:64 height:64 align:center}"]
