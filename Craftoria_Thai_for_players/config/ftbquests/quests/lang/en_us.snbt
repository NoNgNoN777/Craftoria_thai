	quest.423B29BD8DAC8C3D.quest_desc: ["&bPinnacle Spawner Upgrade Rune&f คือระดับสูงสุดของเส้นทางอัปเกรด spawner มาตรฐาน", "", "พลังสูงสุด ม็อบสูงสุด ความโกลาหลสูงสุด"]
	quest.423B29BD8DAC8C3D.quest_subtitle: "จุดสูงสุดของการอัปเกรด spawner"
