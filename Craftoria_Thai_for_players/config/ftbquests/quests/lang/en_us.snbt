	quest.3D138EBE5C3BCB81.title: "unlocks/trinkets/gleaming_pin"
	quest.3D17DB42D3929457.title: "triggers/hints/paltaeria_page1"
	quest.3D4317C2B25D5680.quest_desc: ["&bScroll Forge&r ใช้ &6คราฟต์&r scroll ด้วย &bPaper&r และ &bInk&r", "", "คุณสร้าง &bspell&r ได้หลายประเภทด้วยไอเทมที่ต่างกัน ", "", "ไอเทมที่ต่างกันเหล่านี้เรียกว่า &bFocuses&r ", "", "&bFocus&r แต่ละอันใช้กับ scroll ชนิดเฉพาะ ", "", "โปรดรู้ว่า ยิ่ง &6ระดับ&r ของ &bInk&r ที่คุณเลือกสูง scroll ที่หายากกว่าก็จะมีให้ใช้ และ scroll จะทรงพลังกว่า"]
	quest.3D48A7B657966D4F.title: "milestones/reveal_amaranth"
	quest.3D53114F65E45DEE.title: "mod_integration/the_bumblezone/yellow_radiance"
	quest.3D5B74D9663AAB5A.quest_desc: ["&bHeat Generator&r เป็นแหล่งพลังงานง่าย ๆ ที่อาศัย &cแหล่งความร้อน&r รอบตัวมัน ", "", "&bGenerator&r รับ &cความร้อน&r ได้จาก &a7&r ตำแหน่ง โดย &a6&r ตำแหน่งคือด้านต่าง ๆ ของมัน อีกตำแหน่งคือตัวเครื่องเองซึ่งอาจ &4จมอยู่ในลาวา&r ได้ มัน &6ผลิต&r พลังงานไม่มาก แต่สำหรับช่วงต้นของการเดินทางก็เหลือเฟือ!", "", "ไม่เพียง &bบล็อก&r และ &7ของเหลว&r ที่ปล่อย &cความร้อน&r จะผลิตพลังงานได้ แต่ความร้อนจาก &bThermodynamic Conductors&r ก็ใช้ได้เช่นกัน"]
	quest.3D5B74D9663AAB5A.quest_subtitle: "เปลี่ยนความร้อนเป็นพลังงาน!"
	quest.3D5B74D9663AAB5A.title: "Heat Generator"
	quest.3D7406A517FA591D.quest_desc: ["ด้วย &bMaterials&r เหล่านี้ คุณจะ &6สร้าง&r &bPressure Chamber&r แรกของคุณได้ "]
	quest.3D7406A517FA591D.title: "Pressure Chamber แรกของคุณ (Your First Pressure Chamber)"
