	quest.300F6868FC217C55.title: "&6ผู้ทำครบทุกอย่าง (The Completionist)"
	quest.302BE63E3488B94D.quest_desc: ["เป็นแค่ไอเทมสำหรับคราฟต์อีกชิ้น ", "ดูสูตรได้ใน &bEMI/JEI&r"]
	quest.30396F5AD792EABD.title: "unlocks/colored_lamps/brown_lamp"
