	quest.42AC14C7D41F0CAB.quest_desc: ["ใช้ Scroll Forge กับ Blaze Rod เพื่อคราฟต์ Fire Scrolls ซึ่งเผาศัตรูได้ดีมาก... และบางครั้งก็เผาเพื่อนด้วย... แค่อย่าร่าย fireball ใส่สัตว์เลี้ยงของพวกเขาโดยไม่ตั้งใจก็พอ"]
	quest.42BD2180A2C7818F.title: "unlocks/colored_saplings/cyan_sapling"
	quest.42C5954DE45C0AF1.title: "unlocks/equipment/oblivion_pickaxe"
	quest.42C757350BE9280A.quest_desc: ["พิชิต &bDaemonium&r ชนิดต่าง ๆ ที่อาศัยอยู่ในอาณาจักรปีศาจ และเก็บของดรอปเฉพาะตัวของพวกมัน"]
	quest.42C757350BE9280A.quest_subtitle: "ถ้านรกอยากสู้ ก็สู้ให้มันดู"
	quest.42C757350BE9280A.title: "นักล่าปีศาจ (Demon Hunter)"
	quest.42CBBA942DBD600E.title: "unlocks/equipment/tender_pickaxe"
	quest.42D39031CFD335C9.quest_desc: ["ประกอบพิธี &bRitual of Fallen Trees&r เพื่อเก็บเกี่ยวต้นไม้ใกล้เคียงโดยอัตโนมัติ"]
	quest.42D39031CFD335C9.quest_subtitle: "แม้ป่าก็ถูกเก็บเกี่ยวด้วยกำลังได้"
	quest.42D6CC67AB29D7DA.quest_desc: ["  ในที่สุดคุณก็มาถึง &bDigital Circuits&r แล้ว", "", "  จากตรงนี้พลังที่แท้จริงเริ่มต้นขึ้น เพิ่มความสามารถ overclock ของเครื่องจักรให้เหนือกว่าเดิม พร้อมแร่ชนิดใหม่จากเหมือง quarry", "", "  &6คุณควรทำให้สิ่งเหล่านี้อัตโนมัติ&r"]
	quest.42D6CC67AB29D7DA.title: "&9ยุคปลายเกม (The Lategame Age)"
	quest.42E7455071D29725.title: "unlocks/colored_saplings/gray_sapling"
	quest.42EC7168ADC6AF76.quest_desc: ["  &bBlaze Jet Wand&r มี &6ความสามารถ&r ดังนี้:", "", "• &cLava Repair&r: เหมือนอุปกรณ์ Tier 2 อื่น ๆ", "• &cAir Burst&r: ระเบิดพาคุณพุ่งขึ้นกลางอากาศ", "", "   ความสามารถของไม้เท้า JDT มี &6ติดตัว&r อยู่แล้ว", "", "   นอกจากความสามารถ &cAir Burst&r แล้ว เมื่อถือไว้ในมือ ยัง &6ป้องกันความเสียหายจากการตก&r ด้วย", "", "{image:justdirethings:item/blazejet_wand width:100 height:100 align:center fit:true}"]
	quest.42EC7168ADC6AF76.quest_subtitle: "เดินทางง่ายขึ้น"
	quest.42F50CA00F913A46.quest_desc: ["เปิด &bGUI&r ด้วยการกดปุ่มลัด \"&6K&r\"", "", "รับ &aค่าประสบการณ์&r จากการฆ่าม็อบ ขุดแร่ หลอมของ และอื่น ๆ ", "", "ใส่ &aค่าประสบการณ์&r ลงใน &eแต้มสกิล&r เพื่อปลดล็อกความเป็นไปได้ในการเพิ่ม &9ความสามารถ&r และ &6โบนัส&r หลากหลายตลอดการเล่นของคุณ", "", "ใช้ &eแต้มสกิล&r เหล่านี้อย่างชาญฉลาด ", "", "&6ระบบ&r นี้สำคัญมากต่อช่วงต้นเกมที่ลื่นไหลและน่าสนใจ"]
	quest.42F50CA00F913A46.quest_subtitle: "ต้นไม้สกิลที่เพิ่มความสามารถและให้ประโยชน์หลากหลาย"
	quest.42F50CA00F913A46.title: "&eสกิล (Skills)"
	quest.4303A1A434C07540.quest_desc: ["วิญญาณ Janitor &6เก็บ&r ไอเทมและ &6เก็บใส่&r &bคอนเทนเนอร์&r ได้", "", "มีประโยชน์เป็นพิเศษสำหรับรวบรวมผลผลิตของวิญญาณตนอื่น"]
	quest.4303A1A434C07540.quest_subtitle: "เรียบร้อยสะอาดตา"
	quest.4303A1A434C07540.title: "Ritual: Summon Foliot Janitor"
	quest.431FA8EF8194D39B.quest_desc: ["🦀 🦀 🦀 Crab Crab Crab 🦀 🦀 🦀 ", "", "ทำ &6โบราณคดี&r (suspicious sand/gravel) จาก sand/gravel ธรรมดา", "", "- รัศมี: &93 บล็อก&r จากบล็อกเก็บของ", "", "- ผูกด้วย &bDominion Wand&r", "", "- ต้องใช้ Source: ใช่", "", "Sand:", "&8- DESERT_WELL_ARCHAEOLOGY", "&8- DESERT_PYRAMID_ARCHAEOLOGY", "&8- OCEAN_RUIN_WARM_ARCHAEOLOGY", "", "Gravel:", "&8- OCEAN_RUIN_WARM_ARCHAEOLOGY", "&8- TRAIL_RUINS_ARCHAEOLOGY_COMMON", "&8- TRAIL_RUINS_ARCHAEOLOGY_RARE", "", "", "&4หมายเหตุ&r: บล็อกจะ &4ถูกใช้หมด&r คุณต้องวาง sand/gravel เหล่านั้นใหม่"]
	quest.431FA8EF8194D39B.quest_subtitle: "🦀 สวมหมวก 🦀 | โบราณคดี"
	quest.4332CDDBCAFEE6AB.title: "unlocks/redstone/redstone_sand"
	quest.4333B9423227E011.title: "hidden/collect_koi"
	quest.4343FFED5136ED89.title: "hidden/collect_crawfish"
