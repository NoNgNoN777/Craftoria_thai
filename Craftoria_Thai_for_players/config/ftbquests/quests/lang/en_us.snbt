	quest.623CE97E3A7064D7.title: "unlocks/filtering"
	quest.623E42BC12E14090.title: "unlocks/colored_lamps/gray_lamp"
	quest.6296DCFE578CBD50.quest_desc: ["&bSource Berry Bushes&r เกิดใน &aArchwood Forest&r", "", "", "&8เคล็ดลับ: &bStarbuncle &8เก็บเกี่ยวอัตโนมัติได้"]
