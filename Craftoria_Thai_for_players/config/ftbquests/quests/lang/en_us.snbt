	quest.516F2A1A1270D9DC.quest_desc: ["  &bSimple&r:", "    • &6ทุบ&r &bบล็อก&r", "    • &6ใช้&r &bเครื่องมือ&r หากมีให้", "    • ควบคุม &eความเร็ว&r และ &eทิศทาง&r", "    • ตั้งให้ไวต่อ &4redstone&r ได้ (ไม่บังคับ)", "", "  &bAdvanced&r:", "    • เพิ่ม &6การกรอง&r และ &3offset AOE&r", "    • ต้องใช้ &cพลังงาน&r", "", "{image:justdirethings:block/blockbreakert2_side width:100 height:100 align:center}"]
	quest.51710E8906D3A164.title: "unlocks/colored_lamps/black_lamp"
	quest.51A8026A0F8A83B1.quest_desc: ["พบ Emerald ได้ขณะขุด สำรวจ หรือค้าขายกับ villager และใช้คราฟต์ Evocation Scrolls"]
	quest.51AA69CA71174757.quest_desc: ["&cSupreme Control Circuit&r ยกระดับวงจรของ &bMekanism&r ไปอีกขั้น", "", "ทำจากการรวม &eAbsolute Control Circuit&r กับ &cThermonuclear Alloy&r วงจรเหล่านี้ปลดล็อกเครื่องจักรและโครงสร้างพื้นฐานที่ &5ทรงพลัง&r ที่สุดบางอย่างที่มีอยู่", "", "แต่ Supreme ยังไม่ใช่จุดสิ้นสุด", "", "วงจร &dCosmic&r และ &zInfinite&r รออยู่เหนือระดับนี้ ดันเทคโนโลยีของคุณไปไกลกว่าเดิม", "", "&6ปลายเกมที่แท้จริงเริ่มตรงนี้&r"]
	quest.51AA69CA71174757.quest_subtitle: "การควบคุมระดับถัดไป"
	quest.51B466B08FCE34C4.title: "unlocks/trinkets/ring_of_denser_steps"
	quest.51B59A987F916C7A.quest_desc: [
		"A portable storage device that can store from &a256&r up to &c1 BILLION&r items per slot."
		""
		""
		"&8&lFeatures:"
		"- &3Larger slots: "
		"Store more items per slot than normally possible. Up to 1 billion items in a single slot."
		""
		"- &3Different sizes: "
		"From Bank &71&r with 9 slots to bank &c7&r with 108 slots each with increasing slot sizes."
		""
		""
		"&8&lPickup Modes:"
		"- &aPickup all&r: "
		"All items picked up will automatically go into the &bBank&r instead of your inventory."
		""
		"- &1Filtered pickup&r: "
		"Items will only go into &rBanks&r if they already contain matching items."
		""
		"- &5Void excess&r: "
		"Similar to filtered pickup, but if there is no room left in the &bBank&r, the item gets voided."
		""
		"- &cNo pickup&r: "
		"Items go straight into your inventory."
		""
		""
		"&8&lBuild Modes:"
		"- &aBuild mode&r: "
		"Choose any block inside your &bBank&r and place directly from the &bBank&r item."
		"Scroll while crouching to choose block."
		""
		"- &3Randomized build mode&r: "
		"Similar to Build mode, but blocks get chosen randomly."
		""
		"- &eBag Mode: "
		"Right click to open the &bBank&r inventory screen."
		"Right click which crouching to change build mode."
	]
	quest.51B59A987F916C7A.quest_subtitle: "A portable storage solution!"
	quest.51E14807C39F4111.quest_desc: ["&bThe Improved Tome of Scrapping&r คือรุ่นอัปเกรด ที่กู้คืนเอนชานต์ได้มีประสิทธิภาพขึ้น เมื่อแยกชิ้นส่วนอุปกรณ์ที่เอนชานต์"]
	quest.51E14807C39F4111.quest_subtitle: "กู้คืนได้มากขึ้น"
	quest.51E14807C39F4111.title: "Superior Scrapping"
	quest.51E386BC7692D06C.quest_desc: ["เพื่อ &6สร้าง&r &6Mercurial Logistics network&r ต้องใช้ &bWires&r เหล่านี้ &6เชื่อม&r ระหว่างอินพุตและเอาต์พุต &bConnection Nodes&r ให้สายหลายเส้นมาบรรจบที่จุดเดียวได้หากจำเป็น"]
	quest.51E386BC7692D06C.title: "Mercurial Connections"
	quest.51E7DAE4251C75EA.title: "unlocks/food/tarts"
	quest.51ECF72F223BDB3A.title: "Coffee"
	quest.51F5C6D60D719DC4.quest_desc: ["&bBrass&r - alloy ง่าย ๆ ของ &bCopper&r และ &bZinc&r แต่คุณต้อง &6ไป&r Nether เพื่อ &6เตรียมตัว&r ให้ทำมันได้", "", "&6นำ&r &bBlaze Burners&r เปล่าหลายอันไปด้วย... คุณรัวใส่ &bBlaze Spawner&r เพื่อ &6จับ&r blaze ได้เท่าจำนวน &bBlaze Burners&r ที่มี", "", "เมื่อมี &bBrass&r แล้ว คุณจะ &6คราฟต์&r ไอเทมในส่วน &c\"Brass\"&r ได้: &bDeployer&r สำหรับ &cทำสิ่งที่ปกติเป็นการกระทำของผู้เล่น&r, บล็อก Create พื้นฐานรุ่นฉลาดขึ้น และตัวเลือกสวย ๆ สำหรับตกแต่ง เรายังวาง &bBlaze Burner&r ไว้ตรงนั้นด้วย แม้ว่าคุณคงทำไว้แล้วก็ตาม"]
	quest.5203A0D6B299F377.title: "unlocks/trinkets/cotton_cloud_boots"
	quest.520B997808AF3051.title: "triggers/hints/malachite_page0"
	quest.52103CDA71FB45A6.title: "unlocks/blocks/particle_spawner"
	quest.5221657F939FE63B.quest_desc: ["ใช้ Scroll Forge กับ Bottle O' Lightning เพื่อคราฟต์ Lightning Scrolls"]
	quest.5253D3AA5B45369E.quest_desc: ["ตอนนี้เราคุยเรื่อง &bProjectile form glyph&r", "", "พิเศษตรงที่ใช้ &5Spell Effects&r กับโปรเจกไทล์แต่ละลูก", "&4หมายเหตุ&r: &bเครื่องมือ Enchanter&r อาจไม่เป็นไปตามนี้ ... &0(จะว่ายังไงได้ ม็อดเวทมนตร์)&r", "", "&8Projectile -> Pierce -> Pierce -> Pierce -> Break -> Pierce&r", "- &bPierce augment glyph&r: ทำให้โปรเจกไทล์ชนบล็อกเพิ่มอีก 1 บล็อกต่อ glyph", "- &bProjectile glyph&r กับ &bPierce augment glyph&r 3 อัน: จะทะลุ &bบล็อก&r เพิ่มอีก 3 บล็อก", "- &5Spell Effects&r ในกรณีนี้คือ: &8Break -> Pierce&r", "=> โปรเจกไทล์ชน 4 ครั้ง และทุกครั้งใช้ &5Spell Effects&r ข้างต้น", "", "", "คุณคิดว่าจะทำลายได้กี่ &bบล็อก&r (ดูคำตอบที่ &bหน้า 2&r)", "", "{@pagebreak}", "5 บล็อกใช่ไหม &4ผิด&r", "", "8 บล็อก &2ถูกต้อง&r", "&8โปรเจกไทล์ชน 4 ครั้ง และทุกครั้งใช้ &5Spell Effects&r ข้างต้น", "&8<=> โปรเจกไทล์ชน 4 ครั้ง และทุกครั้งทำลาย 1 บล็อก \\& บล็อกด้านหลังมัน&r", "", "", "&4หมายเหตุ&r: &bSpell Tools&r จะไม่เป็นไปตามนี้ &8:(&r"]
	quest.5253D3AA5B45369E.quest_subtitle: "Projectile Glyph"
	quest.5253D3AA5B45369E.title: "เวทเบื้องต้น (Spell 101 - 3)"
	quest.525658A19130AF37.quest_desc: ["ผลิต &7Compressed Air&r โดยใช้ &7ของเหลวเชื้อเพลิง&r ต่าง ๆ ", "", "หากต้องการดู &8เชื้อเพลิง&r ที่ใช้ได้ทั้งหมด ให้เปิดแท็บ ‘&9Available Fuels&r’ ซึ่งเรียงจาก &aมีประสิทธิภาพมากที่สุด&r ไป &cน้อยที่สุด&r "]
