	quest.2E192A8302EA6B38.title: "unlocks/food/sawblade_holly_titration"
	quest.2E1EB12F3D9B315E.quest_desc: ["&britual&r ที่น่าสนใจบางอัน:", "", "- &bTablet of Conjure Island: Desert&r", "&8+ เปลี่ยน &9รัศมี &8รอบตัวมันให้เป็น &bไบโอมอื่น&8 (ไบโอมอะไร? ดูคำอธิบายของ tablet)", "&8+ บล็อกน้ำ/อากาศจะ &4ถูกแทนที่", "&8+ ต้องใช้ &5source &8ขณะทำงาน (เมื่อเสร็จแล้วไม่ต้องใช้อีก)", "", "- &bTablet of Disintegration&r", "&8หมายเหตุจากผู้สร้างเควส: ไม่คุ้ม", "&8+ นอกจากต้องใช้ source ในการทำงานแล้ว ค่าประสบการณ์ยังอยู่ในรูปไอเทมด้วย ", "&8+ การใช้ (ทีละสแตก) ก็ยังยุ่งยาก"]
	quest.2E1EB12F3D9B315E.quest_subtitle: "เควสนี้สำหรับสายทำครบทุกอย่าง"
	quest.2E1EB12F3D9B315E.title: "แผ่นจารึกสีแดง (Red Tablets)"
	quest.2E5D9CB5D821E96A.quest_desc: ["&bPressure Tube&r ชนิดที่ &8ทนทาน&r ที่สุด ", "", "&bTubes&r เหล่านี้ &2พรางตัว&r ได้ และรองรับ &bTube Modules&r เพื่อเพิ่ม &eฟังก์ชันพิเศษ&r"]
	quest.2E73C8EDF463F426.title: "unlocks/gemstone_lights/any"
	quest.2E7A46639993CCDE.quest_desc: ["ทุกโลกมีความลับซ่อนอยู่เหนือสิ่งที่มองเห็น ไม่ว่าจะใต้ดินหรือในมิติอันไกลโพ้น", "", "บางครั้ง คุณไม่ต้องออกจากบ้านก็พบสิ่งผิดปกติได้", "", "ดวงจันทร์นำเหตุการณ์พิเศษมาสู่ท้องฟ้ายามค่ำคืน แต่ละแบบเปลี่ยนวิธีที่คุณใช้ค่ำคืนนั้น", "", "&aHarvest Moon", "เวลาที่เหมาะกับการเก็บเกี่ยวพืชผล พืชที่เข้าเงื่อนไขจะดรอปเพิ่มขึ้น", "", "&9Blue Moon", "คืนโชคดีที่ให้เอฟเฟกต์ Luck เหมาะกับการตกปลาและกิจกรรมที่พึ่งโชค", "", "&cBlood Moon", "คืนอันตรายที่ม็อบศัตรูน่ากลัวขึ้นมาก และการนอนก็ช่วยคุณไม่ได้", "", "&5Super Moon", "ดวงจันทร์ยักษ์ที่ทำให้หา slime ได้ง่ายขึ้น", "", "บางเหตุการณ์ยังมี &6รุ่น Super&r ทำให้ผลของมันแรงขึ้นอีก", "", "คอยสังเกตดวงจันทร์และข้อความประกาศแต่ละเหตุการณ์ คุณไม่มีทางรู้ว่าคืนไหนควรอดตาหลับขับตานอน"]
	quest.2E7A46639993CCDE.quest_subtitle: "เธอมาเลาะรอบภูเขา!"
	quest.2E7A46639993CCDE.title: "&bเหตุการณ์ดวงจันทร์ (Lunar Events)"
	quest.2E81F371817EC492.title: "hidden/entity_interact/eraser"
	quest.2E883FCCA2FB281B.quest_desc: ["เมื่อตั้ง &bQuantum Rings&f สองวง คุณเชื่อมต่อ &bME System&f ของคุณไปยังที่ใดก็ได้ในโลก เชื่อมวงแรกเข้ากับ &bME System&f ของคุณ และวงที่สองไว้ที่ที่ต้องการให้เชื่อมต่อกับ &bME System&f ของคุณ คุณต้องมี &bEntangled Singularities&f 2 อัน ใส่อันละวงใน &bQuantum Ring&f แต่ละวง แล้วทั้งสองจะเชื่อมถึงกัน"]
	quest.2E883FCCA2FB281B.quest_subtitle: "งานศิลปะชิ้นหนึ่ง"
	quest.2E883FCCA2FB281B.title: "Quantum Ring"
	quest.2E97456B0ED0AB1A.quest_desc: ["&bElectric Pump&r เป็นเครื่องมือหลักสำหรับดูด &9ของเหลว&r จากโลกแล้วส่งเข้าโรงงานของคุณ", "", "วางปั๊มไว้เหนือ &9ของเหลว&r ที่ต้องการสูบโดยตรง จ่าย &eFE&r ให้ และต่อ &bMechanical Pipe&r หรือ &9Fluid Tank&r เข้ากับช่องส่งออก", "", "ปั๊มสูบของเหลวจากแหล่งขนาดใหญ่ได้อัตโนมัติ เหมาะกับการป้อน &9ของเหลว&r ให้เครื่องจักรของคุณอย่างต่อเนื่อง", "", "ติดตั้ง &bUpgrades&r เพื่อเพิ่มความเร็วในการสูบอย่างมาก", "", "ที่ดีที่สุดคือ การสูบ &bน้ำ&r ไม่ทำให้ &9water source blocks&r ถูกใช้หมด คุณจึงสูบจากแหล่งเดิมได้ไม่จำกัด"]
	quest.2E97456B0ED0AB1A.quest_subtitle: "ดึงของเหลวออกจากโลก"
	quest.2E97456B0ED0AB1A.title: "Electric Pump"
	quest.2EA3FE458DAB45EB.title: "unlocks/glowblocks/red_glowblock"
	quest.2EB0D8DB6C0D366F.title: "milestones/reveal_mermaids_brush"
	quest.2EE48762D9C66FDD.title: "hidden/discover_weeping_gala"
	quest.2F4B6DFC221E8B7C.title: "hidden/collect_vanilla/ender_eye"
	quest.2F4F94DCC3986B5B.title: "unlocks/potions/bad_omen"
	quest.2F53567C34E86536.quest_desc: ["นี่คือ Spellbook พื้นฐานที่สุด เก็บ Spell ได้เพียงห้าอัน"]
	quest.2F66F85A601AC908.quest_desc: ["{image:modern_industrialization:block/machines/macerator/overlay_top_active width:32 height:32 align:center}", "  ตอนนี้คุณ &6เพิ่มแร่เป็น 1.5 เท่า&r ได้แล้ว! หมายความว่ามีโอกาส 50% ที่จะสกัดผงเพิ่มอีกหนึ่งชิ้นจาก &bRaw Ore&r ของคุณ คุณยังเอา &bFull Ore&r มาสกัด &bRaw Ore&r ออกมาจำนวนมากด้วย &bMacerator&r ได้", "", "  ในฐานะ &bMacerator&r คุณโยนไอเทมโลหะลงไป &6รีไซเคิลกลับเป็นผง&r ได้ เป็นวิธีเก็บของกลับมาเล็กน้อยจากการผจญภัยหรือเครื่องมือเก่า"]
	quest.2F66F85A601AC908.title: "Bronze Macerator"
	quest.2F6C16939D136BF0.quest_desc: ["&bAnnihilation Plane&f จะ &6ทุบบล็อก&f และ &6เก็บ&b ไอเทม&f ที่อยู่ด้านหน้าโดยตรง"]
	quest.2F6C16939D136BF0.title: "ME Planes"
	quest.2F78D16A73C4598A.title: "unlocks/reagents/star_fragment"
	quest.2F7A213261682E1B.quest_desc: ["&bLiquefaction Cauldron&r &6แช่&r ทรัพยากรใน &dsolvent&r เพื่อผลิต &bSulfur&r จากทรัพยากรเหล่านั้น ปฏิกิริยานี้ต้องใช้ &6ความร้อน&r", "", "โปรดทราบว่าทรัพยากรบางอย่าง เช่น แร่ &aให้ sulfur มากกว่าหนึ่งชิ้น&r"]
	quest.2F8BDA9BE413F14A.title: "unlocks/glowblocks/green_glowblock"
	quest.2F9560A5281DCDFD.quest_desc: ["อยากกัน &cพวกกวนใจ&r ออกจาก &bของของคุณ&r ไหม? &6จับจองเลย&r! ", "", "คุณจะสร้าง &9Team&r หรือ &aclaim&r chunk คนเดียวก็ได้ ", "", "หากต้อง &aclaim&r chunk คนเดียว ให้เปิด &bช่องเก็บของ&r แล้วดูที่ &6มุมซ้ายบน&r ของหน้าจอ ", "", "มองหา &aปุ่มแผนที่&r ชื่อ \"&6Claim Manager&r\" ใช้ปุ่มนี้ claim ผืนดินที่เรียกว่า &achunk&r ได้ ", "", "&achunk&r แต่ละอันมีขนาด &b16x16 บล็อก&r ตั้งแต่ &5void&r ถึง &bท้องฟ้า&r ", "", "จำนวนที่ใช้ได้ &6มีจำกัด&r อย่าใช้จนเกินพอดี ", "", "หากต้องการสร้าง &9Team&r ก่อน ให้หาปุ่มชื่อ \"&6Your Team&r\" แล้วจะเห็นรายชื่อ &aสมาชิกทีม&r และ &3แชทส่วนตัว&r ", "", "จากนั้นคุณสร้าง &eparty&r แล้วเปลี่ยนชื่อและค่าอื่น ๆ ของ &eparty&r ได้โดย &6กด&r ที่ไอคอน &bเฟือง&r ", "", "คุณ &6เชิญ&r คนอื่นได้ด้วยคำสั่ง \"&a/ftbteams party invite&r\" เมื่อ &6สร้าง&r &eparty&r แล้ว"]
	quest.2F9560A5281DCDFD.quest_subtitle: "แผ่นดินของฉัน ไม่ใช่แผ่นดินของเธอ"
	quest.2F9560A5281DCDFD.title: "&3กิลด์ &7และการจับจอง (Guilds and Claims)"
	quest.2F993B0F106DB883.quest_desc: ["ใช้คราฟต์ไอเทมด้วย &bInscriber Presses&f ต่าง ๆ"]
	quest.2F993B0F106DB883.title: "Inscriber"
	quest.2FA7A5966FEF6701.quest_desc: ["The &bUltimate Mechanical Pipe&r has a per-pipe capacity of &9128,000mb&r and a per-\"&apull&r\" pipe flow rate of &932,000mb/t&r."]
	quest.2FA7A5966FEF6701.title: "Ultimate Mechanical Pipe"
	quest.2FAF4A09FDDD47AB.title: "hidden/collect_basal_marble"
	quest.2FB2FE782B1103D6.quest_desc: ["  มัลติบล็อกที่สองของคุณ: &bSteam Blast Furnace&r! เกือบเหมือนอันแรก ต่างกันตรงสูงขึ้นหนึ่งชั้น และใช้ &bFire Clay Bricks&r แทน &bBricks&r ธรรมดา", "", "  ใช้เทคนิคเดิมกับ &bWrench&r &6เพื่อดูตำแหน่งบล็อก&r และอย่าลืมว่าครั้งนี้ต้องใช้ &6hatch เพียง 3 ช่อง&r เหมือน &bCoke Oven&r แต่ไม่มี hatch ส่งออกของเหลว อย่างน้อยก็ตอนนี้!", "", "  คุณจะใช้ &bSteam Blast Furnace&r นี้ทำ &bSteel&r ชิ้นแรกของคุณ!"]
	quest.2FB2FE782B1103D6.title: "Steam Blast Furnace"
	quest.2FC029A9E504ECE6.title: "unlocks/enchantments/serendipity_reel"
	quest.2FC0A2D07CC2DFC7.quest_desc: [
		"Note:"
		""
		"  EMI—via looking up the Thermal Evaporation Controller—will present a build calculator for Thermal Evaporation Plants."
