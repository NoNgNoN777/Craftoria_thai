	quest.495EEAA73357FA60.quest_desc: ["  รองรับ &6อัปเกรด&r ระดับสูงสุด:", "", "• &bPickaxe&r: &cInstant Break&r, &cX-Ray&r", "• &bShovel&r: &cInstant Break&r", "• &bAxe&r: &cInstant Break&r", "• &bSword&r: &cMob X-Ray&r", "• &bBow&r: &cPhase&r, &cYondu Arrow&r", "", "{image:justdirethings:item/eclipsealloy_pickaxe_active width:100 height:100 align:center fit:true}"]
