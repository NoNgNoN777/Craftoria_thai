	quest.7CD19B3F354754F2.title: "unlocks/items/experience_bottle"
	quest.7CE1DA38A8258A77.title: "unlocks/food/gin"
	quest.7CF09238E123231F.quest_desc: ["&bRod o' Lightning&r ให้ &9Spell Cooldown Reduction&r &a+15%&r และ &eLightning Spell Power&r นอกจากนี้ยังให้พลัง scroll &a5%&r แก่ &bScrolls&r ที่ไม่ใช่สายฟ้า ", "", "ใช้ช่วยร่ายคาถาให้มีประสิทธิภาพขึ้น"]
	quest.7D0CF81F7E703B71.quest_desc: ["{image:modern_industrialization:block/machines/water_pump/overlay_front_active width:32 height:32 align:center}", "", "  สงสัยเรื่องการสูบ &bWater&r อัตโนมัติสินะ? โชคดีที่คุณทำได้เกือบทุกอย่าง! &bWater Pump&r จะเก็บ &bWater&r อัตโนมัติและ &6ส่งต่อไปยังบล็อกที่อยู่ติดกัน&r ต้องวางแหล่งน้ำล้อมรอบปั๊มในแนวนอน ป้อน &bSteam&r แล้วมันจะเริ่มผลิต &bWater&r ที่ 1 EU/t", "", "  &bBronze Water Pump&r ผลิต &6125mb ของ &bWater&r ต่อแหล่งน้ำที่อยู่ติดกันทุก 5 วินาที&r ให้ผลผลิตสูงสุด 1000mb ทุก 5 วินาที"]
	quest.7D0CF81F7E703B71.title: "Bronze Water Pump"
	quest.7D155344A5A6CEF7.quest_desc: ["&bThermal Compressor&r ใช้ &eความต่างของอุณหภูมิ&r ที่ด้านตรงข้ามของบล็อกเพื่ออัดอากาศ (&7air&r) ", "", "การใช้งาน วางบล็อก &cอุณหภูมิสูง&r ไว้ด้านหนึ่ง และบล็อก &aอุณหภูมิต่ำ&r ไว้ด้านตรงข้าม ", "", "หมายเหตุ: ด้าน &3North-South&r เชื่อมต่อความร้อนถึงกัน เช่นเดียวกับด้าน &3East-West&r แต่ &3North-South&r กับ &3East-West&r ไม่มี &eการเชื่อมต่อความร้อน&r ระหว่างกัน ", "", "ด้านที่ &eเชื่อมต่อความร้อน&r จะพยายามปรับ &bอุณหภูมิ&r ให้เท่ากัน จึงต้องรักษาความต่างของอุณหภูมิให้ &cมากพอ&r เพื่อให้ทำงานได้ &aอย่างมีประสิทธิภาพ&r"]
	quest.7D183DBFAA8E0BF1.title: "hidden/collect_slush"
	quest.7D18829AF858D344.title: "unlocks/food/star_candy"
	quest.7D36F35D54BD7812.quest_desc: ["บางครั้งคุณพบ &bDemon's Dream seeds&r ได้จากการทุบหญ้าสั้น", "", "เมื่อโตแล้ว &6เก็บเกี่ยว&r ได้ &bDemon's Dream fruit&r ซึ่งมีประโยชน์มากมายในเรื่องไสยศาสตร์"]
