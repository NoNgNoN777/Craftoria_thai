	quest.4D05AA18CF654D70.quest_desc: ["  &bFerricore Tools and Weapons&r แข็งแรงและทนทานเท่า &biron รุ่นเทียบเท่า&r", "", "  ยัง &6อัปเกรด&r เป็นระดับสูงขึ้นได้ด้วย &btemplate&r ที่เหมาะสม", "", "  รองรับ &bอัปเกรด&r สำหรับ &6ความสามารถพิเศษ&r หลากหลาย", "", "• &bPickaxe&r: &cOre Miner&r, &cOre Scanner&r", "• &bAxe&r: &cTree Feller&r, &cLeaf Breaker&c", "• &bShovel&r: &cLawn Mower&r, &cSky Sweeper&r", "• &bSword&r: &cMob Scanner&r", "• &bBow&r: &cPotion Arrow&r", "• &bHoe&r: ไม่มีในระดับนี้", "", "{image:justdirethings:item/ferricore_axe_active width:100 height:100 align:center fit:true}"]
	quest.4D05AA18CF654D70.quest_subtitle: "เครื่องมือและอาวุธที่อัปเกรดได้"
	quest.4D05AA18CF654D70.title: "Ferricore Tools \\& Weapons"
	quest.4D0D9FC5908C6C85.title: "triggers/hints/moonstone_cores_page1"
	quest.4D181FEF12D31D67.title: "milestones/reveal_stratine"
	quest.4D1B83E147CC16AE.quest_desc: ["  &bVoidShimmer Soil&r ไม่เพียงเก็บเกี่ยวพืชอัตโนมัติ แต่ยัง &6เทเลพอร์ต&r ของที่ดรอปไปยัง &bคอนเทนเนอร์เก็บของ&r ที่กำหนด", "  ", "  ยังคง &6ทนการเหยียบ&r เหมือนดินระดับก่อนหน้า พร้อม &6เพิ่มความเร็วการเติบโตของพืชอีกขั้น&r", "", "{image:justdirethings:block/goofarmland_tier3_moist width:100 height:100 align:center fit:true}"]
	quest.4D1B83E147CC16AE.quest_subtitle: "AutoCrops ลุยเลย!"
