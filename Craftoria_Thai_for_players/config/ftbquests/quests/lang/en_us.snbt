	quest.2536E1F98777C73A.title: "unlocks/enchantments/first_strike"
	quest.253FA8D6C09E2BD5.quest_desc: ["&bSpawn Range Spawner Rune&f เปลี่ยนพื้นที่รอบ spawner ที่ม็อบเกิดได้", "", "ระยะที่กว้างขึ้นหมายถึงพื้นที่สำหรับระบบเกิดม็อบของคุณมากขึ้น"]
	quest.253FA8D6C09E2BD5.quest_subtitle: "ให้ spawner ของคุณเอื้อมได้ไกลขึ้น"
	quest.253FA8D6C09E2BD5.title: "Spawn Range Spawner Rune"
	quest.2542E07590089FAD.title: "unlocks/enchantments/vanilla_damage"
	quest.2546E587B258691F.title: "unlocks/reagents/raw_azurite"
	quest.2564593A0A5E287A.title: "unlocks/reagents/paltaeria_fragments"
	quest.2571BC62616A45AB.quest_desc: ["&dQIO Dashboard&r คือส่วนติดต่อของระบบ &eQuantum Item Orchestration&r", "", "จากตรงนี้ คุณเข้าถึงและจัดการ &fไอเทม&r ทั้งหมดที่เก็บอยู่ใน &bQIO Drive Array&r ที่เชื่อมต่อไว้ได้", "", "ค้นหาไอเทม ดูที่เก็บของ และใช้งานเครือข่ายโดยไม่ต้องรื้อหาในที่เก็บของจริง", "", "เพื่อประสบการณ์ที่ดีที่สุด ให้วาง dashboard ในที่สะดวก คลังดิจิทัลทั้งหมดของคุณอยู่ห่างแค่ไม่กี่คลิก"]
	quest.2571BC62616A45AB.quest_subtitle: "เข้าถึงที่เก็บของดิจิทัลของคุณ"
	quest.2571BC62616A45AB.title: "QIO Network"
