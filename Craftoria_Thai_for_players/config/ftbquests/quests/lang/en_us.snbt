	quest.7E141B9A82750F83.title: "hidden/collect_ash_and_slush"
	quest.7E3BD249213C7036.title: "unlocks/trinkets/azure_dike_belt"
	quest.7E49DB806DD04701.quest_desc: [""]
	quest.7E88E36EDE4C0BF0.quest_desc: ["เหลือการขยายครั้งสุดท้าย", "", "เพิ่มวงที่กว้างที่สุดด้วย &d72 Runes&f ต่ำกว่าและอยู่ไกลออกไปกว่าวงก่อนหน้าหนึ่งชั้น", "", "ด้วยตำแหน่ง rune จำนวนมากเช่นนี้ คุณปรับแท่นบูชาให้เชี่ยวชาญเฉพาะทางได้เต็มที่ด้วย rune ชนิด &dSpeed&f, &bCapacity&f, &eCharging&f, &cSacrifice&f และ rune เฉพาะทางอื่น ๆ", "", "สวมยอดเสาทั้งสี่ด้วย &5Crystal Clusters&f หรือ &5Crystal Cluster Bricks&f", "", "ตอนนี้ Ara Vitae ของคุณมี &d172 Runes&f และถึงระดับการก่อสร้างสูงสุดแล้ว"]
	quest.7E88E36EDE4C0BF0.quest_subtitle: "การไต่ขึ้นครั้งสุดท้าย"
	quest.7E88E36EDE4C0BF0.title: "วงที่ห้า (The Fifth Circle)"
	quest.7EAA0A13EF60E267.title: "hidden/visit_dd_biomes/deep_barrens"
	quest.7EBDCA060A3CC055.title: "unlocks/blocks/shimmerstone_lights"
	quest.7ED9955750255A69.quest_subtitle: "ทำบท Quest ให้สำเร็จ"
	quest.7ED9955750255A69.title: "&dArs Nouveau"
	quest.7EDF633DDB5DA2A1.quest_desc: ["Frozen Bones ดรอปจาก Strays และใช้คราฟต์ Ice Scrolls"]
	quest.7EF829BFBBB4009.quest_desc: ["วาง Energizing rods รอบ Energizing Orb แล้วจ่ายพลังงานให้ rods คุณจะป้อนพลังงานให้วัสดุต่าง ๆ ภายใน orb ได้ ตั้งแต่ไอเทมชิ้นเดียวไปจนถึงไอเทมหลายชิ้นรวมกัน", "", "ถ้าอยากให้เร็วขึ้น ป้อนพลังงานทีละมาก ๆ ได้! &bEnergizing&r เร็วขึ้นได้ถ้ามี &bpower&r เพียงพอ หากมี &bblocks&r แทน &bingots&r คุณทำ &benergized block ได้เร็วขึ้น 9 เท่า&r"]
	quest.7EF829BFBBB4009B.quest_desc: [
		"By placing Energizing rods around an Energizing Orb, then powering the rods, you can energize different materials inside the orb. This can range from single items to a combination of items."
		""
		"If you want to do this faster and quicker, you can energize in bulk! &bEnergizing&r can be sped up if you have enough &bpower&r. If you have the &bblocks&r rather then the &bingots&r, you can make the &benergized block 9x faster&r."
	]
	quest.7F10CB765C7796E1.title: "unlocks/blocks/blood_orchid"
	quest.7F24E9392D118D31.title: "unlocks/colored_lamps/pink_lamp"
	quest.7F3584DB86B09C4D.quest_desc: ["ชุดเอนชานต์ของคุณไม่ได้จำกัดอยู่แค่ &bShelves&f", "", "บล็อกบางชนิดให้โบนัสเพิ่มเติมเมื่อวางรอบ &bApothic Enchanting Table&f", "", "&6Candles&f เพิ่ม &2Eterna&f ของชุดเอนชานต์ ช่วยให้ถึงเลเวลเอนชานต์ที่สูงขึ้น", "", "&6Mob Heads และ Skulls&f ให้โบนัสต่างกันตามชนิดที่ใช้ บางชนิดเพิ่ม &4Quanta&f, &2Arcana&f หรือค่าเอนชานต์อื่น ๆ ได้", "", "ผลเหล่านี้ทำงานร่วมกับ shelves ช่วยให้ปรับแต่งชุดเอนชานต์ได้ละเอียดโดยไม่ต้องเสียช่อง shelf ที่มีค่า", "", "&aเคล็ดลับ:&r ลองใช้ candles และ mob heads ที่แตกต่างกันเพื่อรีดค่าสถานะเพิ่มจากชุดเอนชานต์&f"]
	quest.7F3584DB86B09C4D.quest_subtitle: "เสริมชุดเอนชานต์ของคุณ"
	quest.7F3584DB86B09C4D.title: "Enchanting Catalysts"
	quest.7F3A28754CD6AD41.quest_desc: ["  &6แปลง&b:", "", "• บล็อก &bNetherite&r เป็น &b&nraw eclipse alloy ore&r", "", "• บล็อก &bDiamond&r เป็น &braw celestigem ore&r", "", "• บล็อก &bGold&r เป็น &braw blazegold ore&r", "", "• บล็อก &bIron&r เป็น &braw ferricore ore&r", "", "ทำงานเร็วกว่า &bvoidshimmer goo&r", "", "{image:justdirethings:block/gooblock_tier4 width:100 height:100 align:center fit:true}"]
	quest.7F3F046CC34EC9CB.title: "unlocks/reagents/raw_bloodstone"
	quest.7F4BD83F2D567FF0.quest_desc: ["รถไฟมาแล้ว!", "", "รถไฟมาแล้ว!", "", "ชอบรถไฟไหม?", "", "โอ้โฮ มาถูกม็อดแล้ว", "", "คุณต้องทำ sheet ที่แข็งแรงเพื่อเข้าสู่แกลเลอรี &c\"Trains\"&r", "", "รถไฟของ Create&r สนุกสุดเหวี่ยงเลยล่ะ ในความเห็นของฉัน", "", "ขอให้สนุก!"]
	quest.7F4BD83F2D567FF0.quest_subtitle: "ชู่ว ชู่ว คุณฟาร์นสเวิร์ธ! (Choo Choo, Mister Farnsworth!)"
	quest.7F4BFF2C6E887FCC.quest_desc: ["   บล็อกของ &bprimogel goo&r ยัง &6แปลง&r &bblocks of coal&r เป็น &braw primal coal&r ด้วย ", "", "   &bPrimal coal&r 3 ถึง 4 ชิ้นจะ &6ดรอป&r จาก &braw primal coal&r นั้น", "", "   มีพลังงานพอจะ &6เผา&r ไอเทมได้มากกว่า &bcoal&r ปกติ 3 เท่า", "", "{image:justdirethings:block/coalblock_t1 width:100 height:100 align:center fit:true}"]
	quest.7F4BFF2C6E887FCC.quest_subtitle: "ถ่านที่ดีกว่า"
	quest.7F4DE16B3EA6232F.title: "unlocks/upgrades/upgrade_speed2"
	quest.7F57BFB41865173A.title: "unlocks/glowblocks/any_glowblock"
