	quest.2643E12EC04D65FC.title: "unlocks/equipment/bedrock_tools"
	quest.264DA461C59E31C3.quest_desc: ["&6จุดไฟ&r ให้ &bBlaze Burners&r ของคุณร้อนแรงถึงขีดสุดใหม่"]
	quest.264DA461C59E31C3.quest_subtitle: "Blazes! อันนี้ไม่โกหกนะ"
	quest.264F371D2A18EAEC.quest_desc: ["Pressurized Tubes ลำเลียง &9ก๊าซ&r, &5infuse types&r, &dPigments&r, &5slurries&r และของเหลวอื่นของ &eMekanism&r ระหว่างเครื่องจักรและภาชนะ", "", "ท่อแต่ละเส้นที่เพิ่มเข้าเครือข่ายจะเพิ่มความจุรวมและอัตราการลำเลียงพื้นฐาน", "", "&bBasic Pressurized Tube&r ให้อัตราการลำเลียง &94000 mB/t&r ต่อท่อหนึ่งเส้น", "", "เมื่อท่อ &6ดึง&r ของเข้าหาตัวเอง อัตราการดึงจะถูกจำกัดที่ &9750 mB/t&r", "", "เครื่องจักรและภาชนะที่ &aดัน&r ของเข้าเครือข่ายจะใช้อัตราลำเลียงเต็มของท่อที่เชื่อมอยู่ ทำให้เครือข่ายขนาดใหญ่ย้ายวัสดุได้ปริมาณมหาศาล", "", "อัปเกรดท่อเมื่อโรงงานของคุณขยายใหญ่ขึ้น เพื่อให้สายการผลิต &eสารเคมีและของเหลว&r ไหลต่อเนื่อง"]
	quest.264F371D2A18EAEC.quest_subtitle: "ย้ายของเหลวด้วยแรงดันสูง"
	quest.264F371D2A18EAEC.title: "Pressurized Tubes"
	quest.2665D9834FAA7343.title: "unlocks/malachite/ferocious_glass_crest_bident"
	quest.2675A4EA019B383F.quest_desc: ["เครื่องปฏิกรณ์ของคุณผลิต &9ไอน้ำ&r ได้มหาศาล แต่การผลิตไอน้ำจำนวนมากก็ไร้ประโยชน์ หากนำไปใช้งานไม่ได้", "", "&bIndustrial Turbine&r แปลง &9ไอน้ำ&r เป็น &eFE&r โดยหมุนโรเตอร์ภายในเพื่อผลิตพลังงาน", "", "สร้างชิ้นส่วนกังหันตรงกลาง แล้วล้อมด้วยโครงสร้างมัลติบล็อกที่จำเป็น เชื่อมกังหันเข้ากับช่องส่งไอน้ำของเครื่องปฏิกรณ์ แล้วดูพลังงานไหลเข้ามา", "", "กังหันที่ใหญ่กว่าประมวลผล &9ไอน้ำ&r ได้มากกว่าและผลิต &eFE&r ได้มากกว่า จึงเป็นส่วนสำคัญของระบบผลิตพลังงานจริงจัง"]
	quest.2675A4EA019B383F.quest_subtitle: "เปลี่ยนไอน้ำเป็นพลังงาน"
	quest.2675A4EA019B383F.title: "ถึงเวลากังหัน (Turbine Time)"
	quest.2689A56675E12245.quest_desc: ["&3สาร&r นี้ใช้ใน &bThermopneumatic Processing Plant&r ร่วมกับ &8Coal&r เพื่อ &6ผลิต&r &7Plastic&r ", "", "เป็น &7เชื้อเพลิงเหลว&r &eชั้นเยี่ยม&r และ &6วาง&r ลงใน &8Furnace&r ได้ด้วย"]
	quest.2689A56675E12245.title: "&eLPG"
	quest.268B0F87CC431A51.quest_desc: ["- ต้องมี &bCasing&r ตามระดับสายเคเบิลที่จะแปลงจาก (ค่าเริ่มต้นคือ &eLV&r)"]
	quest.268B0F87CC431A51.quest_subtitle: "แปลงง่ายขึ้น!"
	quest.2697B8077174B870.quest_desc: ["[ อย่าลืมดูรุ่น netherite ของสิ่งเหล่านี้ และ &bBacktank&r ด้วย ]"]
	quest.2697B8077174B870.quest_subtitle: "Jacques Cousteau ยังสู้คุณไม่ได้"
	quest.269BBD981BEB0BC7.title: "unlocks/trinkets/gleaming_pin"
	quest.269D79D672D98D47.title: "unlocks/colored_lamps/orange_lamp"
	quest.26A44EDA4AABFF6F.quest_desc: ["&bCompressed Steel &fคราฟต์ได้โดย &6โยน &bIron Ingot &fลงพื้นแล้ว &6ระเบิด &fด้วย&b TNT&f แต่คุณอาจไม่ได้ผลลัพธ์คืนทุกครั้ง ", "", "คาดว่าจะสูญเสีย &c25%&r ของ &7Iron&r ที่โยน", "", "- ต้องมี &bCasing&r ตามระดับสายเคเบิลที่จะแปลงไปเป็น (ค่าเริ่มต้นคือ &eLV&r)", "", "หมายเหตุ: กด &6SHIFT&r ค้างเหนือไอเทม &aPNC&r ใดก็ได้เพื่อดูคำอธิบายของไอเทมนั้น"]
	quest.26A44EDA4AABFF6F.title: "&cยินดีต้อนรับ &eสู่ &aPNC (Welcome to PNC)"
	quest.26AC949F1C3C6214.quest_desc: ["สีทองเหลือง ด้านข้างสีดำ และดูมีสไตล์มาก"]
	quest.26BB351259DAB59B.title: "unlocks/trinkets/take_off_belt"
	quest.26C7705667EB55E8.quest_desc: ["Ara Vitae ต้องการมากกว่าเลือดแล้ว", "", "เพิ่มวงแหวน &d28 Runes&f อีกวง ต่ำลงหนึ่งระดับและอยู่ไกลออกไป", "", "ตำแหน่ง rune เพิ่มขึ้น ทำให้คุณควบคุมแท่นบูชาได้มากขึ้นอีก", "", "วาง &cBloodstone Bricks&f ที่มุมทั้งสี่เพื่อปิดวงให้สมบูรณ์", "", "ตอนนี้แท่นบูชาของคุณมี &d52 Runes&f"]
	quest.26C7705667EB55E8.quest_subtitle: "เหนือกว่าเลือด"
	quest.26C7705667EB55E8.title: "วงที่สาม (The Third Circle)"
	quest.26CD3D7488C51839.title: "hidden/collect_all_jade_vine_products"
	quest.26E5494402066DB9.title: "triggers/hints/stargazing_page1"
	quest.26E8913A415EA76B.title: "unlocks/blocks/titration_barrel"
	quest.26FB6BFDE0A5E87C.title: "unlocks/glowblocks/orange_glowblock"
	quest.2715562637ED9208.title: "unlocks/trinkets/glow_vision_goggles"
	quest.272E31F15A39517B.quest_desc: ["&bFusion Reactor Frame&r เป็นรากฐานของระบบพลังงานทรงพลังที่สุดของ Mekanism", "", "สร้างโครงสร้างมัลติบล็อกจาก &bFusion Reactor Frames&r เพื่อกักเก็บ &dFusion Reactor&r และปฏิกิริยาอันทรงพลังมหาศาลของมัน", "", "เฟรมเป็นผนังของเครื่องปฏิกรณ์ ทำงานร่วมกับส่วนประกอบอื่นที่จำเป็นเพื่อสร้างระบบฟิวชันที่ใช้งานได้", "", "เมื่อประกอบเสร็จ คุณจะควบคุม &dFusion Power&r ในระดับที่เหนือกว่าเครื่องกำเนิดไฟฟ้าทั่วไปมาก"]
	quest.272E31F15A39517B.quest_subtitle: "สร้างหัวใจของพลังงานฟิวชัน"
	quest.272E31F15A39517B.title: "Fusion Reactor Frame"
	quest.272F8083EDA21D51.title: "hidden/status_effects/advanced_sleep"
	quest.27555D0AA03D8287.title: "hidden/visit_dd_biomes/noxshroom_forest"
	quest.2780E0001F5F64D9.title: "triggers/hints/downstone_fragments_page0"
	quest.278A6AFADF33FBC4.title: "milestones/reveal_paltaeria"
	quest.278D1565743D3137.title: "unlocks/items/perturbed_eye"
	quest.2791E3710CE72C36.title: "unlocks/glowblocks/cyan_glowblock"
	quest.27A396E8628B269E.quest_desc: ["  &bGold Drill&r ผลิตแร่และบล็อกก่อสร้างที่คุณคาดว่าจะพบในเขต Nether"]
	quest.27A396E8628B269E.title: "Gold Drill"
	quest.27B6C6079B5FE918.quest_desc: ["&bRotary Condensentrator&r ช่วยแปลง &eก๊าซ&r ให้เป็น &bของเหลว&r หรือ &6ควบแน่น&r ของเหลวกลับเป็นก๊าซ", "", "ใช้ &6ปุ่ม&r ที่มุมซ้ายบนของ GUI เพื่อสลับระหว่างสองโหมด", "", "เครื่องนี้มีประโยชน์มากเมื่อสูตรต้องการสารเคมีใน &bสถานะ&r ที่ต่างออกไป ทำให้คุณสลับระหว่าง &eก๊าซ&r และ &bของเหลว&r ได้ตามต้องการ", "", "สารเคมีเดิม สถานะต่างกัน ความเป็นไปได้มากขึ้น"]
	quest.27B6C6079B5FE918.quest_subtitle: "เปลี่ยนก๊าซเป็นของเหลว"
	quest.27B6C6079B5FE918.title: "Rotary Condensentrator"
