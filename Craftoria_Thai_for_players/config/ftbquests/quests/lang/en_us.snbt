	quest.169AD4B3D507632C.title: "unlocks/upgrades/upgrade_experience2"
	quest.16A19C70BECEF7A8.title: "hidden/status_effects/projectile_rebound"
	quest.16AAEB122CDC1A46.quest_desc: ["{image:modern_industrialization:block/machines/mixer/overlay_top_active width:32 height:32 align:center}", "  Casing ทองสัมฤทธิ์เรียบหรูกับชามโลหะแวววาวที่ใบพัดผสมหย่อนลงไป &6ผสม&rของหลากหลายชนิด คุณ&6ผสมผง&rได้ด้วยผลผลิตที่สูงขึ้น เพราะไม่หกหายอีกต่อไป", "", "  ไม่ได้ผสมแค่ผงเท่านั้น แต่ผสมของเหลวได้ด้วย เช่น &eLubricant&r"]
	quest.16AAEB122CDC1A46.title: "Bronze Mixer"
	quest.16B74C92EB86AD0C.quest_desc: ["&6เท&r&7ของเหลว&rลงในโลก หรือ&bทำให้เย็น&rใน&3ช่องเก็บของ&rด้วย &cHeat Frame&r เพื่อ&6ทำให้แข็งตัว&rเป็น &bPlastic Sheets&r ", "", "การใช้ &cHeat Frame&r อาจให้&aผลที่ดีกว่า&r"]
	quest.16B74C92EB86AD0C.title: "&7Molten Plastic"
	quest.16C84031D0CE45AE.quest_desc: ["วิธีใช้&r", "1. &6คลิกขวา&r &bแผ่นจารึก&rที่ &bRitual Brazier&r", "", "1.5. การเสริมพลัง (ไม่บังคับ)", "&8+ ทิ้งไอเทมลงบน Ritual Brazier เพื่อเสริมพลัง&r", "&8+ ไอเทมอะไร ดูได้จากคำอธิบายแผ่นจารึก หนังสือคู่มือ หรือวิกิ&r", "", "2. การเปิดใช้งาน", "&6คลิกขวา &8ด้วย&6มือเปล่า &8เพื่อเปิดใช้งาน", "", "3.1 จ่าย &5Source&r", "&8โดยค่าเริ่มต้น ดึง Source จาก&9รัศมี 6 บล็อก&r&8", "", "3.2 &6หยุดชั่วคราว&r (ไม่บังคับ)", "Redstone &2เปิด&r = Brazier &4หยุดชั่วคราว&r", "&8ทำไมต้องหยุด ตัวอย่างคือ Ritual of Containment ", "&8-คุณ&6ประกอบ&r&8พิธีกรรมนั้น&2เฉพาะเมื่อต้องการ&r&8จับมอนสเตอร์", "&8-ถ้าปล่อยให้ทำงานตลอด อาจจับสัตว์เลี้ยงของคุณใส่โถ หรือแม้แต่ &bitem_entity&r &8ลงโถ (ใช่ พิธีกรรมนั้นเก็บไอเทมที่ดรอปได้ด้วย)", "", "", "&4หมายเหตุ&r: &9ระยะพิธีกรรม&rขึ้นอยู่กับ&bพิธีกรรม&r", "&4หมายเหตุ 2&r: พิธีกรรมบางอย่าง&4ใช้ครั้งเดียว&r บางอย่างแค่ต้องมี Source เพื่อ&2ต่ออายุ&r", "- &4ครั้งเดียว&r&8: Tablet of Awakening, Tablet of Conjure Island,...", "- &2ต่ออายุ&r&8: Tablet of Flight, Tablet of Containment,..."]
	quest.16E5B09AA7E6A487.quest_desc: ["  &bConveyor Belts&r ใช้เคลื่อนย้ายไอเทมภายในเครื่องจักรของคุณ", "", "  ใช้ &bMotors&r หมุน และใช้ &bRubber Sheets&r เป็นแท่นเคลื่อนที่", "", "  &6คุณควรทำให้สิ่งเหล่านี้เป็นอัตโนมัติ&r"]
	quest.16E5B09AA7E6A487.quest_subtitle: "ทุกคนขึ้นรถไฟด่วนไอเทม"
	quest.16E5B09AA7E6A487.title: "สายพานลำเลียง (Conveyor Belts)"
	quest.16F37A3E31EBDA50.quest_desc: ["ยานที่นั่งเดี่ยวความเร็วสูง ต้องใช้ความพยายามในการบังคับมากกว่า แต่สนุกสุด ๆ", "", "มีที่เก็บของอยู่บ้าง ช่องอาวุธหนึ่งช่อง ช่องอัปเกรดสี่ช่อง ช่องแบนเนอร์ และยังติดจรวดเพื่อเร่งความเร็วได้ด้วย"]
	quest.16F7C881B4CED163.quest_desc: ["- &bGlyphs&r: ", "&8+ Form: Touch", "&8+ Augment: AoE, Pierce, Extend Time", "&8+ Effect: Place, Grow, Fell, Pickup, Delay", "", "- &bสำหรับต้นไม้ 1x1&r: 2->3 ป้อม", "&8+ &bป้อม 1&8: Touch -> Place -> Grow -> Grow -> Grow (เพิ่ม Grow ถ้าจำเป็น)", "", "&8+ &bป้อม 2&8: Touch -> Fell -> AoE -> AoE (เพิ่มถ้าจำเป็น) -> Delay -> Pickup -> AoE -> AoE (เพิ่ม AoE ถ้าจำเป็น)", "", "- &bเคล็ดลับ&r", "+ เคล็ดลับ 1: นาฬิกาเรดสโตน ", "&8ผ่าน &bRedstone Clock &8(รอบเวลา &91->100 ติ๊ก&8)", "", "+ เคล็ดลับ 2: หน่วงเวลาเรดสโตน ", "&8ผ่าน &bRepeater", "", "+ เคล็ดลับ 3: ส่งต่อเรดสโตน ", "&8ผ่าน laserio หรือเรดสโตนเฉย ๆ : P", "", "", "&8ดู &bหน้า 2 &8สำหรับฟาร์มต้นไม้ 2x2", "", "{@pagebreak}", "- &bสำหรับต้นไม้ 2x2&r: 2->3 ป้อม ", "&8(2 ถ้าใช้ตัวเก็บไอเทมจากม็อดอื่น)", "", "&bตรวจให้แน่ใจ&r: ทิศเหนือและทิศตะวันตกต้องไม่มีบล็อก (ฟีเจอร์ของ vanilla)", "", "&8+ &bป้อม 1&8: Touch -> Place -> AoE -> AoE -> Pierce -> Grow -> Grow -> Grow (เพิ่ม Grow ถ้าจำเป็น)", "", "&8+ &bป้อม 2&8: Touch -> Fell -> AoE -> AoE -> AoE -> AoE (เพิ่มถ้าจำเป็น)", "", "&8+ &bป้อม 3&8: Touch -> Delay -> Extend Time (เพิ่มถ้าจำเป็น) -> Pickup -> AoE -> AoE -> AoE -> AoE (เพิ่มถ้าจำเป็น)", "", "เคล็ดลับ 4: ไม่อยากให้มีต้นกล้านอก &92x2&r ใช่ไหม ", "&8ใช้บล็อกที่ไม่ใช่ดินหรือหญ้า ต้นกล้าจะได้วางไม่ได้"]
	quest.16F7C881B4CED163.title: "ไอเดียฟาร์มต้นไม้ (Tree Farm Idea)"
	quest.16FD12117155C23E.title: "unlocks/reagents/raw_azurite"
	quest.1717CCF8AACEE1DA.title: "hidden/solve_any_preservation_ruin"
	quest.1741E5781EC19C48.title: "milestones/unlock_spawner_creature_change"
	quest.175FB8657E473B96.title: "mod_integration/the_bumblezone/any_essence"
	quest.17645BCE1F30F1C7.title: "unlocks/ampoules/raw_azurite_ampoule"
	quest.176524D0E4475298.quest_desc: ["  ด้วย &bCrude Oil&r ที่เพิ่งขุดได้ คุณสร้างไอเทมได้หลากหลาย แต่ &6ต้องกลั่นก่อนจึงจะใช้ได้&r ตอนนี้มันแทบไม่มีประโยชน์ในเชิงอุตสาหกรรม", "", "  นี่คือจุดที่ &bDistillery&r เข้ามามีบทบาท &6คุณกลั่นหรือแยก&r&6ของเหลวออกเป็นส่วนที่เบากว่า&r ด้วย &bDistillery&r นี้คุณกลั่นได้ทีละของเหลวเพียงชนิดเดียว", "", "  ทำงานต่อไป อีกไม่นานคุณจะสกัดของเหลวหลายชนิดพร้อมกันได้"]
	quest.176524D0E4475298.title: "Distillery"
	quest.176FB09965CCFAB0.title: "hidden/break_black_materia"
	quest.17779D6F6940F45D.title: "unlocks/colored_lamps/light_blue_lamp"
	quest.1794E588334CB478.quest_desc: ["เครื่องนี้ใช้&6เทคโนโลยีขั้นสูง&r&7บีบอัด&r&bไอเทม&rให้เล็กลงถึง&dขนาดอะตอม&r ทำให้&6เข้าถึง&rและ&6จัดการ&r&9ช่องเก็บของ&rของผู้เล่นได้โดยตรง ", "", "&bไอเทม&r&aใส่เข้า&rและ&cดึงออก&rได้ผ่าน&bฮอปเปอร์&r โดยจะถูกเพิ่มเข้าไปหรือเอาออกจาก&9ช่องเก็บของ&rของผู้เล่นที่วางเครื่อง ", "", "คุณยังใช้วิธีใส่ที่ฉลาดกว่า เช่น &bDrones&r หรือ &bLogistics Frames&r หรือม็อดอื่น เพื่อจัดการ&9ช่องเก็บของ&rของผู้เล่นโดยอัตโนมัติ เช่น เติม&e คบเพลิง 64 อัน&r ให้เต็มอยู่เสมอ"]
	quest.17AEEBACB1111D66.title: "unlocks/food/mint_beverages"
	quest.17B440777B3B968D.title: "unlocks/colored_saplings/magenta_sapling"
	quest.17C1F2791A6E0676.quest_desc: ["Mekanism มีอัปเกรดหลายแบบให้ปรับแต่งเครื่องจักร ติดตั้งผ่านแท็บ &bUpgrade&r ของเครื่อง หรือ &6shift + คลิกขวา&r ที่เครื่องด้วยอัปเกรด", "", "&bSpeed Upgrade&r", "เพิ่มความเร็วการประมวลผล แต่เพิ่ม&eการใช้ FE&r อย่างมาก ติดตั้งได้สูงสุด &a16&r ชิ้น", "", "&eEnergy Upgrade&r", "เพิ่มความจุพลังงานและลดการใช้ &eFE/t&r ของเครื่อง มีประโยชน์เป็นพิเศษเมื่อใช้ร่วมกับ &bSpeed Upgrades&r", "", "&dGas Upgrade&r", "เพิ่มประสิทธิภาพของเครื่องที่ใช้ก๊าซ ลดปริมาณก๊าซที่ต้องใช้", "", "&7Muffling Upgrade&r", "ลดเสียงที่เครื่องจักรสร้างขึ้น ติดตั้งได้สูงสุด &a4&r ชิ้น ทำให้เงียบสนิท", "", "&6Filter Upgrade&r", "ใช้โดย &bElectric Pump&r เพื่อแยก &9Water&r ออกจาก &bHeavy Water&r", "", "&cAnchor Upgrade&r", "ทำให้ชังก์ของเครื่องที่รองรับโหลดอยู่เสมอ ทำงานต่อได้แม้คุณไม่อยู่", "", "&aStone Generator Upgrade&r", "ให้ &bDigital Miner&r มี &7Stone&r และ &8Cobblestone&r ไม่จำกัดสำหรับฟังก์ชันแทนที่บล็อก", "", "เลือกอัปเกรดอย่างรอบคอบ เครื่องที่สมดุลมีประสิทธิภาพกว่าเครื่องที่ใส่แต่ &bSpeed Upgrades&r มาก"]
	quest.17C1F2791A6E0676.quest_subtitle: "ปรับจูนเครื่องจักรให้สมบูรณ์แบบ"
	quest.17C1F2791A6E0676.title: "อัปเกรดเครื่องจักร (Machine Upgrades)"
	quest.17C211239CD33B6C.title: "unlocks/reagents/bedrock_dust"
	quest.17E7640F55666577.quest_desc: ["&bPigment Extractor&r ให้คุณนำวัตถุ&aที่ย้อมสี&rเกือบทุกชนิดมา&6สกัดสีย้อม&rออกจากมัน", "", "กระบวนการนี้ทำลายวัตถุที่ย้อมสี เหลือไว้เป็นเวอร์ชัน&7ไม่ย้อมสี&rดั้งเดิมพร้อมสีย้อมที่สกัดได้"]
	quest.17E7640F55666577.quest_subtitle: "มอบชีวิตที่สองให้สี"
	quest.17E8751018E9E0F6.quest_desc: ["เหมือนกับตัวก่อนหน้าทุกอย่าง แต่จุมากกว่าแปดเท่า อย่าเผลอปล่อยประจุออกหมดล่ะ อาจเจ็บได้"]
	quest.17E8751018E9E0F6.title: "Dense Energy Cell"
	quest.17FCD3ECDC775E69.quest_desc: ["- &cการเจาะเกราะ"]
	quest.181F0D905337A626.title: "unlocks/items/knowledge_gem"
	quest.183E523C25CC6C3F.quest_desc: ["Logistical Transporters เป็นระบบลำเลียงไอเทมของ Mekanism ช่วยให้ย้าย&fไอเทม&rระหว่างเครื่องจักร ช่องเก็บของ และภาชนะอื่น ๆ", "", "&6Basic Logistical Transporter&r แต่ละตัวส่งไอเทมเข้าเครือข่ายได้สูงสุด &a2 ชิ้นต่อวินาที&r เมื่อ&cดึง&rไอเทม", "", "เมื่อไอเทมอยู่ในเครือข่ายแล้ว จะเคลื่อนผ่าน Transporter ด้วยความเร็วสูงสุด &e1.0 m/s&r Transporter ระดับสูงกว่าเคลื่อนไอเทมได้เร็วขึ้นมาก", "", "อัตรา&aส่งเข้า&rปลายทางแทบไม่จำกัด ตราบใดที่ไอเทมเข้าเครือข่ายได้ตั้งแต่แรก", "", "ใช้ &eConfigurator&r ตั้งค่าการเชื่อมต่อ หรือเพิ่ม &bLogistical Sorters&r เพื่อควบคุมว่าไอเทมไปที่ใดอย่างแม่นยำ"]
	quest.183E523C25CC6C3F.quest_subtitle: "ย้ายไอเทมได้อย่างง่ายดาย"
	quest.183E523C25CC6C3F.title: "Logistical Transporters"
	quest.183EB573F8F1DC8C.quest_desc: ["ผู้ทำโพชัน", "ทำ Enchanting Apparatus เป็นอัตโนมัติ (ด้วย &5Ars Addditions&r)", "", "1. Wixie Cauldron&r", "- เรียก: &6คลิกขวา&r ที่ &bCauldron&r", "", "- วิธีใช้: ต้องตั้ง&bที่เก็บของ&rให้ Wixie Cauldron ด้วย &bDominion Wand&r", "&8+ วางแท่น (Pedestal) และโถโพชัน (Potion Jar) ไว้ใกล้บล็อกที่แปลงแล้ว", "&8+ ไม่ต้องจัดหา Blaze Powder, Glass Bottles หรือ Water&r", "", "- ต้องใช้ Source: ใช่", "", "- การวาง", "&8P: Pedestal/Pattern Provider", "&8C: Cauldron", "&8J: Potion Jar", "P P P", "P C P", "P P P", "&bPotion Jars&r อยู่ใกล้ Cauldron", "&8(เคล็ดลับ: Pedestal หรือ Pattern Provider อยู่สูงหรือต่ำกว่าได้ 1 บล็อก)&r", "", "", "&4หมายเหตุ&r: &5Ars Énergistique&r ทำให้อ่านตัวกรองเอาต์พุตจาก &bPattern Provider&r &8(Extended)&r ได้ แทน &bPedestals&r", "&8(ยังต้องตั้งหีบหรือถังเก็บของ)", "", "&8ดู &bหน้า 2 &8สำหรับ Wixie's Enchanting Apparatus", "{@pagebreak}", "2. Wixie's Enchanting Apparatus&r", "- เรียก: &6กดย่อ + คลิกขวา&r ที่ &bEnchanting Apparatus&r", "", "- วิธีใช้: ต้องตั้ง&bที่เก็บของ&rให้ Wixie Cauldron ด้วย &bDominion Wand&r", "&8+ วางแท่น (Pedestal) ไว้ใกล้บล็อกที่แปลงแล้ว", "", "- ต้องใช้ Source: ใช่", "", "- การวาง", "&8P: Pedestal/Pattern Provider", "&8E: Enchanting Apparatus", "P P P", "P E P", "P P P", "&8(เคล็ดลับ: Pedestal หรือ Pattern Provider อยู่สูงหรือต่ำกว่าได้ 1 บล็อก)&r", "", "", "&4หมายเหตุ&r: &5Ars Énergistique&r ทำให้อ่านตัวกรองเอาต์พุตจาก &bPattern Provider&r &8(Extended)&r ได้ แทน &bPedestals&r", "&8(ยังต้องตั้งหีบหรือถังเก็บของ)"]
	quest.183EB573F8F1DC8C.quest_subtitle: "โพชัน | คราฟต์ | Apparatus"
	quest.185A13426F0F2D9F.title: "unlocks/equipment/knotted_sword"
	quest.18680FEE2B6FF16F.quest_desc: ["  พืชที่ปลูกบน &bBlazebloom Soil&r จะ&6เก็บเกี่ยว&rและ&6ปลูกใหม่&rเอง", "", "  คุณอาจใช้ &bItem Collector&r ของ Just Dire Things&r เพื่อ&6รวบรวม&rของที่พืชดรอปเข้าที่เก็บของโดยอัตโนมัติ", "", "  &bBlazebloom soil&r ยัง&6เร่ง&rการเติบโตของพืชเล็กน้อย และทนต่อ&6การเหยียบ&r", "  ", "{image:justdirethings:block/goofarmland_tier2_moist width:100 height:100 align:center fit:true}"]
	quest.18680FEE2B6FF16F.quest_subtitle: "ปลูกพืชอัตโนมัติ"
	quest.186F257352F2E844.quest_desc: ["  เครื่องนี้ต้องการความแข็งแกร่งอีกระดับ ถึงเวลานำ &bTitanium&r ที่คุณเพิ่งทำมาใช้ &bPressurizer&r ช่วยให้อัดความดัน &bWater&r &6เป็น &bHP&r&6 หรือ &bน้ำแรงดันสูง&6 และอัด &r&bSteam&r &6เป็น &bHP Steam&r และทำงานย้อนกลับเพื่อลดความดันของเหลวได้ด้วย &bPressurizer&r ยัง&6ให้คุณเก็บ &bLiquid Air&r &6ผ่าน &bAir Intake&r ได้ และมีประสิทธิภาพกว่า &bVacuum Freezer&r มาก"]
	quest.186F257352F2E844.title: "Pressurizer"
	quest.188CF922D562E21A.quest_desc: ["1. บันทึก&r", "&6คลิกขวา&r ไอเทมนี้ใน&6มือหลัก&r มันจะบันทึก &5glyph ที่คุณรู้จักทั้งหมดในปัจจุบัน&r", "", "2. ให้ผู้อื่น&r", "ใช้เพื่อเรียนรู้ glyph ทั้งหมดใน &bCodex&r", "", "", "&4หมายเหตุ&r: การบันทึกต้องใช้ &2EXP&r"]
	quest.188CF922D562E21A.quest_subtitle: "เล่นเป็นทีมใช่ไหม"
	quest.18956DB32D96ED2B.quest_desc: ["อัปเกรดแล้วเหรอ จะแบกบ้านไปด้วยเหรอ ไอเดียดี เต็นท์ชอบทำให้ปวดหลัง"]
	quest.18956DB32D96ED2B.title: "Medium Spatial Component"
	quest.189A301A1489939B.title: "unlocks/enchantments/vanilla_water_luck"
	quest.18ACE29810E1A1F1.title: "unlocks/trinkets/ring_of_aerial_grace"
