	quest.1BF08713FF3DB851.title: "milestones/unlock_spawner_manipulation"
	quest.1C19154B90CBEB17.title: "hidden/collect_cookbooks/imperial_cookbook"
	quest.1C25114D2AF71C35.quest_desc: ["  ด้วย &bIndustrial TNT&r &bImplosion Compressor&r บีบอัดผงและแท่งของวัสดุที่ทนทานที่สุดได้ ซึ่งรวมถึง &bTungsten&r, &bBlast-proof Alloy&r, &bBeryllium&r และสุดท้ายคือ &bDiamonds&r วัสดุเหล่านี้บางอย่างจะสำคัญมากต่อการเดินทางสู่ฟิชชันนิวเคลียร์ของคุณ", "", "  คุณคงสังเกตว่าระหว่างทาง คุณทำ &bBlast-proof Alloy Plates&b และ &rTungsten Nuggets&r ในเครื่องบีบอัดธรรมดาได้ แม้จะไม่ค่อยมีประสิทธิภาพ แต่ตอนนี้ด้วย &bImplosion Compressor&r คุณทำได้เร็วขึ้นและมีประสิทธิภาพกว่าเดิม"]
	quest.1C25114D2AF71C35.title: "Implosion Compressor"
	quest.1C28DC18F138B066.title: "unlocks/trinkets/shieldgrasp_amulet"
	quest.1C4ADA8B75FBBED1.quest_subtitle: "Can teleport you to your personal spawn point or world spawn."
	quest.1C699E7F615D68A7.quest_desc: ["เทอร์มินัลในชุดสร้างระบบเก็บของเองใหม่ของ Create", "", "&6เชื่อม&rกับช่องเก็บของหลายแห่งได้ผ่าน &bStock Links&r และ&bใช้งาน&rโดยม็อบที่คุณเลือก"]
	quest.1C69AE9775DDC0AD.quest_desc: ["  ง่าย ๆ", "", "  &6ผลิต&rพลังงานจาก&bเชื้อเพลิงเหลว&r", "", "• &bBlaze Ember Fuel&r", "• &bVoidflame Fuel&r", "• &bEclipse Ember Fuel&r", "", "{image:justdirethings:block/generatorfluidt1_top width:100 height:100 align:center}"]
	quest.1C69AE9775DDC0AD.quest_subtitle: "เชื้อเพลิงเหลวเท่านั้น"
