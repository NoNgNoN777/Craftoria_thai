	quest.2C8902E340DD210E.title: "hidden/collect_pigment/green"
	quest.2C92B957A5E8646F.quest_desc: ["&bBlank Pattern&f ใช้ทำให้ &acrafting recipes &6เป็นอัตโนมัติ&f คุณต้อง &6เข้ารหัส &fใส่ &bBlank Pattern &fใน &bPattern Encoder&f แล้ววางลงใน &bPattern Provider&f"]
	quest.2CAEBBC8E99FA920.title: "triggers/hints/amethyst_page0"
	quest.2CB005B413D2B889.quest_desc: ["ใช่ คุณเป็นนายแบบได้! ", "", "ด้วย &bTransmogrification Table&r คุณ &6ปลอมแปลง&r &7ไอเทม&r &7บล็อก&r หรือ &7เกราะ&r ชิ้นใดก็ได้&r ให้เป็นอย่างอื่น ตราบที่ยังเป็น &7ไอเทม&r ", "", "อยากสวมบล็อกบนหัว? ", "ทำเลย! ", "", "เอาดาบที่แกร่งที่สุดไปพรางเป็นคุกกี้? ", "ทำไมจะไม่ได้? ", "", "การผสมผสานไม่มีที่สิ้นสุด ", "", "&9อวด สไตล์ของคุณ&r"]
	quest.2CB005B413D2B889.quest_subtitle: "สับเลยค่ะ ควีน!"
	quest.2CB005B413D2B889.title: "&cจง&eเป็น &9ไอคอน &aแฟชั่น&8! (Be a Fashion Icon!)"
	quest.2CC5D8F1BDFC8A36.title: "triggers/hints/clover_page1"
	quest.2CE7390F7567D9E2.quest_desc: ["  &bSimple&r:", "    • ทำงานเป็นคู่", "    • &6สลับ&r &bบล็อก&r (รวมถึง &bอากาศ)&r", "    • &3เอนทิตี&r &6วาร์ป&r (เดี่ยว)", "    • ตัวเลือก &esensitivity&r ของ &4Redstone&r", "", "  &bAdvanced&r:", "    • เพิ่ม &6การกรอง&r และ &3offset AOE&r", "    • ต้องใช้ &cพลังงาน&r", "", "", "{image:justdirethings:block/blockswappert2_side width:100 height:100 align:center}"]
	quest.2CE7390F7567D9E2.quest_subtitle: "พอร์ทัลในรูปเครื่องจักร"
	quest.2D051675EBBAE4ED.title: "unlocks/food/verdigris_wine"
	quest.2D12653352AAD2E2.title: "unlocks/equipment/dragonrending_pickaxe"
	quest.2D15A536403974E2.title: "hidden/interact_with_dragonrot"
	quest.2D2A4E52CF79C196.title: "unlocks/equipment/knotted_sword"
	quest.2D4170B5AD28DCBF.quest_desc: ["  &bDiesel Generator&r แบบบล็อกเดียวที่ดีที่สุดที่คุณทำได้ &6ให้พลังงานสูงสุด 1024 eu/t&r จากของเหลวต่าง ๆ ที่แสดงใน EMI ของคุณ", "", "  แต่นี่ไม่ใช่เครื่องกำเนิดไฟฟ้าที่ดีที่สุดที่ใช้เชื้อเพลิงเหลว ยังมี &bLarge Diesel Generator&r ซึ่งต้องใช้ &bHighly Advanced Machine Hulls&r แต่คุ้มแน่นอนเมื่อได้ยินว่า &6ผลิตได้สูงสุด 16,384 eu/t&r!"]
	quest.2D4170B5AD28DCBF.title: "HV Diesel Generator"
	quest.2D4564F6C18AE96B.quest_desc: ["The &bAdvanced Logistical Transporter&r can pull &a32 items per second&r into a transporter network and transfer it at a speed of &a2.0 meters per second&r."]
	quest.2D4564F6C18AE96B.title: "Advanced Logistical Transporter"
	quest.2D4CD4E32D1AF5AE.title: "unlocks/reagents/pure_resources"
	quest.2D5A0399B7FFA5DB.quest_desc: ["Cthulhu ทำให้คุณ &6หายใจ&r &bใต้น้ำ&r ได้"]
