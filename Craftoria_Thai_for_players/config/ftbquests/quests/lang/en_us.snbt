	quest.4E026831A66E0A42.quest_subtitle: "เจ็ดมหาสมุทร"
	quest.4E062B9B4960632D.quest_desc: ["ยานที่ใช้เชื้อเพลิงอย่างเป็นเรื่องเป็นราว... และนั่งได้สองคน!", "", "มีพื้นที่เก็บของพอสมควร ช่องอัปเกรดสามช่อง ช่องอาวุธหนึ่งช่อง ช่องธงหนึ่งช่อง และช่องสีย้อมด้วย - สำหรับย้อมสีจมูกด้านหน้าและหางด้านหลัง"]
	quest.4E0A519AC89A17BC.title: "triggers/hints/preservation_ruins_page1"
	quest.4E1B3935FC8A1170.quest_desc: ["อีก 4 เท่า! คุณกำลังมาแรง!"]
	quest.4E1B3935FC8A1170.title: "16k Storage Component"
	quest.4E33ED9C42F906F6.quest_desc: ["เซลล์นี้เก็บสารเคมีกัมมันตรังสีได้ ต่างจาก &bChemical Storage Cell&r ทั่วไป", "", "ต้องตั้ง partition ก่อนจึงจะใช้ได้"]
	quest.4E3578FC24ACF39B.quest_desc: ["คุณคงเคยเจอเจ้าตัวเล็กไม่โดดเด่นนี้ตอนกดแผ่นเหล็กชุดแรกใน Create", "", "&bDepot&r &6ยึด&r ไอเทมให้อยู่กับที่ เพื่อให้ของอื่นของ Create หลายอย่างทำงานกับไอเทมเหล่านั้นได้"]
	quest.4E3578FC24ACF39B.quest_subtitle: "ไอเทม... อยู่นิ่ง ๆ!"
	quest.4E40590273222C82.title: "unlocks/reagents/citrine_powder"
	quest.4E4D64D09F7C66A5.quest_desc: ["&dCosmic Control Circuit&r ผลักวงจรของ &bMekanism&r ให้เกินขีดจำกัดทั่วไป", "", "ทำจากการรวม &6Supreme Control Circuit&r กับ &dShining Alloy&r วงจรเหล่านี้จำเป็นสำหรับเครื่องจักร &5ขั้นสูง&r บางประเภทที่มีอยู่", "", "ถ้าคุณคิดว่า &6Supreme&r คือจุดสิ้นสุด คิดใหม่ได้เลย", "", "&dจักรวาลกำลังรออยู่&r"]
	quest.4E4D64D09F7C66A5.quest_subtitle: "ควบคุมในระดับจักรวาล"
	quest.4E52622A45D0C018.title: "hidden/visit_dd_biomes/deep_barrens"
